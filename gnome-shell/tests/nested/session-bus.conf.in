<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<!-- The nested shell's private session bus (scripts/resource-pulse-nested.sh renders the @…@ fields).
     Its ONLY activatable service is dconf, from a service directory inside the run: no portals, no gvfs, no
     keyring, no accessibility bus, no systemd, nothing that would mount or write under a live runtime dir.
     No standard service directories and no included config files: the script refuses a config with either. -->
<busconfig>
  <type>session</type>
  <keep_umask/>
  <listen>unix:abstract=rp-nested-session-@RUN_SUFFIX@</listen>
  <auth>EXTERNAL</auth>
  <servicedir>@SESSION_SERVICE_DIR@</servicedir>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
  <limit name="service_start_timeout">120000</limit>
  <limit name="auth_timeout">240000</limit>
</busconfig>
