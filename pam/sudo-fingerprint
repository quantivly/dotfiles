# /etc/pam.d/sudo-fingerprint — installed by ~/.dotfiles
# scripts/setup-fingerprint.sh (`fingerprint-setup`). Edit the repo copy and re-run it.
#
# Included by /etc/pam.d/sudo and /etc/pam.d/sudo-i, immediately before
# `@include common-auth`. The PASSWORD comes first and works at once, exactly as
# common-auth checks it. An empty Enter (or a wrong password) falls through to
# the fingerprint, which fingerprint-should-skip offers only for sudo, with a
# real terminal and the lid open. When the finger fails, or is skipped,
# common-auth follows with a fresh password prompt and its own pam_deny.
#
# The gate's SUCCESS (exit 0, "skip") jumps over pam_fprintd; its failure
# ("offer") is ignored, so it never decides the outcome. quiet_log, because every
# offer is an exit 1 that pam_exec would otherwise log as a failure.
# Why each line is shaped as it is: docs/FINGERPRINT.md.
auth  sufficient                  pam_unix.so nullok
auth  [success=1 default=ignore]  pam_exec.so quiet quiet_log /usr/local/libexec/fingerprint-should-skip
auth  sufficient                  pam_fprintd.so max-tries=2 timeout=10
