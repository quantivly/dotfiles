# shellcheck shell=bash
# ~/.backup.local — machine-specific backup config (NOT tracked in git)
# ===========================================================================
# Mirrors ~/.gnome-settings.local / ~/.zshrc.local. Holds the repo URLs, B2
# credentials and healthcheck URLs that resticprofile/profiles.toml reads from
# the environment. backup-setup copies this to /etc/restic/backup.local (root
# 0600) — the systemd timers load it via an EnvironmentFile drop-in, and
# `backup-now` sources it for manual runs.
#
# FORMAT: plain KEY=value, ONE per line, NO `export`, NO shell expansion
#   ($USER/$HOME are NOT expanded here). This file is consumed both by `source`
#   and by systemd's EnvironmentFile parser, which only understands KEY=value.
#   Comments must be on their OWN line: systemd does not strip an inline "# ..."
#   after a value — it would become part of the value and break the key.
#
# Install:  backup-init       (renders this template here — user/hostname
#           placeholders become plain literals via scripts/backup-render.sh,
#           so the installed file still needs NO shell expansion)
# Set up:   backup-setup      (one-time: installs restic+resticprofile, repos, timers)
# Run now:  backup-now [b2|external|full]
#
# SECRETS: the restic repo password lives in Bitwarden AND on disk at
# /etc/restic/repo.key (root 0600), written by backup-setup. The B2 keys below
# are the APPEND-ONLY key (listFiles,readFiles,writeFiles — no deleteFiles).
# Keep the separate full-access key OFFLINE in the emergency kit, never here.
# Never commit this file (it is gitignored via *.local).

# --- restic repo password (root timers read this non-interactively) ---------
RESTIC_PASSWORD_FILE=/etc/restic/repo.key

# --- repo-v2 compression (text/code/configs compress well; ~free on binaries)
RESTIC_COMPRESSION=auto

# --- target 1: external HDD -------------------------------------------------
# BACKUP_EXTERNAL_UUID is REQUIRED for the disk to mount by itself. backup-setup
# writes an /etc/fstab entry from it, with `nofail` so an undocked disk can never
# break boot.
#
# Do not rely on the desktop to mount it. If the disk is not mounted,
# restic-backup-external.service fails its ConditionPathExists and systemd SKIPS
# it — and a skipped unit is not a failed unit: no error, no failed-unit entry,
# no desktop notification, and no healthchecks ping. The external target can sit
# dead for weeks while everything looks fine.
#
# Find it once docked:  lsblk -o NAME,UUID,LABEL,MOUNTPOINT
BACKUP_EXTERNAL_UUID=
# The repo sits one level under the mount point: backup-setup derives the mount
# point as this path's dirname, and the service gates on "<repo>/config". Keep
# them consistent.
BACKUP_EXTERNAL_REPO=/media/__BACKUP_USER__/Backup/restic
# Debounce auto-runs on re-dock (e.g. 6h):
BACKUP_EXTERNAL_MIN_INTERVAL=6h

# --- target 2: Backblaze B2 via the S3-compatible endpoint ------------------
# Format: s3:s3.<region>.backblazeb2.com/<bucket>   (NOT the native b2: backend)
# Region (e.g. us-west-002) is shown on the bucket's Endpoint in the B2 console.
BACKUP_B2_REPO=s3:s3.us-west-002.backblazeb2.com/__BACKUP_HOSTNAME__-backup
# AWS_ACCESS_KEY_ID = B2 application keyID (the APPEND-ONLY key, no deleteFiles).
# AWS_SECRET_ACCESS_KEY = its applicationKey. The full-access key stays OFFLINE.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- monitoring: healthchecks.io dead-man's-switch (blank = disabled) -------
# The run-after hook pings <url> on success and <url>/fail on failure, so you
# get alerted when a backup is OVERDUE (laptop asleep / undocked / offline).
# Create one check per line at https://healthchecks.io and paste its ping URL.
# Leaving these blank makes the alerting silently INERT — backup-doctor warns.
#
# BACKUP_HC_URL_EXTERNAL matters more than it looks: a SKIPPED external run
# pings nothing at all, so without this check the external target has no
# dead-man's switch of any kind.
BACKUP_HC_URL_B2=
BACKUP_HC_URL_EXTERNAL=
# Weekly verification (backup-verify.sh / backup-drill) dead-man's switch. A
# separate check so a verify failure is distinguishable from a backup failure.
BACKUP_HC_URL_VERIFY=

# --- capacity guardrails (backup-doctor; blank = check is skipped with a warn) ---
# The B2 repo is APPEND-ONLY and grows monotonically between manual prunes, so
# backup-doctor watches size and growth. Sizing rule: warn threshold ~60% of the
# Backblaze storage cap; cap >= ~3x the expected raw repo size (absorbs growth
# between prunes, prune's own repack uploads, and the ~30-day hidden-version
# billing lag after a prune).
# Warn when raw repo size (restic stats --mode raw-data) exceeds this many GB:
BACKUP_B2_SIZE_WARN_GB=15
# Warn when the last scheduled run stored more than this many MB (churn guard —
# catches a new churn source within one run instead of weeks later):
BACKUP_B2_CHURN_WARN_MB=512
# Remind to run backup-prune (offline full key) after this many days:
BACKUP_B2_PRUNE_REMIND_DAYS=120

# --- verification: critical paths the content canary asserts (blank = default)
# Whitespace/newline-separated ABSOLUTE paths that MUST appear in the latest
# snapshot. Blank uses the built-in set (~/.ssh, ~/.config, keyrings, ~/.dotfiles,
# /etc/NetworkManager/system-connections, the system manifest).
BACKUP_CANARY_PATHS=

# --- desktop notifications --------------------------------------------------
# BACKUP_NOTIFY: notify on FAILURE (1=on, 0=off). Success is silent by default
# (the healthcheck ping is the success signal). Set BACKUP_NOTIFY_SUCCESS=1 to
# also get a popup on every successful backup.
BACKUP_NOTIFY=1
BACKUP_NOTIFY_SUCCESS=0
# NOTIFY_USER: whose GUI session receives notify-send
NOTIFY_USER=__BACKUP_USER__
