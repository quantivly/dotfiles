# ============================================================================
# Build & Test Parallelism Limits
# ============================================================================
# Caps how many workers build/test tools spawn, so several concurrent agent
# sessions can't each claim every core.
#
# Why: most test runners and build tools default to "one worker per core".
# That default assumes it is the only thing running. With N parallel Claude
# Code sessions it becomes N x cores of demand on a machine that has
# cores, turning a 250ms prompt into a multi-second stall. Measured on this
# host: three sessions running tsc + vitest + go build together pushed the run
# queue past 40 on 8 threads.
#
# Two tiers:
#   - Inside a herdr pane ($HERDR_PANE_ID set): tight cap, since an unknown
#     number of sibling agents share the box.
#   - Interactive shell: half the cores, which still leaves the desktop
#     responsive while you wait on your own build.
#
# The gate was $ATRIUM_SESSION until Atrium was retired (2026-09-01). That is
# worth naming rather than quietly rewriting: an unset variable selects the
# LOOSE tier, so once Atrium stopped running, every agent pane silently got the
# half-the-cores budget meant for a solo human — the exact over-subscription
# this file exists to prevent, arriving as a config file that still looked
# correct. $HERDR_PANE_ID is herdr's equivalent and is set in every pane.
#
# Every value is a default, not an override: an explicitly-set variable or a
# per-invocation flag (`vitest --max-workers=8`) always wins.
#
# Loaded from zshrc after conditionals.
# ============================================================================

# Hardware thread count, with a conservative fallback if nproc is missing.
_bl_cores=$(command nproc 2>/dev/null || echo 4)

if [ -n "${HERDR_PANE_ID:-}" ]; then
    # Sharing the machine with sibling agent sessions: a QUARTER of the cores.
    #
    # This was a hardcoded 2 until 2026-09-16, which is the right number for the
    # 8-thread laptop it was tuned on and wrong the moment work moves anywhere
    # bigger: a 16-core box with two or three sessions ran its test suites
    # 2-way parallel while fourteen cores idled — the constraint travelling with
    # the work instead of being left behind. cores/4 keeps 8 threads at exactly
    # 2, so the machine this was written for does not move at all.
    _bl_jobs=$(( _bl_cores / 4 ))
else
    # Solo interactive work: half the cores.
    _bl_jobs=$(( _bl_cores / 2 ))
fi
# One floor for both tiers. Below 2 there is no parallelism left to cap.
[ "$_bl_jobs" -lt 2 ] && _bl_jobs=2
_BUILD_LIMITS_SOURCE="tier"

# An explicit override, for a box whose shape you actually know — a dedicated
# 16-core dev box carrying two sessions wants more than a quarter, and saying so
# should not need an edit to a tracked file. Set it in ~/.zshrc.local, which is
# sourced AFTER this module.
#
# An unusable value leaves the computed tier alone rather than being taken
# literally: 0 disables parallelism outright, and a negative, decimal or
# non-numeric value lands in MAKEFLAGS as a malformed flag the tool rejects —
# both worse than the default it was trying to improve on. It is not silent
# either; `build-limits` names it, which is the one place anybody looks when a
# build feels wrong.
case "${BUILD_LIMITS_JOBS:-}" in
    '')       : ;;
    *[!0-9]*) _BUILD_LIMITS_SOURCE="tier — BUILD_LIMITS_JOBS='$BUILD_LIMITS_JOBS' ignored (not a positive integer)" ;;
    0)        _BUILD_LIMITS_SOURCE="tier — BUILD_LIMITS_JOBS='0' ignored (not a positive integer)" ;;
    *)        _bl_jobs="$BUILD_LIMITS_JOBS"
              _BUILD_LIMITS_SOURCE="BUILD_LIMITS_JOBS=$BUILD_LIMITS_JOBS" ;;
esac

# --- JavaScript / TypeScript -------------------------------------------------
# Vitest reads VITEST_MAX_WORKERS (verified present in vitest 4.x).
export VITEST_MAX_WORKERS="${VITEST_MAX_WORKERS:-$_bl_jobs}"
# npm's build concurrency (node-gyp and friends).
export NPM_CONFIG_JOBS="${NPM_CONFIG_JOBS:-$_bl_jobs}"

# --- Go ----------------------------------------------------------------------
# -p caps parallel build/test actions. Deliberately NOT GOMAXPROCS: that would
# throttle the Go runtime of every binary we run, herdr's own server included.
# Unknown GOFLAGS entries are ignored by unrelated subcommands (verified against
# go env / version / help on go1.26).
export GOFLAGS="${GOFLAGS:--p=$_bl_jobs}"

# --- Rust --------------------------------------------------------------------
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-$_bl_jobs}"

# --- Python ------------------------------------------------------------------
# Consulted by pytest-xdist when invoked as `-n auto`.
export PYTEST_XDIST_AUTO_NUM_WORKERS="${PYTEST_XDIST_AUTO_NUM_WORKERS:-$_bl_jobs}"
# uv's parallel build/install fan-out.
export UV_CONCURRENT_BUILDS="${UV_CONCURRENT_BUILDS:-$_bl_jobs}"
export UV_CONCURRENT_INSTALLS="${UV_CONCURRENT_INSTALLS:-$_bl_jobs}"

# --- make --------------------------------------------------------------------
export MAKEFLAGS="${MAKEFLAGS:--j$_bl_jobs}"

unset _bl_cores _bl_jobs

# Report the active caps. Useful when a build feels slower than expected.
build-limits() {
    local context="interactive shell"
    [ -n "${HERDR_PANE_ID:-}" ] && context="herdr pane ($HERDR_PANE_ID)"
    printf '%-34s %s\n' \
        "context" "$context" \
        "cores (nproc)" "$(command nproc 2>/dev/null || echo '?')" \
        "source" "${_BUILD_LIMITS_SOURCE:-tier}" \
        "VITEST_MAX_WORKERS" "$VITEST_MAX_WORKERS" \
        "NPM_CONFIG_JOBS" "$NPM_CONFIG_JOBS" \
        "GOFLAGS" "$GOFLAGS" \
        "CARGO_BUILD_JOBS" "$CARGO_BUILD_JOBS" \
        "PYTEST_XDIST_AUTO_NUM_WORKERS" "$PYTEST_XDIST_AUTO_NUM_WORKERS" \
        "UV_CONCURRENT_BUILDS" "$UV_CONCURRENT_BUILDS" \
        "UV_CONCURRENT_INSTALLS" "$UV_CONCURRENT_INSTALLS" \
        "MAKEFLAGS" "$MAKEFLAGS"
}
