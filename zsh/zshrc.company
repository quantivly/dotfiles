# Quantivly-specific configuration
# This file contains work-related settings and company-specific utilities
#
# All Quantivly-specific functionality consolidated here for better
# version control, easier updates, and single source of truth.

# Warn about deprecated plugin (remove this block after 2026-03-01)
if [[ -d "${HOME}/.oh-my-zsh/custom/plugins/quantivly" ]]; then
  echo "⚠️  Deprecated: quantivly oh-my-zsh plugin detected" >&2
  echo "   Functionality now built into dotfiles (zshrc.company)" >&2
  echo "   Safe to remove: rm -rf ~/.oh-my-zsh/custom/plugins/quantivly" >&2
fi

#==============================================================================
# Environment Variables
#==============================================================================

# Quantivly development environment settings
# These can be overridden in ~/.zshrc.local for machine-specific values
export Q_MODE="${Q_MODE:-development}"
export Q_DEV_CODE_ROOT="${Q_DEV_CODE_ROOT:-${HOME}/quantivly/platform}"
export Q_WORKSPACES_ROOT="${Q_WORKSPACES_ROOT:-${HOME}/workspaces}"
export Q_WORKSPACE_NAME="${Q_WORKSPACE_NAME:-test}"
export Q_TEST_WORKSPACE_NAME="${Q_TEST_WORKSPACE_NAME:-cicd}"

# Docker environment variables
# Use fallback IP if hostname -I fails (e.g., no network interfaces)
_ip_addr=$(hostname -I 2>/dev/null | awk '{print $1}')
export IP_ADDRESS="${_ip_addr:-127.0.0.1}"
export EXTRA_HOSTS="$(hostname):${IP_ADDRESS}"
unset _ip_addr

# Platform test environment variables (cached for fast startup)
# Reads from ~/.cache/quanticli-paths/ synchronously (sub-ms),
# background job refreshes cache on every shell start.
# Manual refresh: qcache-refresh
_qcache_dir="${HOME}/.cache/quanticli-paths"
if [[ -r "$_qcache_dir/data" ]]; then
  export TEST_BASELINE_DATA_DIR="$(<"$_qcache_dir/data")"
else
  export TEST_BASELINE_DATA_DIR=""
fi
if [[ -r "$_qcache_dir/test" ]]; then
  _test_path="$(<"$_qcache_dir/test")"
  export TEST_BASELINE_REF_DIR="${_test_path}/testing-box-baseline/"
else
  export TEST_BASELINE_REF_DIR=""
fi
unset _test_path _qcache_dir

#==============================================================================
# Quanticli Aliases and Functions
#==============================================================================

# Quanticli shortcuts
# Ensure q is not aliased to something else first
unalias q 2>/dev/null
alias q='quanticli'
alias qg='quanticli git'
alias qgs='quanticli git status'
alias qh='quanticli hub'
alias qp='quanticli path'

# qn - Change directory to quantivly submodule or stack directory
# Usage: qn <directory-name>
# Example: qn auto-conf, qn sdk, qn (goes to code root)
qn() {
  : '
    Function: qn
    Description: Changes directory to the specified Quantivly submodule or stack directory.
    Usage: qn <directory-name>
    Parameters:
      <directory-name> - The name of the Quantivly submodule or stack directory to change to (or a partial match).
    Example:
      qn auto-conf
      qn sdk
    Notes:
      - If multiple directories match the specified name, the first match is used.
      - If no directories match the specified name, the current directory is not changed.
      - If no name is provided, the current directory will be changed to the root of the Quantivly repository.
    '
  if command -v quanticli &>/dev/null; then
    cd $(quanticli path ${1-code})
  else
    echo "Error: quanticli not found in PATH" >&2
    return 1
  fi
}

#==============================================================================
# GitHub CLI Multi-Account Switching
#==============================================================================
# Automatically switches gh CLI identity when entering Quantivly work directories.
# Opt-in: only activates if ~/.config/gh-quantivly/ exists (created via:
#   GH_CONFIG_DIR=~/.config/gh-quantivly gh auth login)

# Token cache location and the pre-2026-09-01 nickname purge.
#
# DEFINED OUTSIDE THE OPT-IN GATE BELOW. They were inside it, while
# `gh-refresh-tokens` — which calls both — is outside: on a machine with no
# ~/.config/gh-quantivly (a personal-only box, the exact case the gate exists
# for) the function hit `command not found`, took an EMPTY cache path, and then
# wrote a live token to `/<basename>` at the filesystem root while reporting
# `✓ … cached token` and returning 0.
#
# A parameter, not a `$(...)` helper: _update_gh_config reads it on every `cd`,
# and a command substitution there is a fork in the chpwd hot path — in a file
# whose own notes say that path was cut to a single git fork. One assignment
# achieves the deduplication a function was reached for.
typeset -g _GH_TOKEN_CACHE="${HOME}/.cache/gh-token-cache"

# `quantivly` and `personal` are also perfectly legal config-dir basenames, so
# this purges by name MINUS whatever the routing table currently uses. Ordering
# then stops mattering: purging after the writes deleted a token just cached,
# and purging before them threw away a still-valid token whenever that
# iteration's `gh auth token` failed transiently (keyring locked, gh updating).
_gh_purge_legacy_token_cache() {
  local -a _GH_CONFIGURED_DIRS _GH_CONFIGURED_WHY current
  local legacy
  if (( $+functions[_gh_configured_dirs] )); then
    _gh_configured_dirs
    current=( "${(@)_GH_CONFIGURED_DIRS:t}" )
  fi
  for legacy in quantivly personal; do
    (( ${current[(Ie)$legacy]} )) && continue
    [[ -e "$_GH_TOKEN_CACHE/$legacy" ]] && rm -f "$_GH_TOKEN_CACHE/$legacy"
  done
}

if [[ -d "$HOME/.config/gh-quantivly" ]]; then
    # Routing table for zsh/functions/github.sh (_gh_route_for, gh-doctor, the
    # chpwd hook below). Keyed on the repo's GitHub OWNER, matching the git
    # identity rules in ~/.gitconfig.local
    # (`hasconfig:remote.*.url:...quantivly/**`, #67) so the two cannot disagree
    # about which repository is work.
    #
    # Double-quoted deliberately: a single-quoted "$HOME/..." is a literal path
    # that never exists, and the route then silently never fires. gh-doctor
    # reports that state, but only because it checks the whole table rather than
    # the entry that happened to match.
    #
    # Declared inside the opt-in gate, not above it: a route naming a config dir
    # that does not exist on this machine is a permanent ✗ in gh-doctor, and a
    # checker that is permanently red is one nobody reads.
    GH_ACCOUNT_ROUTES=( "quantivly=$HOME/.config/gh-quantivly" )

    # Everything the routes do not match. The isolated single-account personal
    # dir when it exists (immune to `gh auth switch` flipping the shared
    # default's active user); otherwise EMPTY — with no dir to name, the remote
    # genuinely does not determine an account, and _update_gh_config says so
    # rather than having a default invented for it.
    if [[ -d "$HOME/.config/gh-personal" ]]; then
        GH_ACCOUNT_DEFAULT_DIR="$HOME/.config/gh-personal"
    else
        GH_ACCOUNT_DEFAULT_DIR=""
    fi

    # The account is chosen by the repo's REMOTE and pinned with $GH_TOKEN.
    # ------------------------------------------------------------------------
    # Two independent decisions, and each was previously made the wrong way:
    #
    # WHICH ACCOUNT — by remote (via GH_ACCOUNT_ROUTES above and _gh_route_for
    # in zsh/functions/github.sh), not by $PWD. $PWD is exactly the signal #67
    # moved git identity off, and keeping it here meant gh and git could
    # disagree about the same repository: a quantivly clone outside ~/quantivly/
    # got the personal account from gh and the work identity from git. The
    # routing now consults EVERY remote, like git's `hasconfig:remote.*.url`, so
    # a fork whose upstream is the work repo routes the way git already signs
    # it.
    #
    # HOW IT IS APPLIED — GH_CONFIG_DIR is not enough, and never was. gh keys
    # its tokens in the system keyring by HOST, so a config dir declaring one
    # account authenticates as whatever the shared default is; here that default
    # is the WORK account, in every directory. Only $GH_TOKEN actually pins it.
    # Run `gh-doctor` to see declared vs effective for the current directory.
    #
    # The cache is keyed by the config dir's BASENAME (gh-quantivly,
    # gh-personal) rather than by a nickname, so the routing table is the single
    # place an account is named — a route added there needs no matching edit
    # here, and a stale nickname cannot silently address the wrong dir.
    # Background refresh (non-blocking). Driven by the routing table, so it
    # refreshes exactly the dirs routing can select. --user is mandatory:
    # `gh auth token` without it returns the shared keyring default, which is
    # the very thing being worked around.
    #
    # A FUNCTION, not an inline `{ ... } &!` block: `local` outside a function
    # is an error in zsh, and the error goes to a backgrounded subshell's
    # stderr where nobody sees it — the cache simply stayed empty, and every
    # directory then reported "account NOT pinned". Writing a credential from
    # dynamically-scoped globals would have been the other way to get it wrong.
    _gh_refresh_token_cache_bg() {
        local -a _GH_CONFIGURED_DIRS _GH_CONFIGURED_WHY
        local cache="$_GH_TOKEN_CACHE" d u t
        mkdir -p "$cache" && chmod 700 "$cache" || return 1
        _gh_configured_dirs
        for d in "${_GH_CONFIGURED_DIRS[@]}"; do
            [[ -d "$d" ]] || continue
            u="$(GH_CONFIG_DIR="$d" gh config get -h github.com user 2>/dev/null)"
            [[ -n "$u" ]] || continue
            t="$(GH_CONFIG_DIR="$d" gh auth token --user "$u" 2>/dev/null)"
            [[ -n "$t" ]] || continue
            printf '%s' "$t" > "$cache/${d:t}" && chmod 600 "$cache/${d:t}"
        done
        _gh_purge_legacy_token_cache
    }
    if command -v gh &>/dev/null && (( $+functions[_gh_configured_dirs] )); then
        _gh_refresh_token_cache_bg &!
    fi

    # Select and pin the account for the current directory.
    #
    # Never prints during shell initialisation: p10k's instant prompt turns any
    # output there into a warning box. The first-prompt hook at the bottom of
    # this block flushes whatever the startup call recorded — the same deferral
    # the dotfiles live-config guard uses, for the same reason.
    _update_gh_config() {
        local _GH_ROUTE_STATE _GH_ROUTE_DIR _GH_ROUTE_WHY _tokfile _tok
        _GH_ROUTE_MSG=""

        # Explicit opt-out. Removing the Atrium deferral removed the only way a
        # supervisor that provisions per-session credentials could say "leave
        # this shell alone", and the hook would now clobber an injected
        # GH_CONFIG_DIR/GH_TOKEN on the first cd. The detection was the bad part
        # ($ATRIUM, or a tmux socket named */atrium — anything could set
        # either); a named switch restores the capability with no guessing, and
        # lets gh-doctor report such a shell as deliberate rather than faulty.
        if [[ -n "${GH_ACCOUNT_ROUTING_OFF:-}" ]]; then
            return 0
        fi

        if ! (( $+functions[_gh_route_for] )); then
            # zsh/functions/github.sh did not load. Choosing an account from a
            # routing table that is not there would mean choosing it from the
            # keyring, which is the defect; say so and pin nothing.
            unset GH_TOKEN GITHUB_TOKEN GITHUB_PERSONAL_ACCESS_TOKEN
            _GH_ROUTE_MSG="zsh/functions/github.sh is not loaded — account NOT routed; gh will use the keyring default"
            _gh_route_report
            return
        fi

        _gh_route_for "$PWD"
        case "$_GH_ROUTE_STATE" in
            matched|default) ;;
            bad-table|git-error)
                # git-error is NOT "there is no repo here": git could not be
                # asked, so the remote is unknown. Falling through to the
                # personal default would hand a work repo the wrong account on
                # the one path that stays quiet, so this one pins nothing and
                # says so.
                unset GH_CONFIG_DIR GH_TOKEN GITHUB_TOKEN GITHUB_PERSONAL_ACCESS_TOKEN
                _GH_ROUTE_MSG="$_GH_ROUTE_WHY — account NOT routed"
                _gh_route_report
                return ;;
            *)
                # The remote determines nothing here (no repo, no remotes, no
                # matching route and no default). Clearing GH_TOKEN leaves the
                # keyring to answer, and it answers WORK — so this is stated
                # rather than left to look like a personal-account directory.
                unset GH_CONFIG_DIR GH_TOKEN GITHUB_TOKEN GITHUB_PERSONAL_ACCESS_TOKEN
                _GH_ROUTE_MSG="no GitHub account is determined here ($_GH_ROUTE_WHY) — gh will use the keyring default, which is not necessarily the one you want"
                _gh_route_report
                return ;;
        esac

        export GH_CONFIG_DIR="$_GH_ROUTE_DIR"
        _tokfile="${_GH_TOKEN_CACHE}/${_GH_ROUTE_DIR:t}"
        if [[ -r "$_tokfile" ]]; then
            _tok="$(<"$_tokfile")"
        else
            _tok=""
        fi
        if [[ -n "$_tok" ]]; then
            export GH_TOKEN="$_tok"
            # For env-reading tools (Claude Code's github MCP plugin); gh itself
            # ignores this one.
            export GITHUB_PERSONAL_ACCESS_TOKEN="$_tok"
            # Cleared on the SUCCESS path as well, not just the failures. gh is
            # fine either way (GH_TOKEN outranks GITHUB_TOKEN), but everything
            # else that reads GITHUB_TOKEN — the GitHub MCP server, act, hub,
            # most Actions-shaped tooling — would keep authenticating as an
            # inherited third account in a correctly-routed directory, with
            # gh-doctor reporting `credential: $GH_TOKEN` and showing nothing
            # wrong. This hook owns the GitHub credential environment; leaving
            # one of its three variables pointing somewhere else is not owning
            # it. GH_ACCOUNT_ROUTING_OFF is the way to inject your own.
            unset GITHUB_TOKEN
        else
            # GH_CONFIG_DIR alone does NOT select the account, so this is not a
            # partial success — it is the keyring deciding. GITHUB_TOKEN is
            # cleared alongside GH_TOKEN on every such path because gh ranks it
            # second: an inherited one (a CI runner, an MCP wrapper, an .envrc)
            # would otherwise authenticate as a third account nobody named,
            # while this very message blamed the keyring. A cache miss is
            # normally transient (the background refresh above lands within a
            # second or two of shell start); a persistent one means that account
            # needs `gh auth login`.
            unset GH_TOKEN GITHUB_TOKEN GITHUB_PERSONAL_ACCESS_TOKEN
            _GH_ROUTE_MSG="no cached token for ${_GH_ROUTE_DIR:t} — account NOT pinned; run gh-refresh-tokens (or gh-doctor)"
        fi
        _gh_route_report
    }

    # Print a routing problem at most once per distinct message, and never
    # before the first prompt. Repeating the same line on every `cd` inside one
    # repository is how a warning becomes invisible.
    _gh_route_report() {
        [[ -n "$_GH_ROUTE_MSG" ]] || return 0
        (( _GH_ROUTE_INTERACTIVE )) || return 0
        [[ "$_GH_ROUTE_MSG" == "$_GH_ROUTE_LAST_MSG" ]] && return 0
        _GH_ROUTE_LAST_MSG="$_GH_ROUTE_MSG"
        print -u2 -- "gh: $_GH_ROUTE_MSG"
    }

    autoload -U add-zsh-hook
    add-zsh-hook chpwd _update_gh_config
    _update_gh_config  # Run once at shell startup (silent — see below)

    # Release the startup warning at the first prompt, then unhook. Deferred for
    # the same reason as the dotfiles live-config guard: output during
    # initialisation lands inside p10k's instant-prompt warning box.
    #
    # It RE-RUNS the routing rather than replaying what startup recorded. The
    # startup call commonly loses a race it is expected to lose: the token cache
    # is repopulated by the background job above, which lands a second or so
    # later, so the shell starts unpinned and records "account NOT pinned". By
    # the first prompt that is usually false — and replaying it both printed a
    # message that was no longer true AND left GH_TOKEN unset for the entire
    # life of the shell, so every gh call fell through to the host-keyed keyring
    # default (work) inside a personal repo. That is precisely the defect this
    # whole mechanism exists to close, reintroduced in the one shell per boot
    # nobody would think to re-check.
    _gh_route_first_prompt() {
        _GH_ROUTE_INTERACTIVE=1
        _GH_ROUTE_LAST_MSG=""      # startup was silent; do not suppress a real one now
        # Only re-run while there is nothing pinned. Once GH_TOKEN is set the
        # routing has already succeeded, and re-running would spend two more git
        # forks per prompt to reach the same answer.
        [[ -n "$GH_TOKEN" ]] || _update_gh_config
        # Retire the hook only once it has something to show for itself. It used
        # to unhook unconditionally after one attempt, so a shell that lost the
        # cache race TWICE — the refresher does two gh forks, and p10k's instant
        # prompt can arrive first on a loaded box — stayed on the host-keyed
        # keyring default for the rest of its life. Every later prompt is free:
        # the test above short-circuits before any fork.
        [[ -n "$GH_TOKEN" || -n "$GH_ACCOUNT_ROUTING_OFF" ]] || return 0
        add-zsh-hook -d precmd _gh_route_first_prompt
        unfunction _gh_route_first_prompt
    }
    add-zsh-hook precmd _gh_route_first_prompt
fi

#==============================================================================
# Claude Code Multi-Account Switching — REMOVED 2026-08-28
#==============================================================================
# Superseded by clauth (https://github.com/uwuclxdy/clauth). clauth owns
# CLAUDE_CONFIG_DIR globally now (via profile switch, not a per-directory
# chpwd hook) — a chpwd override here would fight it. Four profiles are
# registered: quantivly-{1,2,3} (was ~/.claude-work{,2,3}) and personal
# (was ~/.claude-personal).
#
# The old ~/.claude-quantivly this block gated on was already stale/abandoned
# (last touched 2026-06-27) and is not one of the four accounts clauth manages.

#==============================================================================
# Git Aliases (Quantivly-specific)
#==============================================================================

alias grpo="git remote prune origin"

#==============================================================================
# Docker Utilities
#==============================================================================

# dsh - Open a bash shell in specified Docker container
# Usage: dsh <container_name>
# Example: dsh my_container
dsh() {
  : '
    Function: dsh
    Description: Opens a bash shell in the specified Docker container.
    Usage: dsh <container_name>
    Parameters:
      <container_name> - The name of the Docker container in which to open a bash shell.
    Example:
      dsh my_container
    Notes:
      - The container must be running.
    '
  if [[ -z "$1" ]]; then
    echo "Usage: dsh <container_name>" >&2
    return 1
  fi

  local container_id=$(docker ps -aqf "name=$1")
  if [[ -z "$container_id" ]]; then
    echo "Error: No running container found matching '$1'" >&2
    return 1
  fi

  docker exec -it "$container_id" bash
}

# Docker service aliases
alias dsls="docker service ls"
alias dslf="docker service logs -f --raw"

#==============================================================================
# Database Utilities (Platform-specific)
#==============================================================================

# Box database shortcuts (uses cached workspace path)
# Note: Workspace path is evaluated at shell startup - reload shell after switching workspaces
_qcache_dir="${HOME}/.cache/quanticli-paths"
if [[ -r "$_qcache_dir/workspace" ]]; then
  _box_workspace_path="$(<"$_qcache_dir/workspace")"
elif command -v quanticli &>/dev/null; then
  _box_workspace_path="${Q_WORKSPACES_ROOT}/${Q_WORKSPACE_NAME}"
fi
if [[ -n "$_box_workspace_path" ]]; then
  alias box-psql="$_box_workspace_path/configs/box/postgres/psql.sh -d box"
  alias box-purge='$_box_workspace_path/configs/box/postgres/psql.sh -d box -c "truncate examination, acquisition restart identity cascade;"'
fi
unset _box_workspace_path _qcache_dir

# Background refresh of quanticli path cache (non-blocking)
if command -v quanticli &>/dev/null; then
  {
    _dir="${HOME}/.cache/quanticli-paths"
    mkdir -p "$_dir"
    for _key in data test workspace; do
      _val=$(quanticli path "$_key" 2>/dev/null)
      [[ -n "$_val" ]] && printf '%s' "$_val" > "$_dir/$_key"
    done
  } &!
fi

# qcache-refresh - Force refresh of quanticli path cache and reload env vars
qcache-refresh() {
  if ! command -v quanticli &>/dev/null; then
    echo "Error: quanticli not found in PATH" >&2
    return 1
  fi
  local _dir="${HOME}/.cache/quanticli-paths"
  mkdir -p "$_dir"
  for _key in data test workspace; do
    local _val
    _val=$(quanticli path "$_key" 2>/dev/null)
    if [[ -n "$_val" ]]; then
      printf '%s' "$_val" > "$_dir/$_key"
      echo "Cached $_key: $_val"
    fi
  done
  # Reload the env vars
  export TEST_BASELINE_DATA_DIR="$(<"$_dir/data")"
  local _test_path="$(<"$_dir/test")"
  export TEST_BASELINE_REF_DIR="${_test_path}/testing-box-baseline/"
  echo "Environment variables updated."
}

# gh-refresh-tokens - Force refresh of the GH token cache and re-apply it here
#
# Same work the background job at shell start does, synchronously and with
# output. Driven by GH_ACCOUNT_ROUTES, so it covers exactly the config dirs
# routing can select and needs no edit when a route is added.
#
# --user is not optional: `gh auth token` without it returns the shared,
# host-keyed keyring default, which on this machine is the WORK account
# regardless of GH_CONFIG_DIR. Caching that as the personal token is how the
# wrong credential gets pinned deliberately. See `gh-doctor`.
gh-refresh-tokens() {
  if ! command -v gh &>/dev/null; then
    echo "Error: gh CLI not found in PATH" >&2
    return 1
  fi
  if ! (( $+functions[_gh_configured_dirs] )); then
    echo "Error: zsh/functions/github.sh is not loaded — no routing table to refresh from" >&2
    return 1
  fi
  local -a _GH_CONFIGURED_DIRS _GH_CONFIGURED_WHY
  local dir user token cached=0 failed=0 cache="$_GH_TOKEN_CACHE"
  if ! mkdir -p "$cache" || ! chmod 700 "$cache"; then
    echo "Error: cannot prepare $cache" >&2
    return 1
  fi

  _gh_configured_dirs
  if (( ${#_GH_CONFIGURED_DIRS[@]} == 0 )); then
    echo "Error: GH_ACCOUNT_ROUTES and GH_ACCOUNT_DEFAULT_DIR are both empty" >&2
    return 1
  fi

  for dir in "${_GH_CONFIGURED_DIRS[@]}"; do
    if [[ ! -d "$dir" ]]; then
      echo "  ✗ ${dir/#$HOME/~}: no such directory (fix GH_ACCOUNT_ROUTES)" >&2
      failed=$((failed + 1))
      continue
    fi
    user="$(GH_CONFIG_DIR="$dir" gh config get -h github.com user 2>/dev/null)"
    if [[ -z "$user" ]]; then
      echo "  ✗ ${dir/#$HOME/~}: declares no github.com user (gh auth login there?)" >&2
      failed=$((failed + 1))
      continue
    fi
    token="$(GH_CONFIG_DIR="$dir" gh auth token --user "$user" 2>/dev/null)"
    if [[ -z "$token" ]]; then
      echo "  ✗ ${dir/#$HOME/~}: no per-user token for $user" >&2
      failed=$((failed + 1))
      continue
    fi
    # Check the write AND the chmod before claiming success. Printing ✓ on an
    # unwritable cache (or a full filesystem) is the silent-failure shape, in
    # the one command a user runs specifically to repair the cache.
    if ! printf '%s' "$token" > "$cache/${dir:t}" 2>/dev/null; then
      echo "  ✗ ${dir:t}: could not write $cache/${dir:t}" >&2
      failed=$((failed + 1))
      continue
    fi
    if ! chmod 600 "$cache/${dir:t}"; then
      echo "  ✗ ${dir:t}: cached but could not chmod 600 — removing" >&2
      rm -f "$cache/${dir:t}"
      failed=$((failed + 1))
      continue
    fi
    echo "  ✓ ${dir:t}: cached token for $user"
    cached=$((cached + 1))
  done
  _gh_purge_legacy_token_cache

  # Re-apply for the current directory (no cd needed).
  if (( $+functions[_update_gh_config] )); then
    _update_gh_config
    echo "Applied for $PWD."
  fi
  (( failed == 0 )) || return 1
  (( cached > 0 ))
}
