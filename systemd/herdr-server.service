# systemd/herdr-server.service
# ============================
# Runs the herdr server headless as a systemd USER service, from the declared
# clean environment built by scripts/herdr-server-launch.sh — read that header
# for the why (herdr-eval finding F1: a server restarted from inside a team-lead
# pane handed a fake TMUX, the teammux shim, HERDR_PANE_ID=w2:p1 and
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 to every pane on the machine). Same
# pattern as clauth-daemon.service.
#
# Symlinked to ~/.config/systemd/user/ by ./install (install.conf.yaml). Linking
# does NOT enable it. One-time switch-over, from a PLAIN terminal — not a herdr
# pane, not a Claude session:
#   systemctl --user daemon-reload
#   herdr server stop                       # ends EVERY agent session on the machine
#   systemctl --user disable herdr-server.service     # only if enabled under the OLD target
#   systemctl --user enable --now herdr-server.service
#   scripts/verify-tools.sh                 # "herdr server environment hygiene" must be green
#                                           # (non-zero exit on a hygiene FAIL)
#   journalctl --user -u herdr-server.service -e
# Afterwards bare `herdr` at a keyboard attaches to this server ("Launch or
# attach to the persistent session", `herdr --help`) instead of starting its
# own; ctrl+alt+q detaches the client and leaves the server running as before.
#
# `systemctl --user stop|restart herdr-server.service` ENDS EVERY AGENT SESSION.
# Pane shells and the agents inside them are children of the server and live in
# this unit's cgroup; stopping the unit is `tmux kill-server`, not a reload.
# `herdr server reload-config` is still the way to apply config changes. Before
# stopping, look at `herdr pane list` as well as `herdr agent list` — herdmates
# teammates and panes on Claude's trust dialog are not detected as agents.
#
# Comments must be on their own lines: systemd treats text after a value as part
# of the value.

[Unit]
Description=herdr server (headless, clean declared environment)
Documentation=file://%h/.dotfiles/docs/HERDR_GUIDE.md
# Ordered AFTER the graphical session, and started BY it (see [Install]). The
# launcher passes DISPLAY / WAYLAND_DISPLAY / XAUTHORITY / SSH_AUTH_SOCK through
# only when set, and those reach the user manager when GNOME imports them at
# session start. `loginctl show-user` reports Linger=yes here, so the user
# manager — and therefore default.target — comes up at BOOT, well before any
# graphical session exists: a unit wanted by default.target would start with
# none of them. graphical-session.target is reached via gnome-session.target
# after gnome-session-manager@<session>.service, which is what performs that
# import, so hanging off it is what makes the environment complete.
After=graphical-session.target

[Service]
Type=simple
# The launcher `env -i`s and re-declares the environment itself, so nothing from
# the user manager reaches the server except what it passes through explicitly
# (DBUS_SESSION_BUS_ADDRESS, WAYLAND_DISPLAY, DISPLAY, ... — see its header).
# No Environment=/EnvironmentFile= here on purpose: one place declares the env.
ExecStart=%h/.dotfiles/scripts/herdr-server-launch.sh
# Stop through herdr's own API ("Stop the running server via the API socket",
# `herdr server stop --help`) so herdr, not a signal, winds down its panes.
# Runs under the manager's env, which has HOME — enough to find the default
# socket ~/.config/herdr/herdr.sock. Resolve herdr instead of hardcoding one
# location (ExecStart's launcher resolves it across ~/.local/bin, the mise bin
# dirs and ~/.cargo/bin): prefer ~/.local/bin/herdr, where it lives here, else
# fall back to the manager's PATH — a hardcoded path that is wrong on another
# machine fails 203/EXEC and the wind-down falls straight to SIGTERM. If neither
# resolves, sh exits non-zero and stop likewise falls through to KillMode below.
# ($$ is systemd's escape for a literal $, so the shell sees $h / $(...).)
# UNVERIFIED under the unit until first use.
ExecStop=/bin/sh -c 'h=%h/.local/bin/herdr; [ -x "$$h" ] || h=$$(command -v herdr) || exit 1; exec "$$h" server stop'
# mixed: after ExecStop, SIGTERM goes to the server process only; anything still
# alive in the cgroup after TimeoutStopSec (orphaned pane shells, agents) gets
# SIGKILL. control-group (the default) would SIGTERM every pane process at the
# same instant as the server; process would leave orphans running forever.
KillMode=mixed
TimeoutStopSec=30
# on-abnormal, not on-failure: a deliberate `herdr server stop` from a shell
# must stay down, and both documented switch-over/remediation sequences run
# exactly that stop followed by a start. herdr's exit code on a requested stop
# is UNVERIFIED — under on-failure a non-zero exit there would resurrect the
# server 2s later, racing the very runbook that stopped it. on-abnormal never
# restarts on ANY exit code (clean or not), so nothing rides on that unknown; it
# still restarts after unclean signals, timeouts and watchdog kills, where
# systemd's default start-rate limit (5 in 10s) still ends a crash loop. A
# launcher that die()s (herdr missing from PATH, contaminated caller) exits 1
# and correctly stays down rather than looping.
Restart=on-abnormal
RestartSec=2

[Install]
# graphical-session.target, NOT default.target — see the After= note above; the
# server needs the session environment that only exists once GNOME has imported
# it. This does NOT cost persistence: WantedBy propagates START only. Stop
# propagation would need PartOf=/BindsTo=, which this unit deliberately does not
# have, so the server survives logout and keeps every agent session alive — the
# entire point of running it as a persistent host. Re-login is idempotent (the
# unit is already active, so the second start is a no-op).
#
# Cost, accepted: on a headless or SSH-only boot graphical-session.target is
# never reached and no server starts. Start one by hand there:
#   systemctl --user start herdr-server.service
#
# CHANGING THIS FIELD DOES NOT MOVE AN EXISTING SYMLINK. A unit enabled under
# the old target keeps its default.target.wants/ link until re-enabled:
#   systemctl --user daemon-reload
#   systemctl --user disable herdr-server.service
#   systemctl --user enable herdr-server.service     # --now only if none runs
# Verify: systemctl --user show herdr-server.service -p WantedBy
WantedBy=graphical-session.target
