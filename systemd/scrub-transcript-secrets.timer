# systemd/scrub-transcript-secrets.timer
# ======================================
# Runs scrub-transcript-secrets.service once a day. See that unit's header for
# what it does and why it is a timer at all.
#
# WHY DAILY — AND THE REASON IS NOT wt-gc-sweep's. That one is daily because it
# is the most network-expensive job on this machine and running it faster buys
# nothing. This one makes NO network call at all: measured 2026-09-23 on
# cilantro, 4.2 GB of transcripts across both roots, and a full counts-only pass
# over them took 6.1 s wall. Cost is not what bounds the cadence here.
#
# SKIP RATE IS. Every run rewrites files that live sessions may be appending to,
# and the script refuses those rather than clobbering an append — so the useful
# work a run does is inversely proportional to how many sessions are awake. An
# hourly timer would rewrite the same ~2,400 files twenty-four times a day over a
# corpus that gained a handful of lines, and would spend most of its runs
# skipping exactly the transcripts that matter most: the active ones. Once a day,
# when the fewest sessions are live, is when the fewest files are skipped.
#
# WHY 03:00, AND NOT wt-gc-sweep's 04:00. Deliberately an hour apart, because
# Persistent=true means a desktop asleep at the scheduled time runs the job on
# the next resume — alongside everything else that was missed. Both carry half an
# hour of jitter for the same reason.
#
# A MISSED NIGHT COSTS NOTHING. The tool is idempotent: a second pass over an
# already-scrubbed transcript is a byte-for-byte no-op, and a transcript skipped
# because a session was writing to it is caught by the next run. That is what
# makes a daily cadence sufficient rather than merely cheap.

[Unit]
Description=Daily scrub of credentials from Claude Code transcripts
Documentation=file://%h/.dotfiles/scripts/scrub-transcript-secrets.py

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=30min
Persistent=true
AccuracySec=5min

[Install]
# CHANGING THIS FIELD DOES NOT MOVE AN EXISTING SYMLINK — run ./install, never
# `systemctl --user reenable`, which would delete the dotbot symlink that IS the
# unit. See systemd/herdr-server.service's [Install] note for the full account.
WantedBy=default.target
