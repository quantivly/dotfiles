# systemd/claude-memory-sync.service
# ==================================
# One tick of the Claude Code memory sync (DO-892): link, then sync every store
# checked out on this host. Guide: docs/CLAUDE_SETUP.md, "Memory stores".
#
# WHAT IT RUNS. Two steps, in this order:
#   1. scripts/claude-memory-link.sh --apply   makes each project's `memory`
#      entry a symlink into its store, finishing any merge a stopped run left;
#   2. scripts/claude-memory-sync.sh --apply   commits each store, withholding a
#      file with a credential shape, merges its remote (never rebases) and
#      pushes. Each header has the full rules.
#
# THE LINK STEP CANNOT STOP THE SYNC. It is ExecStartPre=-, so its exit 2 (could
# not run) is ignored and the sync runs anyway: memory already linked keeps
# travelling while one key is broken. That failure is then visible in ONE place
# only, claude-doctor's "Memory stores" link row (the journal aside), and never
# as a failed unit.
#
# THE TIME LIMIT. The sync stops starting network work at its run deadline,
# RUN_DEADLINE_SECONDS (240 s), but never cuts a step short, so a gh-route call
# and a fetch that began just before it can add about 90 s: a worst case of about
# 330 s, plus the local git work of the stores after it. 6 min leaves the rest for
# the link step, which is local work. A limit under the worst case would kill a
# slow but healthy run mid-step; no limit would let a hung one block every later
# tick, since Type=oneshot has no start timeout by default and the timer does not
# fire while the last run is still active.
#
# EXIT STATUS. The sync exits 0 or 2. A withheld file, a conflict copy, a blocked
# merge, a rejected push, a missing token and an unreachable remote are all exit
# 0: each store's outcome goes to ~/.local/state/claude-memory-sync/<store>.status
# and claude-doctor shows it through `claude-memory-sync.sh --status`. Only a
# store the sync cannot operate on fails this unit.
#
# CONDITIONPATHEXISTS. A host with no store root has nothing to sync, and systemd
# SKIPS the unit there rather than failing it. On a host where the timer is
# ARMED, scripts/check-timer-health.sh reports a skipped timer-activated unit as a
# fault, and here that is right: a stores root that went away means memory
# stopped travelling (docs/TIMER_HEALTH.md).
#
# LINKED BUT NOT ENABLED, deliberately. ./install symlinks this unit; it does not
# start it. It pushes to a remote unattended, so it is armed by hand on each host,
# after reading what the first tick would do (the exit status of a --check is 1
# whenever anything is pending, which before a first tick is normal):
#   ~/.dotfiles/scripts/claude-memory-link.sh --apply --dry-run
#   ~/.dotfiles/scripts/claude-memory-sync.sh --check
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-memory-sync.timer
# Never `systemctl --user reenable` — its disable half deletes the dotbot symlink
# that IS the unit. See systemd/herdr-server.service's [Install] note.
#
# Watch it:  journalctl --user -u claude-memory-sync.service -e
# Read it:   ~/.dotfiles/scripts/claude-memory-sync.sh --status, or claude-doctor

[Unit]
Description=Link Claude Code memory into its stores, then sync each store with its remote
Documentation=file://%h/.dotfiles/docs/CLAUDE_SETUP.md
ConditionPathExists=%h/.local/share/claude-memory

[Service]
Type=oneshot
# A user unit has no login shell, so PATH is systemd's own. Every tool both
# scripts use (git, jq, flock, timeout, sha256sum, zsh for gh-route and
# tenant-route) is in /usr/bin; ~/.local/bin is first for a host that keeps one
# there.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=-%h/.dotfiles/scripts/claude-memory-link.sh --apply
ExecStart=%h/.dotfiles/scripts/claude-memory-sync.sh --apply
TimeoutStartSec=6min
