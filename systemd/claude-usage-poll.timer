# Every 5 minutes, but a run sends nothing while clauth is healthy (DO-813).
# The usage endpoint's limit is per account, a sliding window that counts
# refused requests too, and clauth's 90 s cadence fills it. Measured
# 2026-10-10: two requests on one account under 60 s apart were refused 41% of
# the time, 60-90 s apart 9%; with this poller running clauth was refused on
# 18% of its own fetches, with it stopped on 1 of 198 (until a burst across
# every account that no poller caused). No interval or gap fits a second
# reader beside clauth, so an account is polled only when clauth's
# usage_cache.json is older than CLAUDE_USAGE_POLL_STALE_AFTER (default 600 s,
# the gate's freshness bound) and clauth is not RateLimited on it. Polled
# profiles go CLAUDE_USAGE_POLL_GAP seconds apart (default 3, DO-789): a burst
# courtesy, never the budget. The record: docs/CLAUDE_ACCOUNT_PICKER.md, "The
# usage endpoint has no room for a second reader".
[Unit]
Description=Shadow poll of Claude usage per account dir, every 5 minutes (DO-786)

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=false

[Install]
WantedBy=timers.target
