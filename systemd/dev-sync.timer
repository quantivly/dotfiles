# systemd/dev-sync.timer
# ======================
# Runs dev-sync.service once a day, on dev only (see that unit's ConditionPathExists).
#
# WHY DAILY, NOT WEEKLY. Every step is gated on drift, so a day with nothing upstream is a
# few `git ls-remote`s and one registry request. Weekly would let the clones go up to
# seven days stale, and once herdr-draft starts work sessions on dev by default (plan step
# B2), stale clones are what a new session starts from. Claude Code goes to `latest` here
# because the laptop's own auto-updater follows that channel, so dev is never further
# behind than the laptop by more than a day.
#
# 05:00 dev-local with a half-hour jitter: off the working day in both time zones, and
# Persistent=true catches up a run missed while the user manager was down.

[Unit]
Description=Daily dev-sync: keep dev's tooling level with the laptop's
Documentation=file://%h/.dotfiles/scripts/dev-sync

[Timer]
OnCalendar=*-*-* 05:00:00
RandomizedDelaySec=30min
Persistent=true
AccuracySec=5min

[Install]
# CHANGING THIS FIELD DOES NOT MOVE AN EXISTING SYMLINK; run ./install, never
# `systemctl --user reenable` (see systemd/herdr-server.service's [Install]).
WantedBy=default.target
