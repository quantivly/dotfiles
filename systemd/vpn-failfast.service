# systemd/vpn-failfast.service
# ============================
# Installed root-owned to /etc/systemd/system/ by `vpn-setup`, never by
# ./install — ./install never uses sudo, the same rule backup-setup and
# audit-setup follow.
#
# STATIC. No placeholders, nothing rendered. The first version of this file
# carried a rendered-path ExecStart pointing into the checkout, and that was
# wrong twice over:
#
#   * `vpn-setup` resolves its checkout from $PWD when that looks like one, so
#     running it from a WORKTREE baked a worktree path into a root unit. Measured
#     on the first real install:
#       ExecStart="/home/zvi/.herdr/worktrees/.dotfiles/zvi-do-692-.../vpn-failfast.sh"
#     `wt-gc-sweep` DELETES landed worktrees daily, so that unit was one sweep
#     away from a root service pointing at nothing — and it is the same class as
#     CLAUDE.md's "never run ./install from a worktree", which this repo already
#     knows about and which this reproduced anyway.
#   * An ExecStart under /home forces ProtectHome down to `read-only`, because
#     `yes` makes /home inaccessible and the unit then cannot run its own script.
#
# The house pattern for a repo script that ROOT runs is to COPY it into
# /usr/local/bin, exactly as backup-verify.sh, backup-manifest.sh and
# restic-notify already are — and restic-verify.service proves it works here:
# same `#!/usr/bin/env bash` shebang, root system unit, Result=success.
# vpn-doctor reports drift between the installed copy and this checkout, which is
# the backup-doctor shape.
#
# CONFIRMED STARTING, 2026-09-23 16:27, first install from /usr/local/bin:
# ActiveState=active, NRestarts=0, a clean journal, and the full hardening below
# in force — including ProtectHome=yes, which the /home ExecStart had made
# impossible. The install before it, from a worktree path under /home, failed
# with `coreutils: unknown program 'vpn-failfast'` on every start.
#
# That message is explained but its TRIGGER was never isolated, and moving the
# daemon here made it moot rather than answering it. uutils is the system
# coreutils on this box and its multicall strips the extension from argv[0], so
# the message means something re-entered the dispatcher as `vpn-failfast.sh`.
# Recorded in docs/VPN_INTERNALS.md as closed-by-removal, not solved: if it ever
# recurs from /usr/local/bin, that is new information.

[Unit]
Description=Fail fast for VPN-only destinations while the tunnel is down
Documentation=file:///usr/local/share/doc/vpn-failfast/VPN_RESILIENCE.md
# After=, never Requires=/BindsTo=: this must run whether or not the VPN client
# is installed, running or connected — its entire job is to react to the tunnel
# NOT being there. A dependency on the client would make "the client is not
# running" a reason for the fail-fast not to run, which is exactly backwards.
After=network.target
# Deliberately NOT Wants=network-online.target. Waiting for the network to be
# "online" delays the window in which this is most needed — early boot, before a
# tunnel exists — and network-online.target's meaning is per-backend and weak.

# IN [Unit], NOT [Service], and that is load-bearing rather than tidy. systemd
# moved these in v229; `StartLimitBurst` in [Service] still parses as a legacy
# alias but `StartLimitIntervalSec` does NOT, and systemd IGNORES it with only
# a log line. The burst then applies against the DEFAULT 10s interval, and with
# RestartSec=5 five restarts span 20s — so the limiter never trips and a broken
# unit restarts FOREVER without ever reaching `failed`. That is the exact
# crash-loop the NRestarts guard in check-timer-health.sh was added for.
#
# It earned its place on the first real install: the unit failed, restarted five
# times, and then STOPPED with Result=exit-code instead of spinning. Loud, and
# over in 25 seconds.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/vpn-failfast.sh --watch
# The withdraw path, and it runs on EVERY stop — clean, failed, killed or
# reloaded. A leftover `unreachable` route blackholes a host permanently and
# looks exactly like a server outage, so this is the single most important line
# in the file. It is belt to the script's own SIGTERM trap, and braces to the
# --watch path's "remove orphans before adding anything" at start, because the
# case that strands routes is precisely the one where the stop path did not run.
ExecStopPost=/usr/local/bin/vpn-failfast.sh --clear

# on-failure, not always: `systemctl stop vpn-failfast` must stay stopped, and
# an operator stopping this is the documented way to clear the routes by hand.
Restart=on-failure
RestartSec=5

# Least privilege. The one capability this needs is CAP_NET_ADMIN; everything
# else is dropped. Deliberately NOT ProtectSystem=strict + ReadWritePaths, which
# would add a second thing to keep in sync for no gain here — this writes no
# files at all.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=full
# `yes` is correct again now that ExecStart is /usr/local/bin rather than a path
# under /home. It had to be weakened to read-only while the script ran out of the
# checkout; moving the script is what buys the stronger setting back.
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK is how `ip` talks to the kernel; AF_UNIX for the journal.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
