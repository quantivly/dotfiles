# systemd/vpn-failfast.service
# ============================
# TEMPLATE. Rendered and installed root-owned to /etc/systemd/system/ by
# `vpn-setup`, never by ./install — ./install never uses sudo, the same rule
# backup-setup and audit-setup follow. __VPN_DOTFILES__ becomes the absolute path
# of the checkout that installed it, substituted by scripts/vpn-render.sh.
#
# WHY A SYSTEM UNIT. Installing and removing routes needs CAP_NET_ADMIN, which a
# user unit does not have. That is also why this unit is held to a much tighter
# standard than the user-session notifier: it is root, and the one thing it must
# never do is act on input an unprivileged process can write. It reads `ip -j
# link` and `ip -j route` and nothing else. See the script's header.
#
# COPIED, NEVER SYMLINKED, for the same reason CLAUDE.md gives for
# resticprofile/profiles.toml and audit/99-logout-catch.rules: ROOT runs this,
# and a symlink into a working tree means a rebase, a bisect or a half-finished
# checkout changes what root executes. vpn-doctor reports drift between the
# installed copy and this checkout, which is the backup-doctor shape.
#
# NOT YET LOADED BY A SYSTEM MANAGER on this machine -- that needs sudo, which
# does not work from an agent tool here. What IS verified, by
# scripts/test-vpn-failfast.sh: the script it starts (hermetically), that this
# file renders with no placeholder left, that `systemd-analyze verify` is silent
# on the rendered result, and that ProtectHome does not hide the ExecStart.
#
# Those last two exist because BOTH of the defects they catch shipped here and
# were found by hand, one command before the first install. Neither shows up in a
# diff, and systemd-analyze catches only one of them.

[Unit]
Description=Fail fast for VPN-only destinations while the tunnel is down
Documentation=file://__VPN_DOTFILES__/docs/VPN_RESILIENCE.md
# After=, never Requires=/BindsTo=: this must run whether or not the VPN client
# is installed, running or connected — its entire job is to react to the tunnel
# NOT being there. A dependency on the client would make "the client is not
# running" a reason for the fail-fast not to run, which is exactly backwards.
After=network.target
# Deliberately NOT Wants=network-online.target. Waiting for the network to be
# "online" delays the window in which this is most needed — early boot, before a
# tunnel exists — and network-online.target's meaning is per-backend and weak.

# IN [Unit], NOT [Service], and that is load-bearing rather than tidy. systemd
# moved these in v229; `StartLimitBurst` in [Service] still parses as a legacy
# alias but `StartLimitIntervalSec` does NOT, and systemd IGNORES it with only
# a log line. The burst then applies against the DEFAULT 10s interval, and with
# RestartSec=5 five restarts span 20s -- so the limiter never trips and a broken
# unit restarts FOREVER without ever reaching `failed`. That is the exact
# crash-loop the NRestarts guard in check-timer-health.sh was added for, and it
# shipped inside the unit that guard was added for. `systemd-analyze verify` is
# what says so; scripts/test-vpn-failfast.sh now runs it on both units.
#
# A bad /etc/vpn-failfast.conf makes the script exit 2 at once, so this is the
# difference between a unit that gives up loudly and one that spins silently.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart="__VPN_DOTFILES__/scripts/vpn-failfast.sh" --watch
# The withdraw path, and it runs on EVERY stop — clean, failed, killed or
# reloaded. A leftover `unreachable` route blackholes a host permanently and
# looks exactly like a server outage, so this is the single most important line
# in the file. It is belt to the script's own SIGTERM trap, and braces to the
# --watch path's "remove orphans before adding anything" at start, because the
# case that strands routes is precisely the one where the stop path did not run.
ExecStopPost="__VPN_DOTFILES__/scripts/vpn-failfast.sh" --clear

# on-failure, not always: `systemctl stop vpn-failfast` must stay stopped, and
# an operator stopping this is the documented way to clear the routes by hand.
Restart=on-failure
RestartSec=5

# Least privilege. The one capability this needs is CAP_NET_ADMIN; everything
# else is dropped. Deliberately NOT ProtectSystem=strict + ReadWritePaths, which
# would add a second thing to keep in sync for no gain here — this writes no
# files at all.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=full
# read-only, NOT yes. `ProtectHome=yes` makes /home "inaccessible and empty"
# (systemd.exec), and the ExecStart above lives under /home because in this repo
# THE CHECKOUT IS THE DEPLOYMENT -- so `yes` stops the unit executing its own
# script, 203/EXEC, on every single start. Caught before the first install by
# reading the man page; a `systemd-run --user` probe of the same setting proved
# NOTHING, because the user manager ignores ProtectHome entirely (measured:
# /home held the same 115 entries with and without it).
#
# read-only suffices: this writes nothing under /home, and it is root, so this
# was always defence-in-depth rather than a boundary. The real hardening is
# CAP_NET_ADMIN-only plus NoNewPrivileges and the syscall filter below.
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK is how `ip` talks to the kernel; AF_UNIX for the journal.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
