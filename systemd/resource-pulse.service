# systemd/resource-pulse.service
# ===============================
# The Resource Pulse sampler service: samples CPU, memory, swap, pressure and
# the app ranking on a 2 s timer, and serves them on the session bus as
# io.github.quantivly.dotfiles.ResourcePulse1, so the GNOME Shell extension
# (gnome-shell/extensions/resource-pulse@dotfiles) only draws. It runs the
# extension's own service/main.js, under plain gjs, never inside gnome-shell.
# Design: docs/superpowers/specs/2026-11-08-resource-pulse-service-design.md;
# guide: docs/GNOME_CONFIGURATION_GUIDE.md.
#
# STARTED ON DEMAND BY THE EXTENSION, NEVER ENABLED. There is no [Install]
# section, so nothing can enable it. The extension's enable() asks systemd to
# start it (StartUnit, "replace"), so it runs only for someone who opted in with
# `genable_extension resource-pulse@dotfiles`; for everyone else this link is
# inert. Opting out leaves it running until logout; this stops it at once:
#   systemctl --user stop resource-pulse.service
# and the extension never starts it again before its next enable().
# Never `systemctl --user enable` or `reenable` it: there is nothing to enable,
# and reenable's disable half deletes the dotbot symlink that IS this unit (see
# systemd/herdr-server.service's [Install] note).
#
# Symlinked to ~/.config/systemd/user/ by ./install (install.conf.yaml), which
# also reloads systemd and try-restarts this unit when, and only when, a file
# under the extension's service/ or lib/ changed after it started
# (scripts/resource-pulse-service-refresh.sh): a restart resets the histories,
# so a deploy that leaves the data side alone keeps them.
#
# ExecStart runs the checkout at ~/.dotfiles, because that checkout IS the
# deployment (CLAUDE.md, "The checkout IS the deployment").
#
# A CRASH LOOP ENDS IN `failed`. Restart=on-failure restarts a crash after 5 s,
# and the start limit in [Unit] stops that after 5 starts in 300 s, so a service
# that always crashes costs a few runs, then sits failed where
# `systemctl --user --failed` shows it. Without the limit it would never get
# there: one start per 5 s never reaches systemd's default of 5 in 10 s. Then
# nothing starts it until the extension's next enable() (after a lock, a blank or
# a login): the extension's start retries end once the service has appeared on
# the bus, so they never revive one that ran and then failed. That enable()'s
# StartUnit starts it again once the 300 s window has passed; inside the window
# the start limit keeps systemd from running it, so that one chain retries after
# 5 s, 30 s, then every 5 min until the service appears.
#
# Watch it:  journalctl --user -u resource-pulse.service -e
#
# Comments must be on their own lines: systemd treats text after a value as part
# of the value.

[Unit]
Description=Resource Pulse sampler: CPU, memory and app use for the GNOME Shell extension
# Stops at logout, with the session it serves.
PartOf=graphical-session.target
# IN [Unit], NOT [Service]: in [Service] systemd ignores StartLimitIntervalSec
# (see systemd/vpn-notify.service). At most 5 starts in 300 s; see the header.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# Ready once it owns its bus name. service/main.js exports its object before it
# asks for the name, so a client that sees the name can call it at once.
Type=dbus
BusName=io.github.quantivly.dotfiles.ResourcePulse1
ExecStart=/usr/bin/gjs -m %h/.dotfiles/gnome-shell/extensions/resource-pulse@dotfiles/service/main.js
# A crash restarts it; a clean exit (a stop, SIGTERM) stays stopped.
Restart=on-failure
RestartSec=5
# In background.slice it is scanned like any app, and shows in "heaviest" when
# it is the heaviest, which is honest.
Slice=background.slice
# Not idle scheduling: it must keep sampling in the "why is it slow?" moment.
Nice=10
# Hard caps, so a bug costs at most a tenth of a core and 128 MiB.
CPUQuota=10%
MemoryHigh=96M
MemoryMax=128M
