# systemd/scrub-transcript-secrets.service
# ========================================
# Removes credentials from Claude Code transcripts on disk, unattended.
#
# WHY A TIMER AND NOT PREVENTION. The leak source is a program logging its own
# environment into the transcript. claude/hooks/secret-emission-guard.sh is a
# PreToolUse hook on Bash: it can refuse a COMMAND that would print a secret, and
# it cannot observe a program's own file write at all. So the emission this
# guards against is outside every preventive control this repo has, and periodic
# scrubbing is what is left — the same shape of argument
# systemd/wt-gc-sweep.timer's header makes for worktrees.
#
# The audit that produced it: 154 of 2,344 transcripts carrying live credentials,
# 521 occurrences, 2026-09-23. docs/TRANSCRIPT_SCRUB.md.
#
# WHAT IT ACTUALLY RUNS is scripts/scrub-transcript-secrets.py, which holds the
# rules, the roots and the exit-status contract, and whose header explains each.
#
# CONDITIONPATHEXISTS, NOT A FAILURE. A machine running these dotfiles without
# Claude Code has no ~/.claude/projects. An unmet ConditionPathExists makes
# systemd SKIP the unit, and a skipped unit is not a failed one — no error,
# nothing in `--state=failed`. That is the right answer for a machine this does
# not apply to. It is also why the script itself exits 2 rather than 0 when it
# finds no root: "0 credentials found" and "I never looked" must not be the same
# sentence, and only one of the two is systemd's to decide.
#
# LINKED BUT NOT ENABLED, deliberately. ./install symlinks this unit; it does not
# start it. This rewrites session transcripts unattended — the same act the
# Claude Code permission classifier refuses an agent outright — so arming it is a
# gate Zvi runs by hand, after reading one real dry run:
#   scripts/scrub-transcript-secrets.py --dry-run
#   systemctl --user daemon-reload
#   systemctl --user enable --now scrub-transcript-secrets.timer
# Never `systemctl --user reenable` — its disable half deletes the dotbot symlink
# that IS the unit. See systemd/herdr-server.service's [Install] note.
#
# A SKIPPED TRANSCRIPT IS NOT A FAILED RUN. The script refuses to rewrite a file
# that changed between its read and its write, because doing so drops whatever a
# live session appended in between. A 03:00 run still meets live sessions, so
# skips are routine, exit 0, and are caught by the next run — the tool is
# idempotent and a second pass over a scrubbed file is a byte-for-byte no-op.
#
# Watch it:  journalctl --user -u scrub-transcript-secrets.service -e
# Audit it:  ~/.local/state/scrub-transcript-secrets/log

[Unit]
Description=Scrub credentials out of Claude Code transcripts
Documentation=file://%h/.dotfiles/scripts/scrub-transcript-secrets.py
ConditionPathExists=%h/.claude/projects

[Service]
Type=oneshot
# Explicit, because a user unit inherits systemd's PATH rather than a login
# shell's. Only two binaries are needed and both are in /usr/bin: python3, and
# `shred` — which is load-bearing, not incidental. Every backup the script takes
# is a second copy of the same credentials, so it refuses to write at all when
# shred is absent (exit 2) rather than leaving one behind.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.dotfiles/scripts/scrub-transcript-secrets.py --apply
Nice=10
IOSchedulingClass=idle
# The run is pure local I/O — no network at any point — over roughly 4 GB of
# transcripts, measured at seconds rather than minutes. The cap exists so a
# pathological corpus cannot block every later run: Type=oneshot has no start
# timeout by default, and the timer will not fire while the last run is active.
TimeoutStartSec=15min

[Install]
# default.target, not graphical-session.target: this needs no session
# environment, only files under $HOME. Linger=yes on this account brings the user
# manager up at boot, so it runs across logout.
#
# CHANGING THIS FIELD DOES NOT MOVE AN EXISTING SYMLINK — run ./install.
WantedBy=default.target
