#!/usr/bin/env bash

set -e

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

# --herdr: install ONLY the herdr layer (DO-555). The full config links 18
# destinations including ~/.zshrc, ~/.gitconfig, ~/.tmux.conf and VS Code's
# settings.json; adopting herdr should not require handing all of that over.
# Parsed out of "$@" here because everything left in "$@" is forwarded to dotbot,
# which would reject an unknown flag.
HERDR_ONLY=0
_args=()
for _a in "$@"; do
    case "$_a" in
        --herdr) HERDR_ONLY=1 ;;
        *)       _args+=("$_a") ;;
    esac
done
set -- ${_args+"${_args[@]}"}
if (( HERDR_ONLY )); then
    CONFIG="install.conf.herdr.yaml"

    # The unit's ExecStart is the ABSOLUTE %h/.dotfiles/scripts/herdr-server-launch.sh.
    # Linked from any other checkout it is a unit that fails at start with 203/EXEC —
    # a status nobody reads, which is the failure mode this whole setup is written
    # against. An earlier version of this printed a warning AFTER dotbot had already
    # created the link and exited 0; the warning then scrolled away behind the
    # dependency report and the next-steps block, so it warned nobody. Refuse here,
    # before anything is linked, or the refusal is theatre.
    if [[ "${BASEDIR}" != "${HOME}/.dotfiles" && -z "${HERDR_ALLOW_FOREIGN_CHECKOUT:-}" ]]; then
        cat >&2 <<EOF
✗ Refusing --herdr from ${BASEDIR}.

  systemd/herdr-server.service runs ${HOME}/.dotfiles/scripts/herdr-server-launch.sh,
  an absolute path baked into the unit. Installed from here, that file does not
  exist and the unit fails at start with 203/EXEC — reported nowhere you will look.

  Clone to ~/.dotfiles instead:
    git clone https://github.com/quantivly/dotfiles.git ~/.dotfiles
    cd ~/.dotfiles && ./install --herdr

  To link everything EXCEPT a working unit anyway (macOS has no systemd, and a
  sandbox/CI run does not need one):
    HERDR_ALLOW_FOREIGN_CHECKOUT=1 ./install --herdr
EOF
        exit 1
    fi
fi


# This repo installs itself with dotbot `link:`, so every managed file becomes a
# SYMLINK into ${BASEDIR}. Run from a git worktree, install therefore re-points
# the entire live config — ~/.zshrc, ~/.gitconfig, ~/.config/git/ignore, the gh
# account configs — at a feature branch, and nothing afterwards says so:
# `git status` in the primary checkout stays clean, dotfiles-doctor's branch and
# drift checks read that checkout, and only `readlink` reveals where the live
# files actually come from. (dotfiles-doctor's link-integrity check does now flag
# it, but only if someone runs it.)
#
# git's own definition of a linked worktree is that its git-dir differs from its
# git-common-dir, and that is the test used here. `[[ -f .git ]]` is NOT that
# test: a --separate-git-dir clone and a submodule also have a .git FILE, and
# both are perfectly ordinary places to install from — they got this refusal on
# every run, with only an env var framed as "deploy this worktree" to escape it.
# Two empty answers (no git, or no repo) mean no evidence, so no refusal.
git_dir="$(git -C "${BASEDIR}" rev-parse --git-dir 2>/dev/null || true)"
git_common_dir="$(git -C "${BASEDIR}" rev-parse --git-common-dir 2>/dev/null || true)"
if [[ -n "${git_dir}" && -n "${git_common_dir}" && "${git_dir}" != "${git_common_dir}" ]] \
   && [[ -z "${DOTFILES_ALLOW_WORKTREE_INSTALL:-}" ]]; then
    cat >&2 <<EOF
✗ Refusing to install from a git worktree.

  ${BASEDIR} is a worktree, so linking from here would point your live config
  (~/.zshrc, ~/.gitconfig, ...) at this branch instead of the primary checkout —
  silently, and with a clean 'git status' either side.

  Install from the primary checkout instead:
    cd ~/.dotfiles && ./install

  If you really do mean to deploy this worktree:
    DOTFILES_ALLOW_WORKTREE_INSTALL=1 ./install
EOF
    exit 1
fi

git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DOTBOT_DIR}"

"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"

if (( HERDR_ONLY )); then
    echo ""
    echo "==> herdr-only install complete."

    # Only reachable via HERDR_ALLOW_FOREIGN_CHECKOUT — the gate above exits
    # otherwise. Restated here because the override is precisely the case where
    # the unit is knowingly broken, and step 3 below still tells you to enable it.
    launcher="${HOME}/.dotfiles/scripts/herdr-server-launch.sh"
    if [[ ! -x "$launcher" ]]; then
        echo ""
        echo "    ⚠ HERDR_ALLOW_FOREIGN_CHECKOUT is set and ${launcher} does not exist."
        echo "      The unit was linked but CANNOT start. Skip step 3's systemctl lines,"
        echo "      or edit ExecStart in ~/.config/systemd/user/herdr-server.service."
    fi

    # NOT `|| true`: herdr, jq, git, zsh and python3 are REQUIRED, and swallowing
    # that status made `--herdr` exit 0 on a machine where the next steps cannot
    # work. The links are already made and are still correct, so keep printing the
    # next steps -- but carry the status out, so a scripted install can see it.
    deps_rc=0
    bash "${BASEDIR}/scripts/herdr-deps-check.sh" || deps_rc=$?

    cat <<NEXT
  Three things this installer cannot do for you. Each fails silently.

  1. Shell layer — add to your own shell rc (~/.zshrc, ~/.zshrc.local, ...):

       [ -f ${BASEDIR}/zsh/zshrc.herdr ] && source ${BASEDIR}/zsh/zshrc.herdr

     Gives you hspawn / hdespawn / hreap (your AGENTS drive these), plus the
     'claude' team-lead wrapper and 'herdr-lazy'. Nothing else from this repo.

  2. Status line — add to ~/.claude/settings.json exactly as printed:

       "statusLine": {
         "type": "command",
         "command": "bash '${HOME}/.claude/hooks/session-statusline.sh'",
         "refreshInterval": 60
       }

     Without it every sidebar row renders empty and nothing reports why.

  3. Plugins and the server:

       herdr plugin install natori-hrj/herdr-lazy
       herdr-lazy install
       herdr plugin link ${BASEDIR}/config/herdr/plugins/local/sidebar-icons
       systemctl --user daemon-reload
       systemctl --user enable --now herdr-server.service

  Then prove it the way the SERVER sees it:

       ${BASEDIR}/scripts/verify-tools.sh

NEXT
    if (( deps_rc != 0 )); then
        echo "  ⚠ The links are in place, but a REQUIRED dependency above is missing."
        echo "    The steps you were just given will not work until it is installed."
        echo ""
    fi
    exit "$deps_rc"
fi

# Check if mise tools are configured
if command -v mise &> /dev/null || [[ -x "$HOME/.local/bin/mise" ]]; then
    echo ""
    echo "==> Configuring mise CLI tools..."

    # Symlink unified mise configuration from dotfiles
    # Using symlink instead of copy to maintain single source of truth
    if [[ -f "${BASEDIR}/.mise.toml" ]]; then
        mkdir -p "$HOME/.config/mise"

        mise_config="$HOME/.config/mise/config.toml"
        dotfiles_mise="${BASEDIR}/.mise.toml"

        # Check if config.toml exists and is not a symlink
        if [[ -f "$mise_config" ]] && [[ ! -L "$mise_config" ]]; then
            # Existing file that's not a symlink
            if diff -q "$dotfiles_mise" "$mise_config" &>/dev/null; then
                # Files are identical, safe to replace with symlink
                rm "$mise_config"
                ln -s "$dotfiles_mise" "$mise_config"
                echo "    ✓ Replaced mise config with symlink (files were identical)"
            else
                # Files differ - preserve user changes
                echo "    ⚠️  mise config exists with local changes"
                echo "      Current: $mise_config"
                echo "      Dotfiles: $dotfiles_mise"
                echo "      Keeping your version (not replacing with symlink)"
                echo "      To use dotfiles version: rm $mise_config && ln -s $dotfiles_mise $mise_config"
            fi
        elif [[ -L "$mise_config" ]]; then
            # Already a symlink - check if broken or pointing elsewhere
            if [[ ! -e "$mise_config" ]]; then
                # Broken symlink (target doesn't exist)
                echo "    ⚠️  Broken symlink detected, recreating..."
                ln -sf "$dotfiles_mise" "$mise_config"
                echo "    ✓ Fixed broken symlink to dotfiles"
            else
                # Valid symlink - check target
                current_target=$(readlink "$mise_config")
                if [[ "$current_target" == "$dotfiles_mise" ]]; then
                    echo "    ✓ mise config already symlinked to dotfiles"
                else
                    echo "    ℹ mise config symlinked to: $current_target"
                    echo "      To use dotfiles version: ln -sf $dotfiles_mise $mise_config"
                fi
            fi
        else
            # No config exists yet, create symlink
            ln -s "$dotfiles_mise" "$mise_config"
            echo "    ✓ Installed mise configuration (symlinked to dotfiles)"
        fi

        # Inform about local overrides
        echo "    ℹ For personal tool overrides: create ~/.config/mise/config.local.toml"
    fi

    # Activate mise for current shell to make tools available immediately
    if command -v mise &> /dev/null; then
        if ! eval "$(mise activate bash 2>/dev/null)"; then
            if ! eval "$(mise activate zsh 2>/dev/null)"; then
                echo "    ⚠️  Warning: mise activation failed. Tools may not be available."
                echo "       This is normal if mise hasn't been configured yet."
            fi
        fi
    elif [[ -x "$HOME/.local/bin/mise" ]]; then
        if ! eval "$("$HOME/.local/bin/mise" activate bash 2>/dev/null)"; then
            if ! eval "$("$HOME/.local/bin/mise" activate zsh 2>/dev/null)"; then
                echo "    ⚠️  Warning: mise activation failed. Tools may not be available."
                echo "       Run: mise install"
            fi
        fi
    fi

    if [[ -f "$HOME/.config/mise/config.toml" ]] || [[ -L "$HOME/.config/mise/config.toml" ]]; then
        # Trust the mise configuration (security requirement)
        echo "    Trusting mise configuration..."
        if command -v mise &> /dev/null; then
            mise trust "$BASEDIR/.mise.toml" 2>/dev/null || true
        elif [[ -x "$HOME/.local/bin/mise" ]]; then
            "$HOME/.local/bin/mise" trust "$BASEDIR/.mise.toml" 2>/dev/null || true
        fi

        echo "    Installing/updating CLI tools..."

        # Capture mise install output for detailed error reporting
        if MISE_OUTPUT=$(mise install 2>&1); then
            # Show what was actually installed/updated if available
            if echo "$MISE_OUTPUT" | grep -qE "installing|updating|installed|✓"; then
                echo "    ✓ CLI tools installed/updated:"
                echo "$MISE_OUTPUT" | grep -E "installing|updating|installed|✓" | sed 's/^/      /'
            else
                echo "    ✓ All CLI tools already up to date"
            fi
            echo "    ℹ Tools available in current shell after activation"
        else
            echo "    ⚠ Some tools failed to install"
            echo ""

            # Show specific failures
            if echo "$MISE_OUTPUT" | grep -qi "error\|fail"; then
                echo "    Failed installations:"
                echo "$MISE_OUTPUT" | grep -i "error\|fail" | sed 's/^/      • /'
                echo ""
            fi

            echo "    Troubleshooting:"
            echo "      • Check details: mise doctor"
            echo "      • Retry installation: mise install"
            echo "      • Check specific tool: mise install <tool>"
            echo ""

            # Verify critical tools are available
            missing_tools=()
            for tool in bat fd eza delta zoxide; do
                if ! command -v "$tool" &>/dev/null; then
                    missing_tools+=("$tool")
                fi
            done

            if [[ ${#missing_tools[@]} -gt 0 ]]; then
                echo "    ⚠ Critical tools missing: ${missing_tools[*]}"
                echo "      These are required for optimal shell experience"
            fi
        fi
    else
        echo "    ℹ No mise config found"
        echo "      Expected: ~/.config/mise/config.toml (symlinked from dotfiles)"
        echo "      Dotfiles version: ~/.dotfiles/.mise.toml"
    fi
else
    echo ""
    echo "==> mise not installed"
    echo "    Install mise via dev-setup or: curl https://mise.run | sh"
fi

# Install pre-commit hooks with user consent
if [[ -f "${BASEDIR}/.pre-commit-config.yaml" ]]; then
    echo ""
    echo "==> Pre-commit hooks available"

    if command -v pre-commit &> /dev/null; then
        echo "    Pre-commit hooks run before each commit to:"
        echo "    • Check for security issues (gitleaks)"
        echo "    • Validate shell scripts (shellcheck)"
        echo "    • Format code consistently"
        echo ""
        echo "    Note: Hooks download dependencies from remote repositories"
        echo ""

        # Check if running in CI or non-interactive environment
        if [[ -t 0 ]] && [[ -z "${CI:-}" ]]; then
            # Interactive environment - ask for consent
            read -p "    Install pre-commit hooks? (Y/n): " -n 1 -r
            echo

            if [[ $REPLY =~ ^[Yy]$ ]] || [[ -z $REPLY ]]; then
                # Install hooks with --install-hooks to download hook dependencies
                echo "    Installing pre-commit hooks..."
                if pre-commit install --install-hooks 2>&1 | sed 's/^/      /'; then
                    echo "    ✓ Pre-commit hooks installed successfully"
                    echo "    ℹ Hooks will run automatically before each commit"
                else
                    echo "    ⚠ Pre-commit hook installation failed"
                    echo "      Manual installation: pre-commit install --install-hooks"
                fi
            else
                echo "    ℹ Skipped pre-commit hooks installation"
                echo "      Install later with: pre-commit install --install-hooks"
            fi
        else
            # Non-interactive or CI - skip with message
            echo "    ℹ Non-interactive environment detected"
            echo "      Skipping pre-commit hooks installation"
            echo "      Install later with: pre-commit install --install-hooks"
        fi
    else
        echo "    ℹ pre-commit not found"
        echo "      Install via mise: mise use -g pre-commit@latest"
        echo "      Or install directly: pip install pre-commit"
    fi
fi

# Forgit installation (optional git + fzf integration)
echo ""
echo "📦 Setting up forgit (interactive git with fzf)..."
if [ -d "$HOME/.forgit" ]; then
    echo "    ℹ Forgit already installed at ~/.forgit"
    # Check if it's a git repo and can be updated
    if [ -d "$HOME/.forgit/.git" ]; then
        echo "    🔄 Checking for updates..."
        if git -C "$HOME/.forgit" pull --quiet 2>/dev/null; then
            echo "    ✓ Forgit updated to latest version"
        else
            echo "    ⚠ Could not update forgit (may need manual intervention)"
        fi
    fi
else
    echo "    📥 Installing forgit..."
    if git clone --quiet https://github.com/wfxr/forgit.git "$HOME/.forgit" 2>/dev/null; then
        echo "    ✓ Forgit installed successfully"
        echo "    ℹ Forgit provides fuzzy git commands: gfa, gfco, gfcf, gfstash, etc."
    else
        echo "    ⚠ Forgit installation failed (optional feature)"
        echo "      Manual installation: git clone https://github.com/wfxr/forgit.git ~/.forgit"
    fi
fi
