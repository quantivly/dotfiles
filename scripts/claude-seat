#!/usr/bin/env zsh
#
# scripts/claude-seat
# ===================
#
# ADD A CLAUDE SEAT TO A TENANT'S POOL in one command (DO-796). The procedure it
# replaces, docs/CLAUDE_ACCOUNT_MCP.md §5 "Adding an account to the pool", was
# seven manual steps, three of which failed silently when skipped. Adding one
# seat on 2026-09-30 took a whole session.
#
# The order is the point. The pool is the LAST thing touched, so the pool never
# names a seat that failed a check:
#
#   preflight  the tenant has a pool, its members agree on the settings a move
#              compares, and the name has never existed anywhere (profiles,
#              account dirs including compat links and retired dirs, every tenant
#              table, rabota's seats, the picker's ledger) and fits rabota's
#              per-tenant prefix rule;
#   login      `clauth login <name>`, the one human step, skipped if done;
#   distinct   the new account id repeats no other profile's;
#   settings   the pool's config.toml is copied in. clauth writes an all-commented
#              template, and every in-place `clauth switch <sid>` between seats
#              with different [models] is refused in the daemon's journal only;
#   dir        the account dir is built, its credential a link into the store;
#   identity   the account dir names the account the login recorded (it was
#              seeded from ~/.claude.json, which names another), and its type and
#              organisation match every pool member's: a login that went to the
#              browser's claude.ai account looks exactly like a good one until
#              this check;
#   pool       claude-tenants-edit adds it, committing the tenants file alone.
#
# Every step checks the state first and skips what is done, so a run that stops
# can be run again with the same name. Without a name, a seat a run started and
# did not finish is refused rather than proposed past: a second login of the same
# person under the next number is the mistake that would follow.
#
# `claude-seat mcp <name>` is the step after it (DO-797): it signs the seat in to
# each plugin MCP server another member of its pools uses, or re-authorises one of
# its own that is damaged, through Claude Code's own `claude mcp login`.
#
# `claude-seat retire <name>` is the inverse (DO-798): out of every pool, then,
# once no session holds it, its plugin sign-ins logged out, its account dir made a
# tombstone and its name recorded as retired, so it is never reused.
#
# `claude-seat browser <tenant>` (DO-799) opens a browser profile kept for one
# tenant, for the two steps that go to whichever account a browser is signed in
# to: the seat's `clauth login`, and its claude.ai connectors, whose Google side
# must be the TENANT's identity.
#
# Usage:
#   claude-seat add [--dry-run] [--yes] [--email ADDR] <tenant> [name]
#   claude-seat mcp [--dry-run] [--no-browser] <name>
#   claude-seat retire [--plan] [--reason TEXT] <name>
#   claude-seat browser [--dry-run] <tenant>
#
#   name          default: the tenant's prefix and the next number never used
#   --dry-run     check and print the plan; touch nothing
#   --yes         allow the one-request first launch the identity step may need
#   --email       the address the seat must have; refused if it differs
#   --no-browser  print each sign-in URL instead of opening it (needs a terminal)
#   --plan        list every place the name appears and what would happen; change nothing
#   --reason      what the retired-names table records (default: the date and this command)
#
# Exit (add): 0 added (or dry run passed) · 1 refused: the request does not fit,
#       and nothing was added to the pool · 2 could not finish safely, and nothing
#       was added to the pool · 3 the seat IS in the pool, but a check after the
#       edit failed (the message says which) · 64 usage.
# Exit (mcp): 0 signed in to every plugin server its pools use (or dry run
#       passed) · 1 refused · 2 a sign-in failed or did not take, or an input
#       could not be read · 64 usage.
# Exit (retire): 0 retired (or already retired) · 1 refused: something this does
#       not edit still names the seat · 2 could not finish safely, or an input
#       could not be read · 3 it may still be in use, so nothing that cannot be
#       redone was done; move its sessions and run it again · 64 usage. A --plan
#       exits with the code the real run would stop at.
# Exit (browser): 0 opened (or the dry run printed) · 1 refused: the tenant's name
#       is not a directory name, or the tenants file does not declare it · 2 no
#       browser to open (or only a snap one), the profile dir is not safe or could
#       not be made, the launch failed, or an input could not be read · 64 usage.

emulate -R zsh
setopt no_unset pipe_fail extended_glob
zmodload zsh/mapfile 2>/dev/null

prog=claude-seat
here="${0:A:h}"
EDIT="${CLAUDE_SEAT_TENANTS_EDIT:-$here/claude-tenants-edit}"
ACCDIRS="${CLAUDE_SEAT_ACCOUNT_DIRS:-$here/claude-account-dirs.sh}"
PICK="${CLAUDE_SEAT_PICK:-$here/claude-pick}"
CLAUDE_SH="${CLAUDE_SEAT_CLAUDE_SH:-$here/../zsh/functions/claude.sh}"
CLAUTH="${CLAUDE_SEAT_CLAUTH:-clauth}"
CLAUDE_BIN="${CLAUDE_SEAT_CLAUDE:-claude}"
TENANTS="${CLAUDE_TENANTS_FILE:-$HOME/.config/claude-tenants.zsh}"
PROFILES="$HOME/.clauth/profiles"
ADROOT="${CLAUDE_ACCOUNT_DIRS_ROOT:-$HOME/.local/state/claude-account-dirs}"
RABOTA="${CLAUDE_SEAT_RABOTA_DIR:-$HOME/.dotfiles-local/rabota}"
RABOTA_BUDGET="${CLAUDE_SEAT_RABOTA_BUDGET:-$here/../rabota/rabota/budget.py}"
SEAT_STATE="${CLAUDE_SEAT_STATE:-$HOME/.local/state/claude-seat}"
SEP=$'\x1f'
# rabota's seat rule (rabota/rabota/budget.py: WORK_TENANT, WORK_PREFIX): a lane
# refuses a work-tenant seat outside quantivly-*, and any other tenant's inside it.
WORK_TENANT=quantivly
WORK_PREFIX=quantivly-

usage() {
  print -u2 -- "usage: $prog add [--dry-run] [--yes] [--email ADDR] <tenant> [name]"
  print -u2 -- "       $prog mcp [--dry-run] [--no-browser] <name>"
  print -u2 -- "       $prog retire [--plan] [--reason TEXT] <name>"
  print -u2 -- "       $prog browser [--dry-run] <tenant>"
  exit 64
}
say()    { print -r -- "$*" }
step()   { print -r -- ""; print -r -- "[$1] $2" }
# `add` never touches the pool before its last step, so every refusal says so.
trailer="Nothing was added to the pool."
refuse() { print -u2 -- "$prog: refused: $*"; [[ -z "$trailer" ]] || print -u2 -- "    $trailer"; exit 1 }
fail()   { print -u2 -- "$prog: $*"; [[ -z "$trailer" ]] || print -u2 -- "    $trailer"; exit 2 }
# The last lines of a command's error output, through the repo's redactor: never
# printed raw, because what claude prints on failure is not ours to vouch for.
tail_redacted() {
  local r="$here/redact-secrets.sh"
  [[ -x "$r" ]] || { print -r -- "(output withheld: cannot find $r)"; return }
  print -r -- "$1" | command tail -n 3 | "$r"
}
# A name that exists only as a clauth profile and/or an account dir: a run that
# stopped part-way, and nothing else.
unfinished_where() { [[ "${1//(a clauth profile|an account dir)/}" == (|, |, , ) ]] }
# A profile's account id (clauth's anchor, the same value as the accountUuid in an
# account dir's .claude.json), or nothing.
id_of() { [[ -r "$1" ]] && print -r -- "${${mapfile[$1]-}//[[:space:]\"]/}" }

# rabota's seats, into rseat (name -> where): each tenant TOML's `[seats] local`,
# in every spelling tomllib reads (`local = "x"`, `local = 'x'`, `seats.local =
# ...`, `seats = { local = ... }`, `"local" = ...`). A commented-out line matches
# too; refusing one
# name too many is the safe direction. A file it cannot read is a failure, never
# empty. (`${mapfile[f]-}`: an empty file is UNSET to mapfile, which no_unset makes
# fatal.) Filled in place rather than printed, so `fail` exits the script and not
# a command substitution's subshell.
typeset -A rseat cseat
rabota_seats() {
  local f l
  for f in "$RABOTA"/tenants/*.toml(N); do
    [[ -r "$f" ]] || fail "cannot read $f, which may name a seat"
    for l in "${(@f)mapfile[$f]-}"; do
      [[ "$l" == (#b)(|*[^A-Za-z0-9_-])[\"\']#local[\"\']#[[:space:]]#=[[:space:]]#[\"\']##([^\"\']##)[\"\']* ]] && \
        rseat[$match[2]]="rabota's seat in ${f:t}"
    done
  done
}
# rabota's console seats, into cseat: CONSOLE_SEATS in budget.py, which no lane
# ever runs on (DO-805 moves it into data). A file it cannot read, or one without
# that line, is a failure: the seat could be named there.
console_seats() {
  local l rest found=0 inside=0
  [[ -r "$RABOTA_BUDGET" ]] || fail "cannot read ${RABOTA_BUDGET/#$HOME/~}, whose CONSOLE_SEATS may name the seat"
  for l in "${(@f)mapfile[$RABOTA_BUDGET]-}"; do
    # Only the value counts: an annotation before the `=` (`tuple[str, ...]`) and
    # a comment after a `#` both hold brackets that would close it early.
    if (( ! inside )); then
      [[ "$l" == [[:space:]]#CONSOLE_SEATS[[:space:]]#(:[^=]#|)=* ]] || continue
      found=1 inside=1
      rest="${${l#*=}%%\#*}"
      # A value that opens no bracket is one line long.
      [[ "$rest" == *[\(\[]* ]] || inside=0
    else
      rest="${l%%\#*}"
    fi
    [[ "$rest" == *[\)\]]* ]] && inside=0
    while [[ "$rest" == (#b)[^\"\']#[\"\']([^\"\']##)[\"\'](*) ]]; do
      cseat[$match[1]]=1
      rest="$match[2]"
    done
  done
  (( found )) || fail "found no CONSOLE_SEATS line in ${RABOTA_BUDGET/#$HOME/~}; its format changed, so the console seat is unknown"
}
# The editor's flags for a tenants-file edit: --commit when the file is tracked in
# git, committed alone. A file that already carries a hand edit makes the editor
# refuse, so that is found out here, before anything else is done.
editor_flags() {
  eflags=()
  real="${TENANTS:A}"
  if top="$(command git -C "${real:h}" rev-parse --show-toplevel 2>/dev/null)" && \
     command git -C "$top" ls-files --error-unmatch -- "$real" >/dev/null 2>&1; then
    eflags=( --commit )
    dirty="$(command git -C "$top" status --porcelain -- "$real" 2>/dev/null)" || \
      fail "could not ask git whether $real has uncommitted changes"
    [[ -z "$dirty" ]] || \
      fail "$real has uncommitted changes; commit or discard them first, so the pool edit can be committed alone"
  fi
}

# ---- arguments --------------------------------------------------------------------
cmd="${1:-}"
[[ "$cmd" == (add|mcp|retire|browser) ]] || usage
shift
dry=0 yes=0 email="" nobrowser=0 reason=""
typeset -a pos
while (( $# )); do
  case "$1" in
    --dry-run)    dry=1 ;;
    --yes)        [[ "$cmd" == add ]] || usage; yes=1 ;;
    --email)      [[ "$cmd" == add && -n "${2:-}" && "$2" != -* ]] || usage; email="$2"; shift ;;
    --no-browser) [[ "$cmd" == mcp ]] || usage; nobrowser=1 ;;
    --plan)       [[ "$cmd" == retire ]] || usage; dry=1 ;;
    --reason)     [[ "$cmd" == retire && -n "${2:-}" && "$2" != -* ]] || usage; reason="$2"; shift ;;
    --*)          usage ;;
    -*)           usage ;;
    *)            pos+=( "$1" ) ;;
  esac
  shift
done
if [[ "$cmd" == add ]]; then
  (( ${#pos} == 1 || ${#pos} == 2 )) || usage
  tenant="${pos[1]}"
  name="${pos[2]-}"
  [[ -z "${tenant//[A-Za-z0-9_.-]/}" ]] || refuse "tenant '$tenant' may only contain letters, digits, - _ and ."
elif [[ "$cmd" == browser ]]; then
  (( ${#pos} == 1 )) || usage
  tenant="${pos[1]}" name="" trailer=""
  # It becomes a directory name: add's rule, and not `.` or `..`.
  [[ "$tenant" == [A-Za-z0-9_]* && -z "${tenant//[A-Za-z0-9_.-]/}" ]] || \
    refuse "tenant '$tenant' may only contain letters, digits, - _ and ., and must not start with a dot"
else
  (( ${#pos} == 1 )) || usage
  tenant="" name="${pos[1]}" trailer=""
  # The editor's own rule for a retire reason, checked before anything is changed
  # rather than at the record step, after the pool edit.
  [[ "$reason" != *[\"\$\`\\]* && "$reason" != *[[:cntrl:]]* ]] || \
    refuse "the reason may not contain a double quote, \$, a backtick, a backslash or a control character"
  [[ "$name" == [A-Za-z0-9]* && -z "${name//[A-Za-z0-9_.-]/}" ]] || \
    refuse "'$name' may only contain letters, digits, - _ and ., and must start with a letter or digit"
fi

for t in "$EDIT" "$ACCDIRS" "$CLAUDE_SH" "$PICK"; do
  [[ -r "$t" ]] || fail "cannot find $t, which this needs"
done

# ---- the tenant table, read ONCE, through the editor's reader ------------------------
# One reader of the tenants file, not two: the editor's `dump` is the launch's
# read (bare zsh -f, every table declared, any stderr a fault).
if ! dumpout="$(command zsh "$EDIT" dump 2>&1)"; then
  fail "cannot read the tenants file: $dumpout"
fi
typeset -A pool ovf spill mid retired connectors cacct
for line in "${(@f)dumpout}"; do
  [[ -n "$line" ]] || continue
  tab="${line%%$SEP*}"; rest="${line#*$SEP}"; k="${rest%%$SEP*}"; v="${rest#*$SEP}"
  case "$tab" in
    POOL)              pool[$k]="$v" ;;
    OVERFLOW)          ovf[$k]="$v" ;;
    SPILL)             spill[$k]="$v" ;;
    MACHINE_ID)        mid[$k]="$v" ;;
    RETIRED)           retired[$k]="$v" ;;
    CONNECTORS)        connectors[$k]="$v" ;;
    CONNECTOR_ACCOUNT) cacct[$k]="$v" ;;
  esac
done

if [[ "$cmd" == add ]]; then
  (( ${+pool[$tenant]} )) || refuse "tenant '$tenant' has no pool in the tenants file; give it one by hand first"
fi

# The settings a move compares, normalised, from claude.sh's own reader. The same
# keys and defaults as claude-doctor's parity check (clauth v0.16.0 swap_eligible).
source "$CLAUDE_SH" >/dev/null 2>&1
for f in _claude_toml_flat _claude_seat_cred_file _claude_mcp_plugin_states _claude_plugins_disabled \
         _claude_pool_member_problem _claude_proc_config_dirs _claude_proc_root _claude_active_profile \
         _claude_global_cred_file _claude_cred_owner _claude_cred_id; do
  (( $+functions[$f] )) || fail "$CLAUDE_SH does not define $f"
done
swapkeys() {   # $1 = config.toml -> sorted "key=value" lines a move compares
  local kv k v
  local -a out
  for kv in "${(@f)$(_claude_toml_flat "$1")}"; do
    [[ -n "$kv" ]] || continue
    k="${kv%%$'\t'*}"; v="${kv#*$'\t'}"
    [[ "$k" == api_key ]] && v=set
    [[ "$v" == <->.0 ]] && v="${v%.0}"
    case "$k" in
      base_url|api_key|env|env.*|models|models.*) out+=( "$k=$v" ) ;;
      disabled) [[ "$v" == false ]] || out+=( "$k=$v" ) ;;
    esac
  done
  out=( "${(@o)out}" )
  print -r -- "${(F)out}"
}
effective() { _claude_toml_flat "$1" }

# ---- mcp: sign a seat in to its pools' plugin MCP servers (DO-797) -------------------------
# The yardstick is the doctor's (DO-794), read with the doctor's own helpers: a
# plugin server signed in on ANY other member of a pool the seat is in is expected
# on the seat, a damaged entry of its own is re-authorised, and a disabled plugin
# is neither. Each sign-in is `claude mcp login`, Claude Code's own OAuth flow in
# the seat's config dir. An entry is NEVER copied from another seat: a copy is a
# second holder of one rotating refresh chain. One at a time, because Slack's
# plugin listens on a fixed callback port.
seat_mcp() {
  local ad="$ADROOT/$name" seatf t m f k out kv srv st sf
  local -a pools targets lflags notok stale
  local -A want have why poff seen
  for t in ${(k)pool}; do
    (( ${${=pool[$t]}[(Ie)$name]} )) && pools+=( "$t" )
  done
  (( ${#pools} )) || refuse "'$name' is in no pool, so no other seat says which plugin servers it needs"
  pools=( "${(@o)pools}" )
  # The doctor's member rules. A compat symlink's dir is ANOTHER profile's, so a
  # sign-in there would land on that profile.
  case "$(_claude_pool_member_problem "$ADROOT" "$PROFILES" "$name")" in
    compat)  refuse "'$name' is a compat symlink in the account root; its dir is another profile's, so name that profile instead" ;;
    retired) refuse "'$name' is a retired name" ;;
    # Not `claude-seat add`: it refuses a name already in a pool.
    nostore) refuse "'$name' has no clauth profile store: 'clauth login $name' if it should exist, otherwise take it out of the pool (claude-tenants-edit --commit pool-remove ${pools[1]} $name)" ;;
  esac
  [[ -e "$ad/.credentials.json" || -L "$ad/.credentials.json" ]] || \
    refuse "'$name' has no account dir with a credential (${ad/#$HOME/~}); build it: scripts/claude-account-dirs.sh $name"
  # The doctor reads an unreadable settings file as "nothing disabled", which costs
  # it at most a warning. Here it would cost a real sign-in to a plugin switched off.
  sf="$(_claude_global_settings_file)"
  if [[ -e "$sf" || -L "$sf" ]]; then
    jq -e 'type == "object" and ((.enabledPlugins // {}) | type == "object")' "$sf" >/dev/null 2>&1 || \
      fail "cannot read which plugins are enabled in ${sf/#$HOME/~}, so one switched off could be signed in to"
  fi
  for k in ${(f)"$(_claude_plugins_disabled)"}; do
    [[ -n "$k" ]] && poff[$k]=1
  done

  step mcp "'$name', in ${(j:, :)pools}"
  for t in $pools; do
    for m in ${=pool[$t]}; do
      [[ "$m" == "$name" ]] && continue
      [[ -z "$(_claude_pool_member_problem "$ADROOT" "$PROFILES" "$m")" ]] || continue
      f="$(_claude_seat_cred_file "$ADROOT" "$PROFILES" "$m")"
      out="$(_claude_mcp_plugin_states "$f")" || \
        fail "cannot read the MCP sign-ins of '$m' (${f/#$HOME/~}), so which servers '$name' needs is unknown"
      for kv in "${(@f)out}"; do
        [[ -n "$kv" ]] || continue
        srv="${kv%%$'\t'*}"; st="${kv#*$'\t'}"
        (( ${+poff[${${srv#plugin:}%%:*}]} )) && continue
        [[ "$st" == good ]] && ! (( ${+want[$srv]} )) && want[$srv]="$m"
      done
    done
  done
  seatf="$(_claude_seat_cred_file "$ADROOT" "$PROFILES" "$name")"
  out="$(_claude_mcp_plugin_states "$seatf")" || \
    fail "cannot read the MCP sign-ins of '$name' itself (${seatf/#$HOME/~})"
  for kv in "${(@f)out}"; do
    [[ -n "$kv" ]] || continue
    srv="${kv%%$'\t'*}"; st="${kv#*$'\t'}"
    (( ${+poff[${${srv#plugin:}%%:*}]} )) && continue
    have[$srv]+=" $st"
  done
  # Only a server with no good entry is a target. A damaged entry BESIDE a good one
  # sits under an older config's key, which a new sign-in writes past rather than
  # over, so signing in again cannot clear it: it is reported, not retried.
  for srv in ${(k)want} ${(k)have}; do
    (( ${+seen[$srv]} )) && continue
    seen[$srv]=1
    st="${have[$srv]-} "
    if [[ "$st" == *"good "* ]]; then
      [[ "$st" == *(fossil|norefresh|broken|noexpiry)" "* ]] && stale+=( "$srv" )
    elif [[ "$st" == *(fossil|norefresh|broken)" "* ]]; then
      targets+=( "$srv" ); why[$srv]="its own entry is damaged"
    elif [[ "$st" == *"noexpiry "* ]]; then
      targets+=( "$srv" ); why[$srv]="its own entry has no usable expiry"
    elif (( ${+want[$srv]} )); then
      targets+=( "$srv" ); why[$srv]="'${want[$srv]}' is signed in to it"
    fi
  done
  targets=( "${(@o)targets}" )
  (( ${#stale} )) && \
    say "  note: ${(j:, :)${(@o)stale}}: signed in, beside an older entry that is damaged; a new sign-in does not replace it (claude-doctor reports it)"

  if (( ! ${#targets} )); then
    if (( ${#want} )); then
      say "signed in to all ${#want} plugin MCP server(s) its pools use; nothing to do"
    else
      say "no other member of ${(j:, :)pools} is signed in to a plugin MCP server; nothing to do"
    fi
    return 0
  fi
  for srv in $targets; do say "  $srv: ${why[$srv]}"; done
  (( nobrowser )) && lflags=( --no-browser )
  if (( dry )); then
    step plan "nothing below runs in a dry run"
    for srv in $targets; do
      say "  CLAUDE_CONFIG_DIR=${ad/#$HOME/~} claude mcp login ${lflags:+--no-browser }$srv"
    done
    return 0
  fi
  if (( nobrowser )); then
    [[ -t 0 ]] || refuse "--no-browser asks you to paste the redirect back, so it needs a terminal"
  fi

  for srv in $targets; do
    step login "$srv"
    say "  Approve it in the browser as this tenant's account at that service, the one its"
    say "  other seats use. The redirect goes to localhost, so whichever claude.ai account"
    say "  the browser is on does not matter."
    CLAUDE_CONFIG_DIR="$ad" "$CLAUDE_BIN" mcp login "${lflags[@]}" "$srv" || \
      say "  'claude mcp login $srv' failed (above)"
  done

  # What the seat's own file says now, read the way the doctor reads it: a login
  # that exited 0 without writing a usable entry is not a sign-in.
  step check "'$name'"
  seatf="$(_claude_seat_cred_file "$ADROOT" "$PROFILES" "$name")"
  out="$(_claude_mcp_plugin_states "$seatf")" || \
    fail "cannot read the MCP sign-ins of '$name' after signing in (${seatf/#$HOME/~})"
  have=()
  for kv in "${(@f)out}"; do
    [[ -n "$kv" ]] || continue
    srv="${kv%%$'\t'*}"; st="${kv#*$'\t'}"
    have[$srv]+=" $st"
  done
  for srv in $targets; do
    if [[ "${have[$srv]-} " == *"good "* ]]; then
      say "  ✓ $srv"
    else
      say "  ✗ $srv"
      notok+=( "$srv" )
    fi
  done
  if (( ${#notok} )); then
    print -u2 -- "$prog: '$name' is still not signed in to ${(j:, :)notok}."
    print -u2 -- "    Sign in from a session on it instead: claude-as $name, then /mcp, and choose each."
    return 2
  fi
  say ""
  say "'$name' is signed in to every plugin MCP server its pools use."
  return 0
}
if [[ "$cmd" == mcp ]]; then
  seat_mcp
  exit $?
fi

# ---- retire: take a seat out of service (DO-798) -------------------------------------
# The inverse of add, ordered so that every step is safe to repeat: out of the pool
# first, so no new launch lands on it; then wait for the sessions on it to move;
# and only when none is left, tear down. NOTHING IS DELETED WHILE A SESSION HOLDS
# THE SEAT, and a Claude process whose environment cannot be read counts as one.
# Sessions are never moved from here: the move commands are printed for a person.
# The account dir becomes a tombstone and the name is recorded as retired, so it
# is never reused. `clauth delete` stays the human's: it discards the login, and
# it revokes nothing server-side.

# Whether credential file $1 is a link into seat $name's store. Read off the
# link's OWN target, made absolute, as well as resolved: zsh's :A does not follow
# a DANGLING link (nor does :P), so once `clauth delete` removed the store, a link into it
# resolved to itself and every session on the seat looked like no session.
links_to_store() {
  local c="$1" t
  [[ -L "$c" ]] || return 1
  [[ "${c:P}" == "${store:P}" ]] && return 0
  t="$(readlink -- "$c" 2>/dev/null)" || return 1
  [[ "$t" == /* ]] || t="${c:h}/$t"
  [[ "${t:a}" == "${store:a}" || "${t:a}" == "${PROFILES:P}/$name/credentials.json" ]]
}

# HOLDER EVIDENCE. Each *_signal sets sig to `yes` (it says this seat), `no` (it
# says another seat), `unknown` (it exists and cannot be read), or nothing (it
# has nothing to say). holders_of_seat weighs them all: ANY yes makes a holder,
# else any unknown is undecided, and only a definite no clears a process. The
# first signal deciding on its own is how a stale row, an active profile or the
# first of two identical stores each overruled a link into this very seat.

# The credential file a process reads: a link into this seat's store (yes) or
# into another profile's (no); a real file, by the doctor's credential identity,
# compared with this seat's own store FIRST (two stores can be byte-identical, and
# the first owner found would then be the other one).
cred_signal() {   # $1 = credential file
  local c="$1" t id
  sig=""
  if [[ -L "$c" ]]; then
    if links_to_store "$c"; then sig=yes; return 0; fi
    t="$(readlink -- "$c" 2>/dev/null)" || { sig=unknown; return 0; }
    [[ "$t" == /* ]] || t="${c:h}/$t"
    if [[ "${t:a}" == "${PROFILES:a}"/*/credentials.json || "${t:P}" == "${PROFILES:P}"/*/credentials.json ]]; then
      sig=no; return 0
    fi
    [[ -e "$c" ]] || { sig=unknown; return 0; }
  fi
  [[ -e "$c" ]] || return 0
  id="$(_claude_cred_id "$c" 2>/dev/null)"
  [[ -n "$id" ]] || { sig=unknown; return 0; }
  if [[ -e "$store" && "$id" == "$(_claude_cred_id "$store" 2>/dev/null)" ]]; then
    sig=yes
  elif [[ -n "$(_claude_cred_owner "$id" 2>/dev/null)" ]]; then
    sig=no
  fi
  return 0
}
# clauth's live-session row for a runtime dir (`runtime-<sid>`): the member it
# is on now. Trusted only when its pid IS this process: a row left by an earlier
# session with the same sid says nothing about this one, and one whose pid
# matches is clauth's own word, wherever the dir is.
row_signal() {   # $1 = config dir (absolute, normalised), $2 = pid
  local sid row_f rpid member
  sig=""
  [[ "${1:t}" == runtime-(#b)(<->-<->) ]] || return 0
  sid="${match[1]}"
  row_f="$HOME/.clauth/live_sessions/$sid.json"
  [[ -e "$row_f" || -L "$row_f" ]] || return 0
  rpid="$(jq -er '.pid | tostring' "$row_f" 2>/dev/null)" || { sig=unknown; return 0; }
  [[ "$rpid" == "$2" ]] || return 0
  member="$(jq -er '(.current_member // .start_profile) | strings' "$row_f" 2>/dev/null)" || { sig=unknown; return 0; }
  if [[ "$member" == "$name" ]]; then sig=yes; else sig=no; fi
  return 0
}
# The global file's owner, by clauth's active profile. A profiles.toml that exists
# and cannot be read is unknown, never a quiet fall-back to status.json.
global_signal() {
  local pt="$HOME/.clauth/profiles.toml" a
  sig=""
  if [[ -e "$pt" && ! -r "$pt" ]]; then sig=unknown; return 0; fi
  a="$(_claude_active_profile)"
  [[ -n "$a" ]] || return 0
  if [[ "$a" == "$name" ]]; then sig=yes; else sig=no; fi
  return 0
}

# The sessions holding seat $name, into holders (one line each, with the command
# that moves it to $target) and n_unknown, which stops the teardown like a
# holder. Paths are compared lexically (:a) AND physically (:P), against both
# forms of the seat's dirs, so neither a symlinked profile dir nor a `..` hides
# one. A relative CLAUDE_CONFIG_DIR is resolved against the process's OWN cwd.
holders_of_seat() {
  local row pid cfg cn cA cwdp cwd yes unk no procroot ada="${ad:a}" adA="${ad:P}"
  local pa="$PROFILES/$name" paa paA ga gA sig
  paa="${pa:a}"; paA="${pa:P}"; ga="${HOME:a}/.claude"; gA="${${HOME}/.claude:P}"
  holders=() n_unknown=0
  procroot="$(_claude_proc_root)"
  [[ -d "$procroot" && -r "$procroot" && -x "$procroot" ]] || \
    fail "cannot read ${procroot}, so whether a session holds '$name' is unknown"
  for row in ${(f)"$(_claude_proc_config_dirs)"}; do
    [[ -n "$row" ]] || continue
    pid="${row%%$'\t'*}"; cfg="${row#*$'\t'}"
    if [[ "$cfg" == "?" ]]; then
      (( ++n_unknown ))
      continue
    fi
    cwdp="$(readlink "$procroot/$pid/cwd" 2>/dev/null)"
    if [[ -n "$cfg" && "$cfg" != /* ]]; then
      if [[ -z "$cwdp" ]]; then (( ++n_unknown )); continue; fi
      cfg="$cwdp/$cfg"
    fi
    yes=0 unk=0 no=0
    cn="${cfg:+${cfg:a}}"; cA="${cfg:+${cfg:P}}"
    if [[ -z "$cfg" || "$cn" == "$ga" || "$cA" == "$gA" ]]; then
      # The global file: what it links to, or is, and whose clauth says it is.
      cred_signal "$(_claude_global_cred_file)"
      case "$sig" in yes) yes=1 ;; unknown) unk=1 ;; no) no=1 ;; esac
      global_signal
      case "$sig" in yes) yes=1 ;; unknown) unk=1 ;; no) no=1 ;; esac
      (( yes || unk || no )) || unk=1      # nothing says whose it is
    else
      [[ "$cn" == ($ada|$adA) || "$cA" == ($ada|$adA) ]] && yes=1
      row_signal "$cn" "$pid"
      case "$sig" in yes) yes=1 ;; unknown) unk=1 ;; no) no=1 ;; esac
      cred_signal "$cfg/.credentials.json"
      case "$sig" in yes) yes=1 ;; unknown) unk=1 ;; no) no=1 ;; esac
      # One of this seat's own dirs, and nothing else says anything: held.
      if (( ! yes && ! unk && ! no )) && \
         [[ "$cn" == ($paa|$paA)/* || "$cA" == ($paa|$paA)/* ]]; then
        yes=1
      fi
    fi
    if (( ! yes )); then
      (( unk )) && (( ++n_unknown ))
      continue
    fi
    cwd="${${cwdp/#$HOME/~}:-?}"
    if [[ -n "$cfg" && "${cn:t}" == runtime-(#b)(<->-<->) ]]; then
      holders+=( "clauth session ${match[1]} (pid $pid, $cwd): clauth switch ${match[1]} $target" )
    elif [[ -z "$cfg" || "$cn" == "$ga" ]]; then
      holders+=( "pid $pid ($cwd), on the global file, which is '$name': clauth switch $target, then restart it" )
    else
      holders+=( "pid $pid ($cwd): /exit in it, then claude-as $target --resume <the id /exit prints>" )
    fi
  done
}
# Read the holders again and stop at exit 3 if there are any: $1 says what has
# been done so far, so the message is true at every point it is called from.
stop_if_held() {
  local h
  holders_of_seat
  (( ${#holders} || n_unknown )) || return 0
  for h in $holders; do say "  $h"; done
  (( n_unknown )) && say "  $n_unknown Claude process(es) whose holder cannot be decided"
  print -u2 -- "$prog: '$name' $1, but it may still be in use; nothing more was done."
  print -u2 -- "    Move each session above, then run this again."
  exit 3
}

# The plugin servers credential file $1 is signed in to, one per line, sorted and
# once each (not discovery records). Nothing for a missing file or a link left
# dangling by `clauth delete`. Run in $(...), so the caller checks its status.
servers_of() {
  local out kv
  local -aU srvs
  [[ -e "$1" ]] || return 0
  out="$(_claude_mcp_plugin_states "$1")" || fail "cannot read the MCP sign-ins in ${1/#$HOME/~}"
  for kv in "${(@f)out}"; do
    [[ -n "$kv" && "${kv#*$'\t'}" != discovery ]] && srvs+=( "${kv%%$'\t'*}" )
  done
  (( ${#srvs} )) && print -rl -- "${(@o)srvs}"
  return 0
}

seat_retire() {
  local store="$PROFILES/$name/credentials.json" ad="$ADROOT/$name" t m h srv tomb rc err out n_unknown=0
  local target="" refusal=""
  local -a pools ovfs spills blockers holders tombs ssv lsv left
  local -aU servers
  case "$(_claude_pool_member_problem "$ADROOT" "$PROFILES" "$name")" in
    compat)  refuse "'$name' is a compat symlink in the account root, not a seat; retire the profile it stands for" ;;
    retired) refuse "'$name' is itself a retired name" ;;
  esac
  for t in ${(ok)pool}; do (( ${${=pool[$t]}[(Ie)$name]} )) && pools+=( "$t" ); done
  for t in ${(ok)ovf};  do (( ${${=ovf[$t]}[(Ie)$name]} ))  && ovfs+=( "$t" ); done
  for t in ${(ok)spill}; do (( ${${=spill[$t]}[(Ie)$name]} )) && spills+=( "$t" ); done
  tombs=( "$ADROOT/$name".retired-*(N/) )
  rabota_seats
  console_seats
  (( ${+mid[$name]} )) && blockers+=( "CLAUDE_TENANT_MACHINE_ID in the tenants file: machine '${mid[$name]}' bills it" )
  for t in $ovfs; do blockers+=( "CLAUDE_TENANT_OVERFLOW for '$t' in the tenants file" ); done
  for t in $spills; do blockers+=( "CLAUDE_TENANT_SPILL for '$t' in the tenants file" ); done
  (( ${+rseat[$name]} )) && blockers+=( "${rseat[$name]} ([seats] local)" )
  (( ${+cseat[$name]} )) && blockers+=( "CONSOLE_SEATS in ${RABOTA_BUDGET/#$HOME/~}" )

  if (( ! ${#pools} && ! ${#blockers} )) && [[ ! -d "$ad" ]]; then
    if (( ${+retired[$name]} )); then
      say "'$name' is already retired."
      [[ -e "$store" || -L "$store" ]] && say "Its profile is still here: clauth delete $name -y"
      return 0
    fi
    [[ -e "$store" || -L "$store" ]] || (( ${#tombs} )) || \
      refuse "there is no seat called '$name' here: no pool, profile or account dir names it"
  fi

  # Where its sessions go: another usable member of a pool it is in.
  for t in $pools; do
    for m in ${=pool[$t]}; do
      if [[ "$m" != "$name" && -z "$(_claude_pool_member_problem "$ADROOT" "$PROFILES" "$m")" ]]; then
        target="$m"
        break 2
      fi
    done
  done
  [[ -n "$target" ]] || target="<another seat>"

  # Every pool edit is checked before any is made: a refusal on the second pool
  # must not leave the first one already edited and committed.
  if (( ! ${#blockers} && ${#pools} )); then
    typeset -ga eflags
    editor_flags
    for t in $pools; do
      err="$(command zsh "$EDIT" --dry-run "${eflags[@]}" pool-remove "$t" "$name" 2>&1 >/dev/null)"
      rc=$?
      (( rc == 0 )) && continue
      if (( rc == 1 )); then
        refusal="the tenants-file editor would not take '$name' out of '$t': ${${err%%$'\n'*}#*refused: }"
      else
        refusal="the tenants-file editor could not check taking '$name' out of '$t' (exit $rc): ${err%%$'\n'*}"
      fi
      break
    done
  fi
  holders_of_seat

  step plan "'$name'"
  say "  pools:          ${${(j:, :)pools}:-none}"
  if [[ -e "$store" || -L "$store" ]]; then say "  profile store:  yes"; else say "  profile store:  none"; fi
  if [[ -d "$ad" ]]; then say "  account dir:    ${ad/#$HOME/~}"; else say "  account dir:    none"; fi
  (( ${+retired[$name]} )) && say "  retired table:  already names it"
  for h in $blockers; do say "  named in:       $h"; done
  for h in $holders; do say "  held by:        $h"; done
  (( n_unknown )) && say "  cannot tell:    $n_unknown Claude process(es) whose holder cannot be decided"
  if (( dry )); then
    say ""
    if (( ${#blockers} )); then
      say "the real run would refuse: still named in ${(j:; :)blockers}"
      return 1
    elif [[ -n "$refusal" ]]; then
      say "the real run would refuse: $refusal"
      return 1
    elif (( ${#holders} || n_unknown )); then
      say "the real run would take it out of its pools and stop at exit 3: it may still be in use"
      return 3
    fi
    say "a plan only: nothing was changed"
    return 0
  fi
  (( ${#blockers} )) && \
    refuse "'$name' is still named in: ${(j:; :)blockers}. Edit those first; this command does not."
  [[ -z "$refusal" ]] || refuse "$refusal"

  if (( ${#pools} )); then
    step pool "out of ${(j:, :)pools}"
    typeset -ga eflags
    editor_flags
    for t in $pools; do
      command zsh "$EDIT" "${eflags[@]}" pool-remove "$t" "$name" || \
        fail "the tenants-file editor did not take '$name' out of '$t' (above); the pools before it were edited"
    done
  fi

  # Scanned AGAIN, now that no new launch can be routed to it.
  step holders "'$name'"
  stop_if_held "is out of every pool"
  say "  none"

  # Recorded FIRST of the teardown: the step most likely to be refused (it checks
  # the reason and the tables) comes before anything that cannot be redone.
  step record "the retired-names table"
  if (( ${+retired[$name]} )); then
    say "  already names it"
  else
    typeset -ga eflags
    editor_flags
    command zsh "$EDIT" "${eflags[@]}" retire-name "$name" "${reason:-retired $(date +%F) with claude-seat}"
    rc=$?
    (( rc == 0 )) || {
      (( rc == 1 )) && refuse "the tenants-file editor would not record '$name' as retired (above)"
      fail "the tenants-file editor could not record '$name' as retired (above)"
    }
  fi

  # Everything it was signed in to, for the revoke list: the store, read BEFORE
  # the logout changes it, and the account dir. Only the dir's are logged out.
  out="$(servers_of "$store")" || exit $?
  ssv=( ${(f)out} )
  if [[ -d "$ad" ]]; then
    # And again before each step that cannot be redone: a `claude-as <seat>`
    # launch is pinned, so the pool edit does not keep it away.
    stop_if_held "is out of every pool and recorded as retired"
    step logout "plugin MCP servers in '$name'"
    out="$(servers_of "$ad/.credentials.json")" || exit $?
    lsv=( ${(f)out} )
    for srv in $lsv; do
      if CLAUDE_CONFIG_DIR="$ad" "$CLAUDE_BIN" mcp logout "$srv" >/dev/null 2>&1; then
        say "  ✓ $srv"
      else
        say "  ✗ $srv: 'claude mcp logout' failed; revoke its grant at the service (below)"
      fi
    done
    (( ${#lsv} )) || say "  none signed in"
    # A logout is an atomic write: it replaces the dir's link with a real file and
    # leaves the store's copy as it was. The account-dir builder's reconciler folds
    # it back, before the rename takes the dir out of its reach.
    if (( ${#lsv} )) && [[ -e "$store" ]]; then
      command bash "$ACCDIRS" "$name" >/dev/null 2>&1 || \
        say "  claude-account-dirs.sh $name failed, so the store may keep its copy (below)"
    fi

    stop_if_held "is recorded as retired and logged out, but its account dir was not renamed"
    step tombstone "${ad/#$HOME/~}"
    tomb="$ADROOT/$name.retired-$(date +%Y%m%d)"
    [[ ! -e "$tomb" && ! -L "$tomb" ]] || fail "${tomb/#$HOME/~} already exists; rename one of them by hand"
    command mv -- "$ad" "$tomb" || fail "could not rename ${ad/#$HOME/~}"
    say "  now ${tomb/#$HOME/~}"
  fi
  servers=( $ssv $lsv )
  servers=( "${(@o)servers}" )
  out="$(servers_of "$store")" || exit $?
  left=( ${(f)out} )

  step done "'$name' is retired here. Left for you:"
  if [[ -e "$store" || -L "$store" ]]; then
    say "  - clauth delete $name -y    removes the profile and its login on this machine;"
    say "    it revokes nothing server-side."
    (( ${#left} )) && say "    Its store still holds ${(j:, :)left} until then."
  fi
  say "  - claude.ai -> Settings -> Claude Code: revoke this seat's login."
  say "  - Remove the seat from the Team, and its Workspace alias, or hand it over."
  if (( ${#servers} )); then
    say "  - Revoke its app grants at each service (${(j:, :)servers}): Slack apps, Notion"
    say "    connections, Linear authorized apps."
  fi
  return 0
}
# ---- browser: one browser profile per tenant (DO-799) --------------------------------
# A browser's claude.ai session decides where a `clauth login` grant goes, and its
# Google session decides which identity a connector gets. A profile kept for ONE
# tenant holds that tenant's Google sign-in and nothing else, so a seat's
# connectors cannot pick up another tenant's identity, and claude.ai is signed in
# as one seat at a time, then out again. The connector list and the Google
# account come from the tenants file, never from this repo.
seat_browser() {
  local dir="$SEAT_STATE/browser/$tenant" b url="https://claude.ai/login" d brc
  local launch="$SEAT_STATE/browser/.launch-$tenant"
  local -a args
  (( ${+pool[$tenant]} )) || \
    refuse "the tenants file declares no tenant '$tenant', so there is no profile to open for it"
  [[ "$SEAT_STATE" == /* ]] || fail "CLAUDE_SEAT_STATE must be an absolute path, not '$SEAT_STATE'"
  if [[ -n "${CLAUDE_SEAT_BROWSER-}" ]]; then
    b="$CLAUDE_SEAT_BROWSER"
    [[ -f "$b" && -x "$b" ]] || b="$(whence -p -- "$b" 2>/dev/null)"
  else
    for b in google-chrome google-chrome-stable chromium chromium-browser ""; do
      [[ -n "$b" ]] || break
      b="$(whence -p -- "$b" 2>/dev/null)" && [[ -n "$b" ]] && break
    done
  fi
  [[ -n "$b" && -x "$b" ]] || \
    fail "no browser to open: install Chrome or Chromium, or set CLAUDE_SEAT_BROWSER"
  # A snap browser cannot reach a profile under a dot-directory, and fails or falls
  # back to its own DEFAULT profile, the main account. Ubuntu's firefox, chromium
  # and chromium-browser are snaps, or small wrappers that exec one.
  if [[ "${b:A}" == /snap/* ]] || \
     { [[ $(command stat -Lc %s -- "$b" 2>/dev/null || print 0) -lt 16384 ]] && command grep -q '/snap/' -- "$b" 2>/dev/null; }; then
    fail "${b:t} is a snap browser, which cannot use a profile under ${SEAT_STATE/#$HOME/~}; install the deb, or set CLAUDE_SEAT_BROWSER"
  fi
  # A profile must be this tenant's own: a symlink at any level could point it at
  # another tenant's cookies, which is the very leak the profile exists to stop.
  for d in "$SEAT_STATE" "$SEAT_STATE/browser" "$dir"; do
    [[ ! -L "$d" ]] || fail "${d/#$HOME/~} is a symlink; a tenant's profile must be its own directory"
    [[ ! -e "$d" || ( -d "$d" && -O "$d" ) ]] || fail "${d/#$HOME/~} is not a directory owned by you"
  done
  # A Chromium profile is a --user-data-dir; a Firefox one, -profile with
  # -no-remote, so it does not hand the URL to a running Firefox. (A snap Firefox
  # cannot reach a profile under a dot-directory.)
  if [[ "${b:t}" == firefox* ]]; then
    args=( -profile "$dir" -no-remote "$url" )
  else
    args=( "--user-data-dir=$dir" --no-first-run --no-default-browser-check "$url" )
  fi

  step browser "'$tenant': ${dir/#$HOME/~}"
  if (( dry )); then
    say "  would run: ${b:t} ${(j: :)${(@q)args}}"
  else
    if [[ ! -d "$dir" ]]; then
      ( umask 077 && command mkdir -p -- "$dir" ) || fail "could not create ${dir/#$HOME/~}"
    fi
    # Private even when an earlier hand left it open.
    command chmod 700 -- "$dir" || fail "could not make ${dir/#$HOME/~} private"
    # Watched for a moment: a browser that dies at once (no display, a crash) is a
    # failure, not "opened". One that exits 0 at once handed the window to a
    # browser already running on that profile.
    ( umask 077 && command mkdir -p -- "$launch" ) || fail "could not make ${launch/#$HOME/~}"
    : > "$launch/err"; command rm -f -- "$launch/rc"
    ( "$b" "${args[@]}" </dev/null >/dev/null 2>"$launch/err"; print -r -- $? > "$launch/rc" ) &!
    sleep "${CLAUDE_SEAT_BROWSER_WAIT:-1.5}"
    if [[ -s "$launch/rc" ]]; then
      brc="$(<"$launch/rc")"
      (( brc == 0 )) || fail "${b:t} exited $brc at once: $(tail_redacted "$(<"$launch/err")")"
      say "  handed to ${b:t}, already running on this profile"
    else
      say "  opened ${b:t} on its own profile"
    fi
  fi
  say ""
  say "In that window, for each seat of '$tenant':"
  say "  1. Sign in to claude.ai AS THE SEAT (the link goes to the seat's address)."
  say "  2. Run '$prog add $tenant' in a terminal; open the URL clauth prints IN THIS WINDOW."
  if [[ -n "${connectors[$tenant]-}" ]]; then
    say "  3. claude.ai -> Settings -> Connectors: connect ${connectors[$tenant]}."
    if [[ -n "${cacct[$tenant]-}" ]]; then
      say "     When Google asks, choose ${cacct[$tenant]}, and no other account."
    fi
  else
    say "  3. claude.ai -> Settings -> Connectors: connect the tenant's connectors. To have this"
    say "     name them and the Google account, set CLAUDE_TENANT_CONNECTORS and"
    say "     CLAUDE_TENANT_CONNECTOR_ACCOUNT for '$tenant' in the tenants file."
  fi
  say "  4. Sign out of claude.ai, so the next seat's login cannot land on this one."
  say "The Google sign-in stays in this profile; a claude.ai sign-in never should."
  return 0
}
if [[ "$cmd" == browser ]]; then
  seat_browser
  exit $?
fi

if [[ "$cmd" == retire ]]; then
  seat_retire
  exit $?
fi

# ---- preflight ------------------------------------------------------------------------
step preflight "tenant '$tenant', pool: ${pool[$tenant]:-<empty>}"
typeset -a sibs
for m in ${=pool[$tenant]}; do
  [[ "$m" == "$name" && -n "$name" ]] && continue
  [[ -e "$PROFILES/$m/credentials.json" || -L "$PROFILES/$m/credentials.json" ]] || continue
  # Unreadable, it reads as clauth's defaults, which "agree" with any template.
  [[ ! -e "$PROFILES/$m/config.toml" || -r "$PROFILES/$m/config.toml" ]] || \
    fail "cannot read $PROFILES/$m/config.toml"
  sibs+=( "$m" )
done
ref="${sibs[1]-}"
if [[ -n "$ref" ]]; then
  refkeys="$(swapkeys "$PROFILES/$ref/config.toml")"
  for m in ${sibs[2,-1]}; do
    [[ "$(swapkeys "$PROFILES/$m/config.toml")" == "$refkeys" ]] || \
      refuse "pool members '$ref' and '$m' disagree on a setting a move compares; make them agree first (claude-doctor names the key)"
  done
fi

# Every name that has ever existed, with where it was seen.
typeset -A known
known_add() { [[ -n "$1" ]] && known[$1]="${known[$1]:+${known[$1]}, }$2" }
for p in "$PROFILES"/*(N-/:t); do known_add "$p" "a clauth profile"; done
for a in "$ADROOT"/*(ND-/:t) "$ADROOT"/*(ND@:t); do
  if [[ -L "$ADROOT/$a" ]]; then known_add "$a" "a compat symlink"
  elif [[ "$a" == *.retired-* ]]; then known_add "${a%%.retired-*}" "a retired account dir"
  else known_add "$a" "an account dir"; fi
done
for t in ${(k)pool}; do for m in ${=pool[$t]}; do known_add "$m" "pool '$t'"; done; done
for t in ${(k)ovf};  do for m in ${=ovf[$t]};  do known_add "$m" "overflow '$t'"; done; done
for t in ${(k)spill}; do for m in ${=spill[$t]}; do known_add "$m" "spill '$t'"; done; done
for k in ${(k)mid};   do known_add "$k" "the machine-id table"; done
for k in ${(k)retired}; do known_add "$k" "the retired-names table"; done
rabota_seats
for k in ${(k)rseat}; do known_add "$k" "${rseat[$k]}"; done
if [[ -e "$ADROOT/.pick-ledger" ]]; then
  [[ -r "$ADROOT/.pick-ledger" ]] || fail "cannot read $ADROOT/.pick-ledger, which remembers names"
  for l in "${(@f)mapfile[$ADROOT/.pick-ledger]-}"; do known_add "${l%%$'\t'*}" "the picker's ledger"; done
fi

if [[ "$tenant" == "$WORK_TENANT" ]]; then prefix="$WORK_PREFIX"; else prefix="$tenant-"; fi
resume=0
if [[ -z "$name" ]]; then
  max=-1
  typeset -a unfinished
  for k in ${(k)known}; do
    [[ "$k" == ${(b)prefix}(#b)(<->) ]] || continue
    (( match[1] > max )) && max=$match[1]
    unfinished_where "${known[$k]}" && unfinished+=( "$k" )
  done
  # Proposing past a seat a run started would start a second login of the same
  # person under the next number, and the distinct step would refuse it only
  # after that login.
  if (( ${#unfinished} )); then
    unfinished=( "${(@o)unfinished}" )
    refuse "'${unfinished[1]}' was started and not finished (it exists only as ${known[${unfinished[1]}]}). Resume it: $prog add $tenant ${unfinished[1]}"
  fi
  name="$prefix$(( max + 1 ))"
  say "proposed name: $name (nothing called that has ever existed)"
else
  # Not `..` or `.x`: the name becomes a path under ~/.clauth/profiles and the
  # account root.
  [[ "$name" == [A-Za-z0-9]* && -z "${name//[A-Za-z0-9_.-]/}" ]] || \
    refuse "'$name' may only contain letters, digits, - _ and ., and must start with a letter or digit"
  if [[ "$tenant" == "$WORK_TENANT" ]]; then
    [[ "$name" == ${WORK_PREFIX}* ]] || refuse "a '$WORK_TENANT' seat must be named $WORK_PREFIX*; rabota refuses every lane on it otherwise"
  else
    [[ "$name" != ${WORK_PREFIX}* ]] || refuse "only a '$WORK_TENANT' seat may be named $WORK_PREFIX*; rabota refuses it for '$tenant'"
  fi
  if (( ${+known[$name]} )); then
    # A run that stopped part-way leaves exactly a profile and maybe an account
    # dir behind. That, and nothing else, is resumed.
    where="${known[$name]}"
    if unfinished_where "$where"; then
      resume=1
      say "'$name' exists as $where, and nothing else: resuming"
    else
      refuse "'$name' has already been used: $where. A name is never reused."
    fi
  fi
fi

rerun="$prog add${email:+ --email $email} $tenant $name"

# Every other profile's account id, read now: one that cannot be read leaves the
# distinct step blind to a second login of its account, and finding that out
# after the human login is too late.
typeset -A ids
for p in "$PROFILES"/*(N-/:t); do
  [[ "$p" == "$name" ]] && continue
  pf="$PROFILES/$p/account_id.json"
  [[ -e "$pf" || -e "$PROFILES/$p/credentials.json" || -L "$PROFILES/$p/credentials.json" ]] || continue
  ids[$p]="$(id_of "$pf")"
  [[ -n "${ids[$p]}" ]] || \
    fail "cannot read the account id of '$p' ($pf is missing, empty or unreadable), so a second login to its account could not be told apart"
done

# Before the human login, not at the end.
typeset -a eflags
editor_flags

if (( dry )); then
  step plan "nothing below runs in a dry run"
  say "  login      ${CLAUTH} login $name   (the human step)"
  say "  distinct   its account id must repeat no other profile's"
  # An explicit branch: `${ref:-x}` prints $ref itself when it is set.
  if [[ -n "$ref" ]]; then say "  settings   copy $ref's config.toml"
  else say "  settings   no member to copy from: clauth's defaults stay"; fi
  say "  dir        claude-account-dirs.sh $name"
  say "  identity   claude auth status; the account must be the login's, its type and"
  say "             organisation every pool member's"
  if (( ${#eflags} )); then say "  pool       claude-tenants-edit --commit pool-add $tenant $name"
  else say "  pool       claude-tenants-edit pool-add $tenant $name   (not committed: the tenants file is not tracked in git)"; fi
  exit 0
fi

# ---- login ------------------------------------------------------------------------------
store="$PROFILES/$name/credentials.json"
step login "$name"
if [[ -e "$store" || -L "$store" ]]; then
  say "already logged in; skipping"
else
  say "  Sign in AS THE NEW SEAT, not your main account. clauth opens a browser and also"
  say "  prints the URL: open it in the browser profile signed in to claude.ai as the"
  say "  new seat. The grant goes to whichever claude.ai account that page is signed in to."
  say "  Not signed in as the seat in the tenant's own profile yet? Stop here (Ctrl-C),"
  say "  run '$prog browser $tenant', sign in as the seat there, and run this again."
  "$CLAUTH" login "$name" || fail "'clauth login $name' failed"
  [[ -e "$store" || -L "$store" ]] || fail "'clauth login $name' finished, but $store does not exist"
fi

# ---- distinct -----------------------------------------------------------------------------
step distinct "account id"
# The login's account id is the anchor the identity step checks against, so a
# seat without one cannot be told from another seat or from the browser's account.
newid="$(id_of "$PROFILES/$name/account_id.json")"
[[ -n "$newid" ]] || \
  fail "'clauth login $name' recorded no account id in $PROFILES/$name/account_id.json; log in again, then re-run: $rerun"
for p in ${(k)ids}; do
  [[ "${ids[$p]}" == "$newid" ]] && \
    refuse "'$name' is logged in to the same account as '$p'. Undo it: clauth delete $name, then claude-tenants-edit retire-name $name 'a second login to $p'"
done
say "distinct from every other profile"

# ---- settings -----------------------------------------------------------------------------
step settings "config.toml"
cfg="$PROFILES/$name/config.toml"
if [[ -z "$ref" ]]; then
  say "no other member to copy from; clauth's defaults stay"
elif [[ "$(effective "$cfg")" == "$(effective "$PROFILES/$ref/config.toml")" ]]; then
  say "already matches '$ref'"
elif [[ -z "$(effective "$cfg")" ]]; then
  command cp "$PROFILES/$ref/config.toml" "$cfg" || fail "could not copy $ref's config.toml"
  say "copied from '$ref'"
else
  refuse "$cfg has settings of its own that differ from '$ref'; make them match by hand"
fi

# ---- dir ------------------------------------------------------------------------------------
step dir "account dir"
ad="$ADROOT/$name"
if ! err="$(command bash "$ACCDIRS" "$name" 2>&1)"; then
  fail "claude-account-dirs.sh $name failed:"$'\n'"$err"
fi
credl="$ad/.credentials.json"
[[ -L "$credl" && "${credl:A}" == "${store:A}" ]] || fail "$credl is not a link into $store"
say "built: ${ad/#$HOME/~}"

# ---- identity --------------------------------------------------------------------------------
step identity "organisation and account"
cj="$ad/.claude.json"
account_of() { jq -r '.oauthAccount.accountUuid // empty' "$1" 2>/dev/null }
# Only an identity naming the account the login recorded counts. The dir was
# seeded from ~/.claude.json, and that copy names whichever account the global
# file does: judging it would check the wrong account's organisation.
anchored() { [[ "$(account_of "$cj")" == "$newid" ]] }
[[ -r "$cj" ]] && jq -e 'type == "object"' "$cj" >/dev/null 2>&1 || \
  fail "$cj is missing or not a JSON object (claude-account-dirs.sh seeds it); repair it, then re-run: $rerun"
why=""
if ! anchored; then
  out="$(CLAUDE_CONFIG_DIR="$ad" "$CLAUDE_BIN" auth status --json 2>&1 >/dev/null)" || \
    why="claude auth status failed: $(tail_redacted "$out")"
fi
if ! anchored; then
  ans=n
  if (( yes )); then
    ans=y
  elif [[ -t 0 ]]; then
    read -r "ans?A first launch sends one tiny request on '$name' to fetch its identity. Run it? [y/N] "
  fi
  [[ "$ans" == [yY]* ]] || \
    fail "the seat's identity is unknown${why:+ ($why)}. Allow one first launch: $prog add --yes${email:+ --email $email} $tenant $name"
  out="$(CLAUDE_CONFIG_DIR="$ad" "$CLAUDE_BIN" -p 'Reply with the single word: ok' --model haiku 2>&1 >/dev/null)" || \
    why="the first launch failed: $(tail_redacted "$out")"
fi
if ! anchored; then
  [[ -z "$(account_of "$cj")" ]] || \
    fail "$cj names another account than the one '$name' logged in to, even after a launch${why:+; $why}"
  fail "the seat's identity is still unknown after a launch${why:+; $why}"
fi
otype="$(jq -r '.oauthAccount.organizationType // ""' "$cj")"
ouuid="$(jq -r '.oauthAccount.organizationUuid // ""' "$cj")"
mail="$(jq -r '.oauthAccount.emailAddress // ""' "$cj")"
oname="$(jq -r '.oauthAccount.organizationName // ""' "$cj")"

if [[ -n "$email" && "${(L)mail}" != "${(L)email}" ]]; then
  refuse "'$name' is ${mail:-<no address>}, not $email. The login went to another claude.ai account; clauth delete $name and log in again"
fi
# Against EVERY member whose account dir names its own account (one naming another
# is a stale copy, not evidence): the same type, and for a team, the same
# organisation. A login that went to the browser's claude.ai account differs here.
compared=0
for m in $sibs; do
  scj="$ADROOT/$m/.claude.json"
  sid="${ids[$m]-}"
  [[ -n "$sid" && -r "$scj" && "$(account_of "$scj")" == "$sid" ]] || continue
  stype="$(jq -r '.oauthAccount.organizationType // ""' "$scj" 2>/dev/null)"
  sorg="$(jq -r '.oauthAccount.organizationUuid // ""' "$scj" 2>/dev/null)"
  [[ -n "$stype" && ( "$stype" != claude_team || -n "$sorg" ) ]] || continue
  [[ "$otype" == "$stype" ]] || \
    refuse "'$name' is a ${otype:-<no type>} account, and '$m' is $stype. The login went to another claude.ai account than intended (the browser's?); clauth delete $name and log in again"
  [[ "$stype" != claude_team || "$ouuid" == "$sorg" ]] || \
    refuse "'$name' is in a different organisation from '$m'. The login went to the browser's claude.ai account; clauth delete $name and log in again"
  (( ++compared ))
done
(( compared || ! ${#sibs} )) || \
  fail "no member of '$tenant' has an account dir naming its own account, so '$name' has nothing to be compared with. Launch one once (claude-as ${sibs[1]}), then re-run: $rerun"
say "${mail:-<no address>}${oname:+, $oname} (${otype:-unknown type})"

# ---- pool ---------------------------------------------------------------------------------------
step pool "'$tenant'"
pool_now() {   # 0 the tenants file's pool names $name now · 1 it does not · 2 cannot tell
  local out l
  local -a mem
  out="$(command zsh "$EDIT" dump 2>/dev/null)" || return 2
  for l in "${(@f)out}"; do
    [[ "$l" == "POOL$SEP$tenant$SEP"* ]] || continue
    mem=( ${=${l#POOL$SEP$tenant$SEP}} )
    (( ${mem[(Ie)$name]} )) && return 0
    return 1
  done
  return 1
}
if (( ${${=pool[$tenant]}[(Ie)$name]} )); then
  say "already in the pool"
elif ! command zsh "$EDIT" "${eflags[@]}" pool-add "$tenant" "$name"; then
  # The editor rolls back a failed commit, but if the roll-back fails too, the
  # edit stands. Say what is true, not what the code path assumes.
  pool_now
  case $? in
    1) fail "the tenants-file editor did not add it (above)" ;;
    0) print -u2 -- "$prog: the tenants-file editor reported a failure (above), but '$name' IS in the pool of '$tenant'; check $TENANTS and its repo"
       exit 3 ;;
    *) print -u2 -- "$prog: the tenants-file editor reported a failure (above), and the tenants file cannot be re-read: '$name' may be in the pool of '$tenant'; check $TENANTS"
       exit 3 ;;
  esac
fi
# The picker's own view, by its pool line, not its exit status: a dry run that
# would refuse a launch (every seat spent) still prints the line, and exits 2.
rc=0 pickwarn=""
pickout="$(command zsh "$PICK" --tenant "$tenant" --dry-run --explain 2>&1 >/dev/null)"
pline=""
for l in "${(@f)pickout}"; do
  [[ "$l" == *pool:* ]] && { pline="${l#*pool:}"; break }
done
typeset -a pmem
pmem=( ${=pline} )
if (( ${pmem[(Ie)$name]} )); then
  say "the picker sees '$name' in '$tenant'"
else
  rc=3
  pickwarn="'$name' IS in the pool of '$tenant', but the picker's dry run does not list it (pool:${pline:- <no pool line>}); check: claude-pick --tenant $tenant --explain --dry-run"
fi

# ---- what is left for a person ---------------------------------------------------------------------
step done "'$name' is in '$tenant'. Left for you:"
say "  1. Plugin MCP sign-ins: $prog mcp $name signs it in to each plugin server the"
say "     other seats use, one browser approval each (or: claude-as $name, then /mcp)."
if [[ -n "${connectors[$tenant]-}" ]]; then
  say "  2. claude.ai connectors: ${connectors[$tenant]}. Connect them at claude.ai -> Settings"
  say "     -> Connectors, signed in to claude.ai as $name${cacct[$tenant]:+, choosing ${cacct[$tenant]} when Google asks}."
else
  say "  2. claude.ai connectors, if this tenant's sessions use any (Gmail, Calendar, Drive):"
  say "     connect them signed in to claude.ai as $name. To have this list name them, set"
  say "     CLAUDE_TENANT_CONNECTORS and CLAUDE_TENANT_CONNECTOR_ACCOUNT for '$tenant'."
fi
say "  3. A fresh seat with an empty week draws every new launch until its 5h window fills"
say "     (DO-792). claude-doctor's concurrency section shows how many it holds."
[[ -z "$pickwarn" ]] || print -u2 -- "$prog: $pickwarn"
exit $rc
