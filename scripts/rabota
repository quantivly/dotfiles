#!/usr/bin/env bash
# Entry point for the rabota CLI. Lives in dotfiles; linked to ~/.local/bin/rabota.
#
# WHY THIS PICKS AN INTERPRETER (DO-712). `rabota/rabota/config.py` imports `tomllib`, which is
# 3.11+. A bare `exec python3` therefore dies with `ModuleNotFoundError: No module named
# 'tomllib'` on any box whose `python3` is older -- measured on dev 2026-09-24: `/usr/bin/python3`
# is 3.10.12 and `python3.11` (3.11.14) is installed right beside it. A lane dispatched there could
# not call `rabota` at all. Probing is not free but it is one interpreter start (~20 ms) in the
# happy path, against a CLI whose *fastest* subcommand takes 160 ms.
#
# NOT a `tomli` fallback in config.py: `tomli` happens to be importable under 3.10 on dev, but
# nothing in this repo installs or pins it, so that fix would work by luck on one machine.
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# Newest first after `python3` itself, so a box where `python3` is current pays exactly one probe
# and a box where it is not lands on the newest interpreter it has rather than the oldest.
candidates=(python3 python3.14 python3.13 python3.12 python3.11)

py=""
for c in "${candidates[@]}"; do
    command -v "$c" >/dev/null 2>&1 || continue
    if "$c" -c 'import tomllib' >/dev/null 2>&1; then py="$c"; break; fi
done

if [ -z "$py" ]; then
    found="$(command -v python3 >/dev/null 2>&1 && python3 -V 2>&1 || echo 'no python3 on PATH')"
    printf 'rabota: needs a Python with tomllib (3.11+); none of %s has it\n' "${candidates[*]}" >&2
    printf 'rabota: the newest python3 found was: %s\n' "$found" >&2
    exit 5
fi

# One consumer, not a knob: scripts/test-rabota.sh needs the SAME interpreter this picked, and
# dev is the machine where that matters (its python3 is 3.10). Duplicating the loop there is how
# the two drift; asking for the answer keeps the picker in one place.
if [ -n "${RABOTA_PRINT_PYTHON:-}" ]; then printf '%s\n' "$py"; exit 0; fi

PYTHONPATH="$here/rabota${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m rabota "$@"
