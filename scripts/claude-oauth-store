#!/usr/bin/env bash
# scripts/claude-oauth-store
# ==========================
#
# Store a long-lived Claude Code token (from `claude setup-token`) on a shared
# agent host, so its sessions stop refreshing one shared login.
#
# WHY. Every Claude session on dev uses the one `/login` in ~/.claude/.credentials.json.
# Refresh tokens rotate, so when several sessions start within minutes one of them
# refreshes with a superseded token and every session on the account logs out at
# once. That happened on 2026-10-14 (claudeAiOauth.expiresAt zeroed at 07:37 EDT).
# A setup-token token lives a year and is never refreshed, and CLAUDE_CODE_OAUTH_TOKEN
# outranks the stored login, so there is nothing left to race.
#
# RUN IT YOURSELF, in a plain terminal. Not in a herdr pane an agent can read, and
# not as `!` inside a Claude session: the token would land in that transcript.
#   ssh -t dev '~/.local/bin/claude setup-token && ~/.dotfiles/scripts/claude-oauth-store'
# then clear that terminal's scrollback, where setup-token printed the token.
#
# WHAT IT WRITES, in ~/.config/claude-oauth/ (mode 700):
#   token.env  CLAUDE_CODE_OAUTH_TOKEN=<token>, mode 600. One KEY=VALUE line, so the
#              same file is a systemd EnvironmentFile= (rabota lanes), a line the
#              herdr launcher and zshrc.company read, and dev-sync's check.
#   created    the date it was stored, YYYY-MM-DD. Not secret: dev-sync reads it to
#              warn before the token's year runs out.
#   .lock      taken only after the `claude -p` check has exited, and held for the write and
#              the rename alone, so no child of this script can carry it (dev-sync's lock, 10-17).
# In the SEAT LAYOUT token.env is a link to seats/<seat>.env. Then it renews that seat: the
# token goes to seats/<seat>.env and the date to seats/<seat>.created, by temp file and rename,
# and the link stays. Replacing the link with a file would strand the old token in seats/. A link
# to anything but seats/<seat>.env is refused before the prompt.
# The token is read at a hidden prompt and never echoed or logged. Input ends at an empty line,
# so a paste wrapped across lines is joined back together, and the token must answer one
# `claude -p` before anything is written.
#
# REFUSES on a machine where clauth manages accounts. There every session picks its
# own account dir, and this token would outrank all of them, so every session on the
# laptop would bill this one seat.
#
# Usage: claude-oauth-store
# Exit: 0 stored · 1 refused or not stored · 64 usage

set -euo pipefail

DIR="$HOME/.config/claude-oauth"
TOKEN_FILE="$DIR/token.env"
# setup-token's shape. The character class is also what makes the file safe to read as
# shell and as an EnvironmentFile= without quoting.
TOKEN_RE='^sk-ant-oat[0-9]+-[A-Za-z0-9_-]{20,}$'
# A seat's name. A CONSTANT, never read from the environment; dev-sync spells the same string, and
# a row in scripts/test-dev-sync.sh checks that they agree.
SEAT_RE='^quantivly-[a-z0-9][a-z0-9-]{0,30}$'

die() { printf 'claude-oauth-store: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
    "") ;;
    -h | --help) sed -n '/^# Usage:/p' "$0" | sed 's/^# //'; exit 0 ;;
    *) printf 'usage: claude-oauth-store\n' >&2; exit 64 ;;
esac

if [[ -d "$HOME/.clauth" ]] || command -v clauth >/dev/null 2>&1; then
    die "refusing: clauth manages Claude accounts here, and this token would outrank every account dir. It is for a host on one login (dev)."
fi
[[ -t 0 ]] || die "refusing: stdin is not a terminal. Run it with ssh -t, and paste at the prompt; never pipe the token in."
command -v flock >/dev/null 2>&1 || die "refusing: flock (util-linux) is not installed here. Nothing was read."

# Where the token goes: token.env itself, or, through a link, the seat it names.
target="$TOKEN_FILE"
date_file="$DIR/created"
if [[ -L "$TOKEN_FILE" ]]; then
    link="$(readlink "$TOKEN_FILE")"
    seat="${link#seats/}"; seat="${seat%.env}"
    [[ "$link" == "seats/$seat.env" && "$seat" =~ $SEAT_RE ]] ||
        die "refusing: $TOKEN_FILE links to ${link//[^A-Za-z0-9._\/-]/?}, which is not a seat (seats/<name>.env, <name> like quantivly-5). Nothing was read."
    target="$DIR/seats/$seat.env"
    date_file="$DIR/seats/$seat.created"
fi

printf 'Paste the token claude setup-token printed (input hidden), press Enter, then Enter again: ' >&2
# setup-token wraps a long token across lines, and a copy keeps the breaks. Reading one line
# stored a cut token on 2026-10-14 (65 characters of it), which passed the shape check below and
# failed every request. So read lines and join them until an empty one. Not "whatever arrives
# within a moment": a terminal hands over a line only at Enter, so the last piece of a paste
# waits for the person's own Enter, however late.
token=""
for _ in 1 2 3 4 5 6 7 8; do
    line=""
    IFS= read -rs line || { token+="${line//[[:space:]]/}"; break; }
    line="${line//[[:space:]]/}"
    [[ -n "$line" ]] || break
    token+="$line"
done
line=""
printf '\n' >&2
token="${token//[[:space:]]/}"
if [[ ! "$token" =~ $TOKEN_RE ]]; then
    n=${#token}; token=""
    die "that does not look like a setup-token token (sk-ant-oat…, $n characters read). Nothing was written."
fi

# The shape cannot tell a whole token from a cut one, so ask the API before writing anything.
# --no-session-persistence leaves no transcript; --strict-mcp-config starts no MCP server, so
# nothing writes ~/.claude/.credentials.json.
claude_bin="$(command -v claude || true)"
[[ -n "$claude_bin" ]] || claude_bin="$HOME/.local/bin/claude"
[[ -x "$claude_bin" ]] || { token=""; die "cannot check the token: claude is not installed here. Nothing was written."; }
printf 'Checking it with one request...\n' >&2
probe_dir="$(mktemp -d)"
probe_rc=0
probe="$(cd "$probe_dir" && CLAUDE_CODE_OAUTH_TOKEN="$token" timeout 120 "$claude_bin" -p 'Reply with exactly: OK' \
    --model haiku --output-format json --no-session-persistence --strict-mcp-config 2>/dev/null)" || probe_rc=$?
rmdir "$probe_dir" 2>/dev/null || true
if (( probe_rc != 0 )) || [[ "$probe" != *'"is_error":false'* ]]; then
    n=${#token}; token=""
    why="$(printf '%s' "$probe" | sed -n 's/.*"result":"\([^"]\{0,200\}\).*/\1/p')"
    die "the API refused it (${why:-no answer, exit $probe_rc}; $n characters read). Nothing was written. If it was cut, widen the terminal so the token prints on one line, and mint again."
fi

umask 077
mkdir -p "$DIR"
chmod 700 "$DIR"
# The lock, only now that the probe child has exited: a child that daemonizes keeps every fd it
# inherited, and with it a flock, which is how dev-sync's lock was lost from 10-17 to 11-03.
exec 9>"$DIR/.lock"
flock -n 9 || { token=""; die "another claude-oauth-store run holds $DIR/.lock. Nothing was written; run this again once it ends."; }
# The temp file sits beside its target, so the rename stays in one directory (seats/ for a link).
mkdir -p "$(dirname "$target")"
chmod 700 "$(dirname "$target")"
tmp="$(mktemp "$(dirname "$target")/.token.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$token" >"$tmp"
token=""
mv -f "$tmp" "$target"
date +%F >"$date_file"
exec 9>&-

printf 'Stored in %s (mode %s), dated %s.\n' "$target" "$(stat -c %a "$target")" "$(cat "$date_file")"
printf 'New shells, rabota lanes and dev-sync use it now. Sessions already running keep the old login\n'
printf 'until they restart; herdr panes get it from their shell, and the server itself at its next start.\n'
printf 'Check from the laptop: ~/.dotfiles/scripts/dev-sync --check\n'
