#!/usr/bin/env zsh
#
# scripts/machines-render
# =======================
#
# THE MACHINE REGISTRY, rendered once from the one place it is written down.
#
# "Which machine owns which clauth seat" used to be declared twice: as
# `CLAUDE_TENANT_MACHINE_OWNED` (profile -> a human label) in the tenants file,
# and as `[machines.<m>].profile` (machine id -> profile) in rabota's tenant
# TOML. Two files, two formats, two languages, nothing checking they agree —
# and divergence is silent in both directions: reassign a seat in one and the
# other goes on gating the seat that machine no longer bills. DO-665.
#
# WHICH COPY SURVIVED, and why that direction. The tenants file is canonical
# because a stale copy there fails OPEN and SILENTLY: `claude-profile-foreign`
# reads an empty table as "no machine owns anything" and the DO-632/DO-641
# guards simply stop refusing, with nothing said. rabota fails loudly by
# comparison — a missing seat is a `Refused` naming the file. So the hand-edited
# copy stays on the side whose staleness nobody would notice, and rabota asks
# for the answer instead of keeping one.
#
# AND NOTHING IS GENERATED. There is no rendered file to go stale, because a
# rendered file is exactly the failure this change exists to remove, one level
# down. This prints on demand and rabota calls it, the way `rabota doctor`
# already shells out to `claude-pick`.
#
# THE FORK IS THE MECHANISM, and it is `claude-tenants-owner`'s exactly (see
# zsh/zshrc.herdr): a bare `zsh -f` that declares the arrays, sources the
# tenants file at TOP LEVEL and prints. A tenants file may spell its tables as a
# plain assignment, `typeset -A` or `typeset -gA`, and only a top-level source
# makes all three behave alike — inside a function, a file's own `typeset -A`
# creates a function-local that dies at return, and every table reads empty.
# The same constraint binds the file itself: self-contained, no functions,
# nothing printed. A `has_command jq && ...` guard in there reads EMPTY here.
#
# Usage:
#   machines-render            JSON, machine id -> {profile, label}
#   machines-render --check    validate only; print nothing on success
#
# Exit: 0 rendered (possibly `{}`) · 1 the two tables disagree · 2 the tenants
#       file could not be read · 64 usage.
#
# AN EMPTY REGISTRY IS NOT AN ERROR. A modular adopter has no tenants file and
# no machines, and `{}` is the true answer for them; an unreadable file that
# EXISTS is a different thing and exits 2. Collapsing those two is how a
# misconfiguration would come back as "this machine owns nothing", which is the
# fail-open direction again.

emit_usage() {
  print -u2 -- "usage: machines-render [--check]"
  exit 64
}

check_only=0
case "${1:-}" in
  "")       ;;
  --check)  check_only=1 ;;
  *)        emit_usage ;;
esac
(( $# > 1 )) && emit_usage

TENANTS="${CLAUDE_TENANTS_FILE:-$HOME/.config/claude-tenants.zsh}"

# A SYMLINK WHOSE TARGET IS GONE is not "no tenants file". `-e` follows the link,
# so a broken one answers the modular adopter's question instead of its own —
# and a broken link is what a mid-deploy checkout or a removed worktree leaves
# behind, i.e. a state that arrives by accident and reads as a choice.
if [[ -L "$TENANTS" && ! -e "$TENANTS" ]]; then
  print -u2 -- "machines-render: $TENANTS is a symlink whose target does not exist"
  exit 2
fi
# No tenants file at all is the modular adopter: an empty registry, exit 0.
if [[ ! -e "$TENANTS" ]]; then
  (( check_only )) || print -r -- "{}"
  exit 0
fi
# One that exists but cannot be USED is a fault, and must not read as "empty".
# `-f` rather than `-e`: a DIRECTORY passes both -e and -r, `source` fails on it,
# and the registry came back `{}` with exit 0 — an empty answer from a path that
# was never a tenants file.
if [[ ! -f "$TENANTS" ]]; then
  print -u2 -- "machines-render: $TENANTS is not a regular file"
  exit 2
fi
if [[ ! -r "$TENANTS" ]]; then
  print -u2 -- "machines-render: cannot read $TENANTS"
  exit 2
fi
# IT MUST PARSE, checked before it is sourced. This is the discriminator the
# fork cannot supply: `source` on a file with a syntax error fails, execution
# CONTINUES in the forked shell, and the tables are simply empty — so a single
# unbalanced quote in the canonical file rendered `{}` with exit 0, and --check
# passed it. The source's STATUS cannot tell these apart either: it is the status
# of the file's last command, which is why claude-tenants-owner ignores it (a
# tenants file ending in a false command is legitimate). `zsh -n` separates the
# two questions — does it parse, and what did it return — and only the first is
# a fault.
if ! zsh_n_err="$(command zsh -n "$TENANTS" 2>&1)"; then
  print -u2 -- "machines-render: $TENANTS does not parse, so nothing in it ran:"
  print -u2 -- "    ${zsh_n_err:-zsh -n failed with no message}"
  print -u2 -- "    Check it yourself with: zsh -n $TENANTS"
  exit 2
fi

# MARKED output, and the source's exit status ignored — both are failure modes
# `claude-tenants-owner` already paid for (2026-09-20): a tenants file ending in
# a false command made `|| exit` report "no owner", and a stray `print` in that
# file BECAME the data. Marking every line lets a stray one be dropped rather
# than parsed. stdin is closed: a file that reads would eat the caller's.
# EVERY TABLE THE TENANTS FILE MAY ASSIGN IS PRE-DECLARED, not just the two read
# here. A tenants file that writes `CLAUDE_TENANT_POOL[work]=...` — the subscript
# form, valid everywhere else because zshrc.herdr declares that name `-gA` before
# sourcing — would otherwise raise "assignment to invalid subscript range", abort
# the source at that line, and hand back an empty registry. The declaration list
# is zshrc.herdr's, plus the one this file adds.
#
# `__DONE__` IS NOT THE PARSE CHECK — `zsh -n` above is, and the distinction is
# worth stating because the obvious reading is wrong: a `source` that fails to
# parse returns to the forked shell, which then runs the loops over empty tables
# and prints the sentinel quite happily. Measured. What the sentinel does catch is
# the fork not completing AT ALL — no zsh on PATH, the process killed, output
# truncated — where the difference between "nothing was declared" and "nothing
# was read" is again `{}` versus an error.
#
# WHAT NEITHER CATCHES, stated rather than implied: a tenants file that ends
# early SILENTLY — a `return`, or a guard like `[[ -n "$UNSET" ]] && TABLE=( … )`
# — parses, completes, and declares nothing. That is the fail-open the tenants-file
# contract in zsh/zshrc.herdr already forbids in prose — self-contained, plain
# assignments — and no reader here can distinguish it from an honestly empty file.
#
# `has_command jq && TABLE=( … )` USED TO BE LISTED HERE and does not belong: it
# is a command not found in a bare `zsh -f`, so it writes to the fork's stderr and
# the guard below catches it (measured, exit 2, DO-674). The undetectable set is
# only the shapes that are SILENT.
fork_err="$(command mktemp)" || { print -u2 -- "machines-render: could not create a temp file"; exit 2 }
raw="$(command zsh -f -c '
  typeset -ga CLAUDE_TENANT_ROUTES CLAUDE_TENANT_PATH_ROUTES CLAUDE_TENANT_BUCKETS
  typeset -gA CLAUDE_TENANT_POOL CLAUDE_TENANT_OVERFLOW CLAUDE_TENANT_GH_DIR \
              CLAUDE_TENANT_MACHINE_OWNED CLAUDE_TENANT_MACHINE_ID
  source "$1"
  for p in "${(@k)CLAUDE_TENANT_MACHINE_OWNED}"; do
    v="${CLAUDE_TENANT_MACHINE_OWNED[$p]}"
    # A tab or a newline would be re-split downstream and silently truncate the
    # field, or synthesise a marker line and invent a machine. Refused rather
    # than mangled. THE KEY IS CHECKED TOO: a profile name is likelier to be
    # clean, but an unchecked one does the exact thing the value check exists to
    # prevent, and does it with exit 0. `__BADKEY__` carries no payload, because
    # a key containing a tab cannot be reported through a tab-delimited line.
    [[ "$p" == *$'"'"'\t'"'"'* || "$p" == *$'"'"'\n'"'"'* ]] && print -r -- "__BADKEY__" && continue
    [[ "$v" == *$'"'"'\t'"'"'* || "$v" == *$'"'"'\n'"'"'* ]] && print -r -- "__BAD__$p" && continue
    print -r -- "__OWNED__$p"$'"'"'\t'"'"'"$v"
  done
  for p in "${(@k)CLAUDE_TENANT_MACHINE_ID}"; do
    v="${CLAUDE_TENANT_MACHINE_ID[$p]}"
    [[ "$p" == *$'"'"'\t'"'"'* || "$p" == *$'"'"'\n'"'"'* ]] && print -r -- "__BADKEY__" && continue
    [[ "$v" == *$'"'"'\t'"'"'* || "$v" == *$'"'"'\n'"'"'* ]] && print -r -- "__BAD__$p" && continue
    print -r -- "__ID__$p"$'"'"'\t'"'"'"$v"
  done
  print -r -- "__DONE__"' machines-render "$TENANTS" </dev/null 2>"$fork_err")"
fork_err_text="$(< "$fork_err")"
command rm -f "$fork_err"

# ANY STDERR FROM THE FORK IS A FAULT, and this is the guard that covers the
# CLASS rather than a list of shapes. The forked shell does nothing but declare,
# source and print, so every byte on its stderr came from the tenants file —
# and a command in that file failing at RUN time is the way the tables end up
# empty that neither `zsh -n` (it parses) nor the source's status (it is the
# file's last command) nor the sentinel (it still prints) can see.
#
# Three shapes were measured reaching `{}` with exit 0 before this, each found
# separately, which is what argued for a class-wide guard instead of a fourth
# special case:
#   * CRLF line endings — every line becomes `ARR=( … ) ^M`, a COMMAND-LOCAL
#     assignment for a command named ^M that does not exist. Valid syntax, so
#     `zsh -n` passes it, and no editor shows it.
#   * a UTF-8 BOM, which makes line 1 a command with an invisible name.
#   * a subscript assignment to a table this fork does not pre-declare, i.e. the
#     original defect for any CLAUDE_TENANT_* name added after today. The
#     pre-declaration list below is a convenience that avoids refusing a file
#     that is fine; this is what stops a missing name being SILENT.
#
# A legitimate tenants file is silent here: measured 0 bytes for the real file,
# for a file ending in a false command (which must keep working), and for every
# fixture in the state table. The contract that file already carries — self
# contained, nothing printed — is what makes that true.
if [[ -n "$fork_err_text" ]]; then
  print -u2 -- "machines-render: $TENANTS did not run cleanly, so the registry it declares is not trustworthy:"
  # fd 1, not fd 2, into the pipe: `print -u2 … | sed` hands sed an empty stdin
  # and the indent silently does nothing (DO-674).
  print -r -- "${fork_err_text}" | command sed 's/^/    /' >&2
  print -u2 -- "    A tenants file must be self-contained and silent. Check for CRLF line endings"
  print -u2 -- "    (file \"$TENANTS\"), a byte-order mark, or an assignment to a table this renderer"
  print -u2 -- "    does not declare."
  exit 2
fi

if [[ $'\n'"$raw"$'\n' != *$'\n'__DONE__$'\n'* ]]; then
  print -u2 -- "machines-render: reading $TENANTS did not finish — the shell doing it never reported back."
  print -u2 -- "    A parse error, an unreadable path and a run-time failure are all caught earlier,"
  print -u2 -- "    so what lands here is the read being cut short: no zsh on PATH, the process"
  print -u2 -- "    killed, or its output truncated."
  exit 2
fi

typeset -A owned ids
typeset -a bad_labels
typeset bad_keys=0
typeset line key val
while IFS= read -r line; do
  case "$line" in
    __OWNED__*) key="${line#__OWNED__}"
                # A marker line ALWAYS carries a tab; without this test a
                # truncated one sets value = key, which is how a dropped line
                # became an invented machine rather than a missing one.
                if [[ "$key" == *$'\t'* ]]; then val="${key#*$'\t'}"; key="${key%%$'\t'*}"
                else val=""; fi
                owned[$key]="$val" ;;
    __ID__*)    key="${line#__ID__}"
                if [[ "$key" == *$'\t'* ]]; then val="${key#*$'\t'}"; key="${key%%$'\t'*}"
                else val=""; fi
                ids[$key]="$val" ;;
    __BAD__*)   bad_labels+=("${line#__BAD__}") ;;
    __BADKEY__) bad_keys=1 ;;
  esac
done <<< "$raw"

# THE CROSS-CHECK IS THE POINT, not the rendering. Each of these is a way the
# two halves of one fact drift apart inside the canonical file itself, and each
# would otherwise surface as a machine silently having no seat.
typeset -a faults
typeset p m
typeset -A seen_machine
# REPORTED ALONE, and before the cross-check. A rejected value is dropped from
# `owned`/`ids`, so the cross-check below would then also report it as unowned or
# unnamed — a derived complaint printed beside its own cause, which is how a
# reader ends up fixing the wrong line.
if (( bad_keys )); then
  print -u2 -- "machines-render: a profile name in $TENANTS contains a tab or a newline."
  print -u2 -- "    A profile name is an identifier; neither belongs in one, and both would"
  print -u2 -- "    silently split the registry rather than fail."
  exit 1
fi
if (( ${#bad_labels} )); then
  print -u2 -- "machines-render: the machine registry in $TENANTS has an unusable value:"
  for p in "${bad_labels[@]}"; do
    print -u2 -- "    the value for '$p' contains a tab or a newline; it is display text and neither belongs in one"
  done
  exit 1
fi
# AN ENTIRELY EMPTY _MACHINE_ID IS "NOT ADOPTED", NOT DRIFT. A tenants file that
# declares owners and no machine ids is every pre-DO-665 file, and the honest
# answer for it is an empty registry: no machine is declared, so rabota refuses a
# remote lane by name. Treating it as a fault instead would make EVERY rabota
# command exit 2 — including `rabota doctor`, the tool you would reach for to
# find out why. A PARTIAL table is the real drift and still refuses below.
if (( ${#ids} )); then
  for p in "${(@k)owned}"; do
    if [[ -z "${ids[$p]:-}" ]]; then
      faults+=("profile '$p' is owned by ${owned[$p]} but CLAUDE_TENANT_MACHINE_ID names no machine for it")
    fi
  done
fi
for p in "${(@k)ids}"; do
  m="${ids[$p]}"
  if [[ -z "${owned[$p]:-}" ]]; then
    faults+=("CLAUDE_TENANT_MACHINE_ID maps '$p' to machine '$m', but CLAUDE_TENANT_MACHINE_OWNED does not own '$p'")
  fi
  if [[ -n "${seen_machine[$m]:-}" ]]; then
    faults+=("machine '$m' is claimed by two profiles ('${seen_machine[$m]}' and '$p') — a machine bills one seat")
  fi
  seen_machine[$m]="$p"
done

if (( ${#faults} )); then
  print -u2 -- "machines-render: the machine registry in $TENANTS is inconsistent:"
  for m in "${faults[@]}"; do print -u2 -- "    $m"; done
  exit 1
fi

(( check_only )) && exit 0

# jq builds the document from typed pieces, never string concatenation: a label
# is data, and one apostrophe in "nanoclaw (Zvi's box)" would be the difference
# between a document and a syntax error.
if (( ! ${#ids} )); then
  print -r -- "{}"
  exit 0
fi
{
  for p in "${(@k)ids}"; do
    print -r -- "${ids[$p]}"$'\t'"$p"$'\t'"${owned[$p]}"
  done
} | command jq -R -s '
    split("\n") | map(select(length > 0)) | map(split("\t"))
    | map({key: .[0], value: {profile: .[1], label: .[2]}}) | from_entries'
