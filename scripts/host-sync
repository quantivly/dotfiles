#!/usr/bin/env bash
#
# scripts/host-sync
# ================
#
# Keep dev's tooling level with the laptop's: dotfiles, Claude Code, herdr and
# herdr-draft and the skills generated from them, the Claude plugins its settings
# declare, and the ~/quantivly clones.
#
# WHY. dev (the team EC2) sat unused from 2026-09-28, partly because nothing kept
# it current: on 2026-10-12 it was 73 dotfiles commits and 24 Claude Code
# releases behind, herdr-draft was 11 commits behind, Slack, linear-key and
# quantivly-conventions were missing, and its clones were last fetched 09-16.
# Every fix was a one-off by hand, so the drift came back.
#
# TWO HALVES, ONE FILE. Run from the laptop, this collects the laptop's facts
# (its Claude Code and herdr versions, its herdr binary's sha256, its list of
# ~/quantivly clones) and pipes ITSELF to dev as `bash -s -- --here …`, so the
# logic that acts on dev runs on dev. `--here` without those facts is what dev's
# own daily timer (systemd/host-sync.timer) runs. It needs no laptop state:
# dotfiles go to origin/main, Claude Code to the `latest` channel (which the
# laptop's auto-updater follows), herdr-draft to its main (from both paths, so
# the two never undo each other), and only the clones dev already has are
# fetched. Adding a clone dev lacks and upgrading herdr are the things only a
# laptop run does.
#
# A TIMER ON DEV, NOT ON THE LAPTOP. A laptop timer needs a laptop that is awake
# and an SSM credential that is valid (`dev-link-doctor` answers both), and this
# laptop is often asleep or suspended. The dev timer needs neither. It reaches
# GitHub with gh's file-based token, which has been proven for headless units on
# dev (docs/HERDR_GUIDE.md, "Working on dev"). It runs daily rather than weekly
# because a run with nothing to do is a few `git ls-remote`s: every step is
# gated on drift, so a quiet day changes nothing.
#
# DEV IS SHARED. It runs the team's platform stack, and an OOM there is a team
# outage. So every mutating step runs inside agents.slice, with its own
# MemoryMax and CPUQuota and at nice 10. From the laptop that is a transient
# scope (`systemd-run --user --scope`); from the timer it is the unit's own
# Slice=. Nothing here touches Docker or runs `git config` (on dev, ~/.gitconfig
# is a symlink into the tracked, public gitconfig), and the herdr server is
# restarted only when every pane on it is idle at a shell prompt.
#
# WHAT IT WILL NOT DO, AND REPORTS INSTEAD (⚠ rows, for the operator):
#   - sign in to an OAuth MCP server (Slack, Notion). That is an interactive
#     `/mcp` on dev, and no credential passes through here.
#   - put LINEAR_API_KEY on dev. It is checked by name only, and its value is
#     never read out.
#   - move a dotfiles checkout that is not on main, has diverged, or has local
#     edits to a file origin/main also changes.
#   - replace a herdr-draft that is LINKED from a local checkout, or touch a
#     ~/quantivly directory whose origin is a different repository.
#   - upgrade herdr while an agent runs on dev, or while any pane is running
#     something rather than sitting at its shell prompt. A restart closes every
#     pane, and a test run or an editor in a plain pane is not an agent. The row
#     says what is busy, and the upgrade waits; the binary is not swapped either,
#     so the CLI never runs ahead of its server.
#   - stop abandoned login-session scopes (they need sudo); it lists this user's
#     scopes over 200 MB, with a command naming exactly those.
#   - mint or store the long-lived Claude token. A person runs `claude setup-token`
#     and scripts/claude-oauth-store on dev; this reads only the file's mode, its
#     shape and its date, and loads it for its own `claude` calls.
#   - repoint ~/.ssh/ssh_auth_sock. It reports where the link goes (dev's own agent,
#     dangling, or an agent FORWARDED from the laptop, which it never probes) and
#     how fast `ssh-add -l` answers, bounded to 1 s. The shell repairs the link.
#   - write agents.slice. Its cap is set on dev with `systemctl --user
#     set-property` (drop-ins under ~/.config/systemd/user.control/), and the
#     effective values are shown as information.
#   - add a source a checkout's install.conf.yaml declares but does not carry.
#     Every other link out of place is drift that repo's ./install fixes.
#   - enable or disable a Claude plugin, or install one whose marketplace no settings
#     fragment declares. settings.json declares the plugins (H4) and the render owns
#     enablement; host-sync installs what it sets true, and nothing else.
#
# THE HOST PROFILE (shared-configuration design, H1). ~/.config/claude-host-profile, the
# settings renderer's marker, names this host's profile, and the private overlay's
# hosts/<profile>.json lists its tenants. With the marker, the overlay (~/.dotfiles-local) is
# cloned BEFORE the public ./install, which renders settings from it and refuses a marker with no
# overlay, and is then kept on origin/main exactly as ~/.dotfiles is. Without it, no overlay row
# runs. The ~/quantivly clones are skipped only when the tenants are known and leave out the work
# tenant: a host whose overlay is not cloned yet goes on fetching them. Where clauth manages the
# Claude accounts (~/.clauth), the long-lived-token rows do not apply (H9). With a profile,
# settings.json is the renderer's (scripts/claude-settings-render.sh); on every host, the links both
# checkouts declare are checked by scripts/check-links.sh (H8).
#
# Usage (the controlling host, usually the laptop):
#   host-sync --host <ssh alias> [--check]     report drift on <host>; changes nothing (default)
#   host-sync --host <ssh alias> --apply       bring <host> level, then report; arms its timer
#   host-sync --host <ssh alias> --print-facts print what would be sent to <host>, and exit
# Usage (on the host itself; the timer's form; --here must come first):
#   host-sync --here [--check|--apply] [--no-mcp]
#
# Exit: 0 nothing for host-sync to fix (⚠ operator steps may still be listed)
#       1 drift remains (in --check: what --apply would fix; in --apply: a fix failed)
#       2 could not run (the host unreachable, another run holds the lock, not armed, killed)
#       64 usage
#
# Rows: ✓ level · ✗ drift --apply fixes · ⚠ needs a person · · information
#
# Test overrides (scripts/test-host-sync.sh): HOST_SYNC_GITHUB_BASE, HOST_SYNC_NPM_URL,
# HOST_SYNC_HERDR_RELEASES, HOST_SYNC_DOTFILES_REMOTE, HOST_SYNC_DOTFILES_LOCAL_REMOTE (the
# laptop's ls-remote of the overlay), HOST_SYNC_DOTFILES_LOCAL_REPO (its owner/repo, cloned from
# HOST_SYNC_GITHUB_BASE), CLAUDE_SETTINGS_RENDER_MARKER (the renderer's own name for the profile
# marker), HOST_SYNC_NO_SCOPE=1 (skip the systemd-run wrapper), HOST_SYNC_SSH (the ssh command),
# HOST_SYNC_PROC (/proc), HOST_SYNC_TOKEN_WARN_D.

set -uo pipefail

# --- what "level" means for the work tenant ---------------------------------------------------

WORK_ORG="quantivly"                 # ~/quantivly clones of this org are synced
WORK_TENANT="quantivly"              # the profile tenant those clones serve
DRAFT_REPO="ZviBaratz/herdr-draft"
# The private overlay: owner/repo, cloned from GITHUB_BASE with the host's own git credentials.
DOTFILES_LOCAL_REPO="${HOST_SYNC_DOTFILES_LOCAL_REPO:-ZviBaratz/dotfiles-local}"
DRAFT_ID="zvibaratz.draft"
# herdr-draft's binary, relative to the plugin root this host's `herdr plugin list` reports.
DRAFT_BINARY_RELATIVE="bin/herdr-draft"

# The plugin declaration is the live settings.json (shared-configuration design, H4), rendered
# from the fragments on a host with a profile: its enabledPlugins entries that are true, and its
# extraKnownMarketplaces, with the official marketplace implicit (name=`marketplace add` source).
# The render owns enablement, so host-sync adds and refreshes marketplaces and installs plugins,
# and never enables or disables one.
OFFICIAL_MARKETPLACE="claude-plugins-official=anthropics/claude-plugins-official"
# The one plugin host-sync updates: the checkout's own directory marketplace carries its version
# (docs/CLAUDE_SETUP.md, "Linear: one API key").
LINEAR_KEY="linear-key@dotfiles"

GITHUB_BASE="${HOST_SYNC_GITHUB_BASE:-https://github.com}"
HERDR_RELEASES="${HOST_SYNC_HERDR_RELEASES:-https://github.com/herdrdev/herdr/releases/download}"
NPM_LATEST_URL="${HOST_SYNC_NPM_URL:-https://registry.npmjs.org/@anthropic-ai/claude-code/latest}"
# A clone is drift once its last fetch is older than FETCH_MAX_AGE_H, and --apply refreshes
# anything older than FETCH_REFRESH_H. The gap absorbs the daily timer's half-hour jitter: one
# threshold equal to the period read a level dev as drifted about every other afternoon.
FETCH_MAX_AGE_H="${HOST_SYNC_FETCH_MAX_AGE_H:-36}"
FETCH_REFRESH_H="${HOST_SYNC_FETCH_REFRESH_H:-20}"
MARKET_MAX_AGE_D="${HOST_SYNC_MARKET_MAX_AGE_D:-7}"
SCOPE_MIN_MB="${HOST_SYNC_SCOPE_MIN_MB:-200}"
# A setup-token token lives a year (code.claude.com/docs/en/authentication). Warn a month ahead.
TOKEN_LIFE_D=365
TOKEN_WARN_D="${HOST_SYNC_TOKEN_WARN_D:-335}"
PROC="${HOST_SYNC_PROC:-/proc}"

# The directory the armed / disarmed markers live in. The daily timer's marker is what makes
# --apply allowed on a machine (a laptop is never armed).
MARKER_DIR="$HOME/.config/host-sync"
STATE_DIR="$HOME/.local/state/host-sync"
# Before the rename (shared-configuration design, D8 / H2) the marker, the state and the timer
# were dev-sync's. A host on that release is still armed by its marker, and its first --apply
# moves all three (here_main, here_timer).
LEGACY_MARKER_DIR="$HOME/.config/dev-sync"
LEGACY_STATE_DIR="$HOME/.local/state/dev-sync"
TIMER_UNIT="host-sync.timer"
LEGACY_TIMER_UNIT="dev-sync.timer"
USER_UNIT_DIR="$HOME/.config/systemd/user"
WANTS_DIR="$USER_UNIT_DIR/default.target.wants"
# The private overlay's checkout, on the host and on the laptop alike.
DOTFILES_LOCAL="$HOME/.dotfiles-local"
# The host profile's marker: the settings renderer's, read through its own override, so one
# variable moves every script that reads it. Its first line names the profile; the name rule is
# the renderer's, verbatim.
PROFILE_MARKER="${CLAUDE_SETTINGS_RENDER_MARKER:-$HOME/.config/claude-host-profile}"
PROFILE_NAME_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
# Where clauth manages the Claude accounts (claude-oauth-store and zshrc.company read the same dir).
CLAUTH_DIR="$HOME/.clauth"
# The skills generated from this host's own binaries, never tracked (shared-configuration design,
# D6): herdr's is what `herdr --skill` prints, spawn's what herdr-draft's `skill` prints, and the
# spawn skill bakes in that binary's absolute path, so neither can be copied from another host.
HERDR_SKILL_FILE="$HOME/.claude/skills/herdr/SKILL.md"
SPAWN_SKILL_FILE="$HOME/.claude/skills/spawn/SKILL.md"
# How long a skill generator (`herdr --skill`, `herdr-draft skill`) may run before its row says so.
SKILL_GENERATOR_TIMEOUT_SECONDS=60
GIT_NET_TIMEOUT_SECONDS=300
CLONE_TIMEOUT_SECONDS=300
# How long a sibling script (the settings renderer, the link checker) may run before its row says
# it could not run (exit 124).
SIBLING_TIMEOUT_SECONDS=120
# scripts/check-links.sh's states, by who acts on them: the ones in place, the drift the repo's
# ./install fixes, and a source the manifest names that is not in the checkout, which only a
# person can fix. Any other first field on its output is not an entry.
LINK_STATES_IN_PLACE=(ok conditional-absent)
LINK_STATES_TO_FIX=(missing wrong-target regular-identical regular-differs)
LINK_STATES_FOR_A_PERSON=(source-missing)
# The one whose content is not the repo's: ./install backs it up, and the row names that backup.
LINK_STATE_REGULAR_DIFFERS="regular-differs"
# dotbot's name for the backup of a regular file it replaces with a link (install.conf.yaml's
# `backup: true`): <path>.dotbot-backup.<YYYYMMDD-HHMMSS>, local time
# (dotbot/src/dotbot/plugins/link.py, _backup). The names sort in the order they were made.
DOTBOT_BACKUP_INFIX=".dotbot-backup."
SAFE_DIR_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'
HOST_ALIAS_RE='^[A-Za-z0-9][A-Za-z0-9._-]*$'   # an ssh alias, never an option or a path
SAFE_REPO_RE='^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$'
SHA_RE='^[0-9a-f]{40}$'
COUNT_RE='^[0-9]+$'
VER_RE='^[0-9]+(\.[0-9]+)+$'
TOKEN_LINE_RE='^CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat[0-9]+-[A-Za-z0-9_-]+$'
# A seat's name, in the seat layout (token.env a link to seats/<seat>.env). A CONSTANT, never read
# from the environment: a rule the environment could widen would let seats/../x.env through.
# claude-oauth-store spells the same string, and a row in scripts/test-host-sync.sh checks they agree.
SEAT_RE='^quantivly-[a-z0-9][a-z0-9-]{0,30}$'

usage() { sed -n '/^# Usage (the controlling host/,/^# Exit:/p' "${SELF:-/dev/null}" 2>/dev/null | sed '$d; s/^# \{0,1\}//'; }

# owner/repo from any GitHub remote URL: https://github.com/o/r(.git), git@github.com:o/r.git,
# and host aliases such as git@github-work:o/r.git. Lowercased, since GitHub is case-insensitive.
repo_of_url() {
    printf '%s\n' "$1" | sed -E 's#/+$##; s#\.git$##; s#^.*[:/]([^/:]+)/([^/:]+)$#\1/\2#' | tr '[:upper:]' '[:lower:]'
}

# ==============================================================================================
# The dev half (--here)
# ==============================================================================================

N_DRIFT=0
N_OPER=0
# What sync_checkout did with each checkout THIS run, keyed by its row area (dotfiles |
# dotfiles-local), so the links row neither runs ./install a second time nor runs it on a checkout
# that was left alone: left-alone (a ⚠ row: not a checkout, off main, ahead, diverged, overlapping
# local edits), installed or install-failed (its ./install ran; CHECKOUT_INSTALL_LOG holds the log).
declare -A CHECKOUT_THIS_RUN=() CHECKOUT_INSTALL_LOG=()
row() {   # $1 = ok|drift|oper|info, $2 = area, $3 = message
    local g
    case "$1" in
        ok) g="✓" ;;
        drift) g="✗"; N_DRIFT=$((N_DRIFT + 1)) ;;
        oper) g="⚠"; N_OPER=$((N_OPER + 1)) ;;
        *) g="·" ;;
    esac
    printf '  %s %-14s %s\n' "$g" "$2" "$3"
}
short() { printf '%s' "${1:0:7}"; }
# git against a remote: never prompts for a credential, reads no stdin, gives up after $1 seconds.
git_net_within() { local seconds="$1"; shift; GIT_TERMINAL_PROMPT=0 timeout "$seconds" git "$@" </dev/null; }
git_net() { git_net_within "$GIT_NET_TIMEOUT_SECONDS" "$@"; }
ver_ge() { [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n 1)" == "$1" ]]; }
json_get() { jq -r "$2" "$1" 2>/dev/null; }

# ----------------------------------------------------------------------------------------------
# The host profile, and the checkouts this host keeps on origin/main
# ----------------------------------------------------------------------------------------------

# Read the host profile: the marker's first line names it, and the overlay's hosts/<name>.json
# lists its tenants. Sets PROFILE (the name, only once it passes the renderer's rule),
# PROFILE_FILE, TENANTS, TENANTS_KNOWN (1 only once that file was read) and PROFILE_FAULT (why the
# marker or the file cannot be used). No marker leaves all of them empty. The marker's content is
# never printed: a name is shown only once it has passed the rule.
read_profile() {
    local name=""
    PROFILE=""; PROFILE_FILE=""; PROFILE_FAULT=""; TENANTS=(); TENANTS_KNOWN=0
    [[ -f "$PROFILE_MARKER" ]] || return 0
    if [[ ! -r "$PROFILE_MARKER" ]]; then
        PROFILE_FAULT="the marker $(tilde_path "$PROFILE_MARKER") is not readable by $(id -un)"
        return 0
    fi
    IFS= read -r name <"$PROFILE_MARKER"
    if [[ ! "$name" =~ $PROFILE_NAME_RE ]]; then
        PROFILE_FAULT="the marker holds an unusable profile name (the renderer's rule: letters, digits, dots, dashes and underscores)"
        return 0
    fi
    PROFILE="$name"
    PROFILE_FILE="$DOTFILES_LOCAL/hosts/$PROFILE.json"
    [[ -d "$DOTFILES_LOCAL" ]] || return 0   # tenants unknown until the overlay is cloned
    if [[ ! -e "$PROFILE_FILE" ]]; then
        PROFILE_FAULT="no hosts/$PROFILE.json in $(tilde_path "$DOTFILES_LOCAL")"
        return 0
    fi
    if ! jq -e '.tenants | type == "array" and all(type == "string")' "$PROFILE_FILE" >/dev/null 2>&1; then
        PROFILE_FAULT="hosts/$PROFILE.json in $(tilde_path "$DOTFILES_LOCAL") cannot be read, or has no .tenants list of names"
        return 0
    fi
    mapfile -t TENANTS < <(jq -r '.tenants[]' "$PROFILE_FILE" 2>/dev/null)
    TENANTS_KNOWN=1
}
has_tenant() {   # $1 = a tenant name; 0 when the host profile lists it
    local tenant
    for tenant in ${TENANTS[@]+"${TENANTS[@]}"}; do
        [[ "$tenant" == "$1" ]] && return 0
    done
    return 1
}
# True only when the tenants are KNOWN and $1 is not among them. A host whose profile cannot be
# read yet keeps every tenant-gated row: its work clones go on being fetched.
tenants_exclude() { (( TENANTS_KNOWN )) && ! has_tenant "$1"; }

# The overlay's clone, and only that: with a profile named and no ~/.dotfiles-local. It runs before
# the public ./install, which renders settings from the overlay and refuses (exit 2) a marker with
# no overlay, and the profile is read again after it, so this same run knows the tenants.
clone_overlay() {
    [[ -n "$PROFILE" && ! -d "$DOTFILES_LOCAL" ]] || return 0
    if [[ "$MODE" != apply ]]; then
        row drift dotfiles-local "not cloned (origin would be $DOTFILES_LOCAL_REPO)"
        return
    fi
    if git_net_within "$CLONE_TIMEOUT_SECONDS" clone --quiet "$GITHUB_BASE/$DOTFILES_LOCAL_REPO.git" "$DOTFILES_LOCAL" \
        >/dev/null 2>&1; then
        row ok dotfiles-local "cloned from $DOTFILES_LOCAL_REPO"
        read_profile
    else
        row drift dotfiles-local "git clone $DOTFILES_LOCAL_REPO failed"
    fi
}

here_dotfiles() { sync_checkout dotfiles "$DOTFILES" installed-head; }

# The overlay is managed only on a host with a profile marker (H1), usable or not, once it exists:
# its checkout row and its links row alike.
overlay_is_managed() { [[ -n "$PROFILE" || -n "$PROFILE_FAULT" ]] && [[ -d "$DOTFILES_LOCAL" ]]; }
here_dotfiles_local() {
    overlay_is_managed || return 0
    sync_checkout dotfiles-local "$DOTFILES_LOCAL" installed-head-dotfiles-local
}

here_profile() {
    local tenants_shown
    if [[ -n "$PROFILE_FAULT" ]]; then
        row oper profile "$PROFILE_FAULT"
    elif [[ -z "$PROFILE" ]]; then
        row info profile "no host profile marker ($(tilde_path "$PROFILE_MARKER")); dotfiles-local, settings, memory stores and retire are not managed here"
    elif (( TENANTS_KNOWN )); then
        tenants_shown="$(printf '%s, ' ${TENANTS[@]+"${TENANTS[@]}"})"
        row info profile "$PROFILE (tenants: ${tenants_shown%, })"
    else
        row info profile "$PROFILE: $(tilde_path "$DOTFILES_LOCAL") is not cloned yet, so its tenants are unknown until --apply clones it"
    fi
}

# Keep a checkout on origin/main: fetch (in --apply), fast-forward, refuse local edits that
# origin/main also changes, then ./install once per commit. It never clones.
# $1 = the row's area, also the name the laptop's facts are keyed by (dotfiles | dotfiles-local),
# $2 = the checkout, $3 = its install stamp's file name under $STATE.
sync_checkout() {
    local label="$1" d="$2" stamp_name="$3" branch head target src old n="" overlap
    local laptop_sha="" laptop_behind="" fix="move it aside, and --apply clones it again"
    [[ "$label" == dotfiles ]] && fix="bootstrap it (scripts/server-bootstrap.sh)"
    if ! git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
        leave_checkout_alone "$label" "$d is not a git checkout; $fix"
        return
    fi
    branch="$(git -C "$d" symbolic-ref --quiet --short HEAD 2>/dev/null)" || branch="(detached)"
    if [[ "$branch" != main ]]; then
        leave_checkout_alone "$label" "on '$branch', not main; host-sync only moves main, so it has not touched it"
        return
    fi
    case "$label" in
        dotfiles) laptop_sha="$ARG_DOTFILES_SHA"; laptop_behind="$ARG_DOTFILES_BEHIND" ;;
        dotfiles-local) laptop_sha="$ARG_DOTFILES_LOCAL_SHA"; laptop_behind="$ARG_DOTFILES_LOCAL_BEHIND" ;;
    esac

    if [[ "$MODE" == apply ]]; then
        if ! git_net -C "$d" fetch --quiet origin main; then
            row drift "$label" "git fetch origin main failed"
            return
        fi
        target="$(git -C "$d" rev-parse origin/main)"; src="origin/main"
    elif [[ -n "$laptop_sha" ]]; then
        target="$laptop_sha"; src="origin/main"
    else
        target="$(git -C "$d" rev-parse --verify --quiet origin/main)"
        src="origin/main as of this host's last fetch"
    fi
    head="$(git -C "$d" rev-parse HEAD)"; old="$head"

    if [[ "$head" != "$target" ]]; then
        if ! git -C "$d" cat-file -e "$target^{commit}" 2>/dev/null; then
            # Check mode with a laptop-supplied target this host has not fetched: no ancestry to ask.
            n="${laptop_behind:-?}"
            row drift "$label" "$n commits behind $src ($(short "$head") → $(short "$target"))"
            return
        fi
        if git -C "$d" merge-base --is-ancestor "$target" "$head"; then
            leave_checkout_alone "$label" "$(short "$head") is AHEAD of $src: unpushed commits on this host, not touched"
            return
        fi
        if ! git -C "$d" merge-base --is-ancestor "$head" "$target"; then
            leave_checkout_alone "$label" "diverged from $src; not fast-forwardable, resolve by hand"
            return
        fi
        n="$(git -C "$d" rev-list --count "$head..$target")"
        if [[ "$MODE" != apply ]]; then
            row drift "$label" "$n commits behind $src ($(short "$head") → $(short "$target"))"
            return
        fi
        # Local edits only block the merge when origin/main changes the same path; the
        # merge itself would refuse, but this names the files. Never stash: the stash stack
        # is shared with every worktree and session on the box.
        overlap="$(comm -12 \
            <({ git -C "$d" diff --name-only HEAD; git -C "$d" ls-files --others --exclude-standard; } | sort -u) \
            <(git -C "$d" diff --name-only "$head" "$target" | sort -u) | tr '\n' ' ')"
        if [[ -n "$overlap" ]]; then
            leave_checkout_alone "$label" "local edits to ${overlap% } that origin/main also changes; not merged"
            return
        fi
        if ! git -C "$d" merge --ff-only --quiet "$target" </dev/null >/dev/null 2>&1; then
            row drift "$label" "git merge --ff-only $(short "$target") failed"
            return
        fi
        head="$target"
    fi
    install_checkout "$label" "$d" "$STATE/$stamp_name" "$old" "$head" "$n"
}
leave_checkout_alone() {   # $1 = the area, $2 = why; the ⚠ row, and the record the links row reads
    CHECKOUT_THIS_RUN[$1]="left-alone"
    row oper "$1" "$2"
}

# The install half of sync_checkout. ./install is part of deploying (CLAUDE.md, "The checkout IS
# the deployment"); dotfiles' is what links this script's own timer. A stamp records the commit it
# last ran for, so a level checkout does not re-run it. Every ./install runs with stdin closed: the
# public one prompts on a tty.
# $1 = area, $2 = checkout, $3 = stamp file, $4 = HEAD before this run, $5 = HEAD now,
# $6 = the commits fast-forwarded.
install_checkout() {
    local label="$1" d="$2" stamp="$3" old="$4" head="$5" n="$6" level_text log_name="install.log"
    [[ "$label" == dotfiles ]] || log_name="install-$label.log"
    level_text="main at $(short "$head"), installed"
    [[ "$old" != "$head" ]] && level_text="fast-forwarded $n commits ($(short "$old") → $(short "$head")), installed"
    if [[ "$(cat "$stamp" 2>/dev/null)" == "$head" ]]; then
        row ok "$label" "$level_text"
        return
    fi
    if [[ "$MODE" != apply ]]; then
        row drift "$label" "main at $(short "$head"), but ./install has not run for it"
        return
    fi
    CHECKOUT_INSTALL_LOG[$label]="$STATE/$log_name"
    if (cd "$d" && bash ./install) >"$STATE/$log_name" 2>&1 </dev/null; then
        CHECKOUT_THIS_RUN[$label]="installed"
        printf '%s\n' "$head" >"$stamp"
        row ok "$label" "$level_text"
    else
        CHECKOUT_THIS_RUN[$label]="install-failed"
        row drift "$label" "./install failed at $(short "$head"); log: ~/.local/state/host-sync/$log_name"
        tail -n 5 "$STATE/$log_name" | sed 's/^/        /'
    fi
}

# Arming is a per-host decision, like the memory timer's: "not armed" is information, and drift is
# an armed marker without a live host-sync.timer, or dev-sync.timer still carrying the arming
# (D8, H3). Disarming is sticky: a `disarmed` file outranks the laptop's --arm, so a later laptop
# --apply still syncs the host but does not re-arm its timer. HERDR_GUIDE.md has the steps.
#
# THE MOVE FROM dev-sync.timer. dev-sync.service runs only while ~/.config/dev-sync/armed exists
# (its ConditionPathExists), so the marker files move only once host-sync.timer reads back enabled
# and active, and dev-sync.timer is stopped and its .wants link pruned only after that: every
# intermediate state has at least one timer whose condition holds. On any failure dev-sync.timer,
# its .wants link and its marker are left exactly as found. Never `disable` or `reenable` either
# unit: each is a dotbot symlink into the checkout, and the disable half deletes it.
#
# The states, tested in this order so that a half-migrated host is finished rather than passed:
#   1. disarmed, in either marker dir   ·, and --apply moves the file to the new dir
#   2. dev-sync.timer enabled           ✗ in --check; --apply moves the arming
#   3. host-sync.timer live, and armed  ✓, and --apply moves a marker left in the old dir
#   4. --apply, armed or --arm          arm host-sync.timer
#   5. --check, armed                   ✗: a marker without a live timer
#   6. otherwise                        ·: not armed
here_timer() {
    local legacy_enabled next note=""
    if is_disarmed; then
        [[ "$MODE" == apply ]] && move_marker_files
        row info timer "disarmed by hand ($(disarmed_marker_shown)); --apply does not re-arm it"
        return
    fi
    legacy_enabled="$(systemctl --user is-enabled "$LEGACY_TIMER_UNIT" 2>/dev/null)"
    read_timer_state
    if [[ "$legacy_enabled" == enabled ]]; then
        move_arming_from_legacy_timer
        return
    fi
    if timer_is_live && is_armed; then
        [[ "$MODE" == apply ]] && move_marker_files
        next="$(systemctl --user show "$TIMER_UNIT" -p NextElapseUSecRealtime --value 2>/dev/null)"
        row ok timer "$TIMER_UNIT armed${next:+, next run $next}"
        return
    fi
    if [[ "$MODE" == apply ]] && { is_armed || [[ "$ARM" == 1 ]]; }; then
        if ! timer_unit_linked; then
            timer_not_linked_row ""
        elif arm_timer; then
            move_marker_files
            row ok timer "$TIMER_UNIT armed (daily)"
        else
            row drift timer "arming failed: is-enabled=${TIMER_ENABLED:-?}, is-active=${TIMER_ACTIVE:-?}"
        fi
        return
    fi
    if is_armed; then   # --check only: an armed --apply was handled by state 4
        row drift timer "armed (marker present) but $TIMER_UNIT is-enabled=${TIMER_ENABLED:-?}, is-active=${TIMER_ACTIVE:-?}"
        return
    fi
    timer_may_fire &&
        note=" (is-enabled=${TIMER_ENABLED:-?}, is-active=${TIMER_ACTIVE:-?}: a timer that fires into a skipped unit)"
    row info timer "not armed on this host (no ~/.config/host-sync/armed); host-sync --host <alias> --apply from the laptop arms it$note"
}

# State 2. --check names the move; --apply arms host-sync.timer unless it is already live, reads it
# back, and only then moves the marker files and stops and prunes dev-sync.timer.
move_arming_from_legacy_timer() {
    local left_armed="; $LEGACY_TIMER_UNIT left armed"
    if [[ "$MODE" != apply ]]; then
        row drift timer "$LEGACY_TIMER_UNIT is armed; --apply moves the arming to $TIMER_UNIT"
        return
    fi
    if ! timer_is_live; then
        if ! timer_unit_linked; then
            timer_not_linked_row "$left_armed"
            return
        fi
        arm_timer
    fi
    if ! timer_is_live; then
        row drift timer "$TIMER_UNIT could not be armed (is-enabled=${TIMER_ENABLED:-?}, is-active=${TIMER_ACTIVE:-?})$left_armed"
        return
    fi
    # host-sync.service needs its own marker before dev-sync.service loses its: a marker that
    # could not be moved or written keeps dev-sync.timer armed.
    move_marker_files
    if [[ ! -e "$MARKER_DIR/armed" ]] && ! write_armed_marker; then
        row drift timer "$(tilde_path "$MARKER_DIR/armed") could not be written$left_armed"
        return
    fi
    systemctl --user stop "$LEGACY_TIMER_UNIT" >/dev/null 2>&1
    rm -f "$WANTS_DIR/$LEGACY_TIMER_UNIT"
    systemctl --user daemon-reload >/dev/null 2>&1
    row ok timer "arming moved from $LEGACY_TIMER_UNIT to $TIMER_UNIT"
}

# Write the marker, enable host-sync.timer and read it back. enable, never reenable: the unit is a
# dotbot symlink into the checkout, and `disable` (half of reenable) deletes it
# (scripts/reconcile-systemd-units.sh). Succeeds when the timer reads back enabled and active.
arm_timer() {
    write_armed_marker
    systemctl --user daemon-reload >/dev/null 2>&1
    systemctl --user enable --now "$TIMER_UNIT" >/dev/null 2>&1
    read_timer_state
    timer_is_live
}
write_armed_marker() { { mkdir -p "$MARKER_DIR" && : >"$MARKER_DIR/armed"; } 2>/dev/null; }

# File by file, never the directory: a host-sync dir that already exists must not strand the
# legacy marker inside a nested dev-sync/. The legacy dir goes once it is empty.
move_marker_files() {
    local name
    for name in armed disarmed; do
        [[ -e "$LEGACY_MARKER_DIR/$name" ]] && mkdir -p "$MARKER_DIR" && mv "$LEGACY_MARKER_DIR/$name" "$MARKER_DIR/$name"
    done
    rmdir "$LEGACY_MARKER_DIR" 2>/dev/null || true
}

is_armed() { [[ -e "$MARKER_DIR/armed" || -e "$LEGACY_MARKER_DIR/armed" ]]; }
is_disarmed() { [[ -e "$MARKER_DIR/disarmed" || -e "$LEGACY_MARKER_DIR/disarmed" ]]; }
disarmed_marker_shown() {
    if [[ -e "$MARKER_DIR/disarmed" ]]; then tilde_path "$MARKER_DIR/disarmed"
    else tilde_path "$LEGACY_MARKER_DIR/disarmed"; fi
}
# A path under $HOME as ~/…, as the rows print it; any other path as it is.
tilde_path() {
    if [[ "$1" == "$HOME"/* ]]; then printf '~%s' "${1#"$HOME"}"; else printf '%s' "$1"; fi
}
# A manifest's target as a path: a leading ~/, $HOME/ or ${HOME}/ expanded, as dotbot expands it.
expand_home_path() {
    local path="$1" prefix
    # shellcheck disable=SC2016,SC2088  # the manifest's literal ~ and $HOME, matched as text, deliberately
    local home_prefixes=('~/' '$HOME/' '${HOME}/')
    for prefix in "${home_prefixes[@]}"; do
        if [[ "$path" == "$prefix"* ]]; then
            printf '%s/%s' "$HOME" "${path#"$prefix"}"
            return
        fi
    done
    printf '%s' "$path"
}
# stdin to stdout through the checkout's redactor, or unchanged on a checkout that predates it.
redact_stream() {
    local redactor="$DOTFILES/scripts/redact-secrets.sh"
    if [[ -x "$redactor" ]]; then "$redactor"; else cat; fi
}
list_has() {   # $1 = a word, $2… = a list; 0 when the list holds the word
    local word="$1" item
    shift
    for item in "$@"; do [[ "$item" == "$word" ]] && return 0; done
    return 1
}
join_comma() {   # $@ = items, printed as "a, b, c"
    local joined
    joined="$(printf '%s, ' "$@")"
    printf '%s' "${joined%, }"
}

# host-sync.timer's is-enabled and is-active, into TIMER_ENABLED and TIMER_ACTIVE.
read_timer_state() {
    TIMER_ENABLED="$(systemctl --user is-enabled "$TIMER_UNIT" 2>/dev/null)"
    TIMER_ACTIVE="$(systemctl --user is-active "$TIMER_UNIT" 2>/dev/null)"
}
timer_is_live() { [[ "$TIMER_ENABLED" == enabled && "$TIMER_ACTIVE" == active ]]; }
timer_unit_linked() { [[ -e "$USER_UNIT_DIR/$TIMER_UNIT" ]]; }
timer_not_linked_row() {   # $1 = what is appended
    row drift timer "$TIMER_UNIT is not linked (./install has not run for a commit that has it)$1"
}
# Whether an unarmed host's timer still fires (into a unit its condition skips). A dotbot-linked
# unit with no .wants link reads `linked`, not `disabled`; one with no unit file reads `not-found`
# (both measured on systemd 259); an empty answer is a user manager that did not reply.
timer_may_fire() {
    case "$TIMER_ENABLED" in
        disabled | linked | not-found | "") ;;
        *) return 0 ;;
    esac
    [[ -n "$TIMER_ACTIVE" && "$TIMER_ACTIVE" != inactive ]]
}

here_claude() {
    local cur target src new
    cur="$("$CLAUDE" --version 2>/dev/null </dev/null | awk 'NR==1{print $1}')"
    if [[ ! "$cur" =~ $VER_RE ]]; then
        row oper claude "no working claude at ~/.local/bin/claude; install it once by hand"
        return
    fi
    if [[ -n "$ARG_CLAUDE" ]]; then
        target="$ARG_CLAUDE"; src="laptop"
    else
        target="$(curl -fsS --max-time 20 "$NPM_LATEST_URL" 2>/dev/null | jq -r '.version // empty' 2>/dev/null)"
        src="latest"
    fi
    if [[ ! "$target" =~ $VER_RE ]]; then
        row drift claude "$cur; could not determine the $src version"
        return
    fi
    if [[ "$cur" == "$target" ]]; then
        row ok claude "$cur ($src $target)"
    elif ver_ge "$cur" "$target"; then
        row ok claude "$cur, ahead of $src $target (never downgraded)"
    elif [[ "$MODE" == apply ]]; then
        "$CLAUDE" install "$target" >"$STATE/claude-install.log" 2>&1 </dev/null
        new="$("$CLAUDE" --version 2>/dev/null </dev/null | awk 'NR==1{print $1}')"
        if [[ "$new" == "$target" ]]; then
            row ok claude "$cur → $target"
        else
            row drift claude "claude install $target failed; still ${new:-?} (log: ~/.local/state/host-sync/claude-install.log)"
        fi
    else
        row drift claude "$cur, $src has $target"
    fi
}

# THE LONG-LIVED TOKEN. Every session on dev used to share one /login, whose refresh token
# rotates: when several start within minutes, one refreshes with a superseded token and they all
# log out at once (2026-10-14, 07:37 EDT). CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`
# outranks the stored login and is never refreshed. scripts/claude-oauth-store writes it; shells
# (zshrc.company), the herdr launcher and rabota's remote lanes load it. These rows read its
# mode, its shape and its date, never its value, and `claude auth status` for two fields.
# Loaded into THIS process too, so host-sync's own `claude` calls do not refresh the login.
#
# token.env is a regular file today. In the seat layout it is a link to seats/<seat>.env, and the
# token's date is then seats/<seat>.created. token_layout sets TOKEN_SEAT (empty for a file),
# TOKEN_DATE (the date file to read) and TOKEN_LINK_BAD (the target of a link that is not exactly
# seats/<seat>.env, sanitised for printing; nothing here reads through such a link).
token_layout() {
    local t name
    TOKEN_SEAT=""; TOKEN_LINK_BAD=""; TOKEN_DATE="$TOKEN_DIR/created"
    [[ -L "$TOKEN_FILE" ]] || return 0
    t="$(readlink "$TOKEN_FILE")"
    name="${t#seats/}"; name="${name%.env}"
    if [[ "$t" == "seats/$name.env" && "$name" =~ $SEAT_RE ]]; then
        TOKEN_SEAT="$name"; TOKEN_DATE="$TOKEN_DIR/seats/$name.created"
    else
        TOKEN_LINK_BAD="${t//[^A-Za-z0-9._\/-]/?}"
    fi
}
# The token's value passes through this function's variables, so a `bash -x` run while debugging
# would trace it. `local -` (bash >= 4.4) restores the caller's options on return, so tracing
# stops here and resumes after.
load_token() {
    local -; set +x
    local line=""
    [[ -z "$TOKEN_LINK_BAD" ]] || return 1
    [[ -r "$TOKEN_FILE" ]] || return 1
    IFS= read -r line <"$TOKEN_FILE" || [[ -n "$line" ]] || return 1
    [[ "$line" =~ $TOKEN_LINE_RE ]] || return 1
    export CLAUDE_CODE_OAUTH_TOKEN="${line#CLAUDE_CODE_OAUTH_TOKEN=}"
}

# "<claude processes of this user> <of them without the token>", from /proc. Each environment is
# tested by ONE grep, so no entry ever passes through a bash variable, where a `set -x` while
# debugging would print every process's token. --null-data, never -z: ugrep reads -z as
# "decompress", and an environ is NUL-separated, so ^ anchors at each entry only with it.
claude_procs() {
    local d c n=0 w=0
    for d in "$PROC"/[0-9]*; do
        # A session is `claude`; one started by its versioned path (a herdmates teammate)
        # shows the version as its name.
        c="$(cat "$d/comm" 2>/dev/null)"
        [[ -O "$d" && ( "$c" == claude || "$c" =~ $VER_RE ) ]] || continue
        n=$((n + 1))
        grep -qa --null-data '^CLAUDE_CODE_OAUTH_TOKEN=.' "$d/environ" 2>/dev/null || w=$((w + 1))
    done
    printf '%d %d\n' "$n" "$w"
}

# The shared /login written back. A session started before the token, or anyone's /login, puts
# claudeAiOauth back in .credentials.json, and every launch without the token races it again
# (docs/HERDR_GUIDE.md, "Working on dev"). jq's exit status alone answers: only the key's presence
# is read, and nothing of the file is printed or held in this shell.
here_login_back() {
    local creds="$HOME/.claude/.credentials.json" rc=1
    [[ -e "$creds" ]] && { jq -e 'has("claudeAiOauth")' "$creds" >/dev/null 2>&1; rc=$?; }
    case "$rc" in
        0) row oper auth "the shared /login is back on this host (claudeAiOauth in ~/.claude/.credentials.json): restart the Claude processes that started without the token, then remove the key again" ;;
        1) row ok auth "no shared /login on this host (claudeAiOauth absent)" ;;
        *) row oper auth "could not tell whether the shared /login is back: ~/.claude/.credentials.json does not read as a JSON object" ;;
    esac
}

here_auth() {
    local st logged method mode created then_s age left n w
    # clauth rotates per-account logins and refuses a stored long-lived token (H9), so nothing below
    # applies there, and `claude auth status` is not asked.
    if [[ -d "$CLAUTH_DIR" ]]; then
        row info auth "accounts are managed by clauth on this host; the long-lived-token rows do not apply"
        return 0
    fi
    st="$(cd "$HOME" && timeout 60 "$CLAUDE" auth status --json 2>/dev/null </dev/null |
        jq -r '"\(.loggedIn) \(.authMethod)"' 2>/dev/null)"
    read -r logged method <<<"$st"
    if [[ -z "$logged" ]]; then
        row oper auth "claude auth status gave no answer, so the login state on this host is unknown"
    elif [[ "$logged" != true ]]; then
        row oper auth "Claude is not logged in on this host ($method); store a long-lived token, HERDR_GUIDE.md \"Working on dev\""
    elif [[ "$method" == oauth_token ]]; then
        # auth status does not test the token (any value reads as logged in), so this says
        # it is in use, not that it works.
        row ok auth "claude uses the long-lived token (oauth_token), not the shared /login"
    elif (( TOKEN_LOADED )); then
        row oper auth "a token is stored, but claude reports $method: it is not being used"
    else
        row oper auth "only the shared /login ($method): sessions that start together can log every session out at once; store a long-lived token, HERDR_GUIDE.md \"Working on dev\""
    fi
    if [[ -n "$TOKEN_LINK_BAD" ]]; then
        row oper auth "token.env links to $TOKEN_LINK_BAD, which is not a seat (seats/<name>.env, <name> like quantivly-5): host-sync reads nothing through it; point it at a seat, or make it a file again"
        return 0
    elif [[ -n "$TOKEN_SEAT" && ! -e "$TOKEN_FILE" ]]; then
        row oper auth "token.env links to seats/$TOKEN_SEAT.env, which does not exist: new shells load no token, so claude is not logged in; store that seat again (scripts/claude-oauth-store)"
        return 0
    fi
    [[ -e "$TOKEN_FILE" ]] || return 0
    if [[ ! -r "$TOKEN_FILE" ]]; then
        row oper auth "$TOKEN_FILE is not readable by $(id -un); fix its owner and mode (600)"
        return 0
    elif (( ! TOKEN_LOADED )); then
        row oper auth "$TOKEN_FILE holds no CLAUDE_CODE_OAUTH_TOKEN line of setup-token's shape; store it again (scripts/claude-oauth-store)"
        return 0
    fi
    # -L: through a link, the mode that matters is the seat file's, not the link's 777.
    mode="$(stat -L -c %a "$TOKEN_FILE" 2>/dev/null)"
    [[ "$mode" == 600 ]] || row oper auth "the token file is mode ${mode:-?}, not 600: chmod 600 $TOKEN_FILE"
    created="$(cat "$TOKEN_DATE" 2>/dev/null)"
    # Whole days between two dates, both read as UTC midnights, so a DST change cannot
    # move the count by the hour that would floor it a day short.
    if [[ ! "$created" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || ! then_s="$(TZ=UTC date -d "$created" +%s 2>/dev/null)"; then
        row oper auth "the token has no readable date in $TOKEN_DATE, so its expiry is unknown; store it again"
    else
        age=$(( ($(TZ=UTC date -d "$(date +%F)" +%s) - then_s) / 86400 )); left=$((TOKEN_LIFE_D - age))
        if (( age < 0 )); then
            row oper auth "the token's date $created is in the future, so its expiry is unknown; store it again"
        elif (( left <= 0 )); then
            row oper auth "the token stored $created is a year old and has expired: mint a new one (claude setup-token) and store it"
        elif (( age >= TOKEN_WARN_D )); then
            row oper auth "the token stored $created expires in about $left day(s): mint a new one (claude setup-token) and store it"
        else
            row ok auth "token stored $created, $age day(s) old${TOKEN_SEAT:+ (seat $TOKEN_SEAT)}"
        fi
    fi
    read -r n w <<<"$(claude_procs)"
    if (( n == 0 )); then
        row info auth "no Claude process running"
    elif (( w == 0 )); then
        row ok auth "all $n Claude process(es) carry the token"
    else
        row oper auth "$w of $n Claude process(es) started without the token and still refresh the shared /login; restart them when idle"
    fi
    here_login_back
}

server_version() { "$HERDR" status server 2>/dev/null </dev/null | awk '$1=="version:"{print $2; exit}'; }
herdr_binary_version() { "$HERDR" --version 2>/dev/null </dev/null | awk 'NR==1{print $2}'; }

# herdr itself, at the laptop's exact version. herdr-draft's `--machine` needs the remote side
# on 0.9.1 or later: a 0.9.0 dev answers "remote Herdr does not support machine API
# forwarding". Laptop-driven only. The timer cannot know the laptop's version, and a dev that
# moves AHEAD of the laptop risks the client/server protocol the laptop's own client speaks.
#
# THE BINARY is the release asset for this architecture, accepted only if its sha256 equals the
# laptop's own binary (the laptop runs the unmodified release asset; checked 2026-10-13). It is
# renamed into place, so the running server keeps its old inode.
#
# THE SERVER keeps running the old version until it restarts, and a restart closes every pane
# on dev. An empty `herdr agent list` is not enough to allow that: it lists detected agents
# only, and a test run or an editor in a plain pane is not one. Nor can it wait for NO pane:
# while a client is attached, herdr recreates a default workspace the moment the last one
# closes (src/app/mod.rs, ensure_default_workspace), so a watched dev always has one. The test
# is herdr's own for "at the prompt" (src/cli/agent.rs): a pane whose foreground process group
# is its shell is running nothing in the foreground. The whole upgrade waits until every pane
# passes it, the binary included, which also keeps a new CLI from talking to an old server for
# days. A job put in the background with & would still die; nothing here can see one. The
# restart goes through the unit, which builds a clean environment; never from a pane or a
# session.
# How many panes are NOT idle at their shell prompt; nothing at all if the server cannot say.
# Only two pids are read from each pane, never its command lines.
busy_panes() {
    local ids id st n=0
    ids="$("$HERDR" pane list 2>/dev/null </dev/null | jq -r '.result.panes[].pane_id' 2>/dev/null)" || return 1
    while read -r id; do
        [[ -n "$id" ]] || continue
        st="$("$HERDR" pane process-info --pane "$id" 2>/dev/null </dev/null | jq -r '.result.process_info |
            if .shell_pid != null and .foreground_process_group_id == .shell_pid then "idle" else "busy" end' 2>/dev/null)"
        [[ "$st" == idle ]] || n=$((n + 1))   # unreadable counts as busy
    done <<<"$ids"
    echo "$n"
}

# ~/.ssh/ssh_auth_sock is what panes, the herdr server and tmux hand every process as
# SSH_AUTH_SOCK. On 2026-10-14 it pointed at an agent forwarded from the laptop: while any ssh to
# dev stayed open, each new pane's ssh-add went back through it to the laptop's Bitwarden agent
# and hung, and anything on the box could use the laptop's keys. The shell no longer publishes a
# forwarded agent here (zshrc.conditionals.plugins); this reports what the link is now.
# Forwarded means VSCode's socket, or sshd's /tmp/ssh-*/agent.<pid> with sshd behind the pid: a
# local `ssh-agent -s` makes the same shape, named after its own parent.
# 0 if the link resolves to a forwarded agent; AGENT_TARGET is where it resolves.
agent_link_forwarded() {
    local pid="" comm=""
    AGENT_TARGET="$(readlink -f "$HOME/.ssh/ssh_auth_sock")"
    [[ "$AGENT_TARGET" =~ /ssh-[^/]+/agent\.([0-9]+)$ ]] && pid="${BASH_REMATCH[1]}"
    [[ -n "$pid" && -r "$PROC/$pid/comm" ]] && comm="$(<"$PROC/$pid/comm")"
    [[ "$AGENT_TARGET" == */vscode-ssh-auth-sock-* || "$comm" == sshd* ]]
}
# shellcheck disable=SC2088  # "~/.ssh/..." is a label in the rows, not a path to expand
here_agent() {
    local link="$HOME/.ssh/ssh_auth_sock" t t0 ms rc
    if [[ ! -L "$link" ]]; then
        row info agent "no ~/.ssh/ssh_auth_sock link$([[ -e "$link" ]] && echo ", a plain file is there")"
        return
    fi
    if [[ ! -S "$link" ]]; then
        row info agent "~/.ssh/ssh_auth_sock dangles (→ $(readlink "$link")); the next shell relinks it to this host's own agent"
        return
    fi
    agent_link_forwarded; rc=$?; t="$AGENT_TARGET"
    if (( rc == 0 )); then
        # Never probed: asking a forwarded agent is the hang this row exists for.
        row oper agent "~/.ssh/ssh_auth_sock → an agent FORWARDED from the laptop ($t): any process here can use its keys, and new panes' ssh-add waits on it. Set ForwardAgent no for this host and end that ssh; the next shell relinks to this host's own agent"
        return
    fi
    row ok agent "~/.ssh/ssh_auth_sock → $t, a local agent"
    t0="${EPOCHREALTIME/./}"
    SSH_AUTH_SOCK="$link" timeout 1 ssh-add -l >/dev/null 2>&1 && rc=0 || rc=$?
    ms=$(( (${EPOCHREALTIME/./} - t0) / 1000 ))
    case "$rc" in
        0) row ok agent "ssh-add -l answered in $ms ms, keys loaded" ;;
        1) row ok agent "ssh-add -l answered in $ms ms, no keys loaded" ;;
        124) row oper agent "ssh-add -l did not answer within 1 s: every new shell here waits on this agent" ;;
        *) row info agent "ssh-add -l could not reach the agent (exit $rc, $ms ms)" ;;
    esac
}

here_herdr() {
    local bin srv target="$ARG_HERDR" got arch agents="" panes="" busy="" i old
    [[ -x "$HERDR" ]] || return 0   # here_draft reports a missing herdr
    bin="$(herdr_binary_version)"
    if [[ -z "$target" ]]; then
        row info herdr "$bin; version parity is laptop-driven (no laptop facts in this run)"
        return
    fi
    if [[ "$bin" != "$target" ]] && ver_ge "$bin" "$target"; then
        row ok herdr "$bin, ahead of laptop $target (never downgraded)"
        return
    fi
    srv="$(server_version)"
    if [[ "$bin" == "$target" && "$srv" == "$bin" ]]; then
        row ok herdr "$bin, server $srv"
        return
    fi
    if [[ -n "$srv" ]]; then
        agents="$("$HERDR" agent list 2>/dev/null </dev/null | jq -r '.result.agents | length' 2>/dev/null)"
        panes="$("$HERDR" pane list 2>/dev/null </dev/null | jq -r '.result.panes | length' 2>/dev/null)"
        busy="$(busy_panes)"
    fi
    if [[ "$MODE" != apply ]]; then
        if [[ "$bin" != "$target" ]]; then
            row drift herdr "$bin, laptop has $target (server ${srv:-not answering}${panes:+, $panes pane(s), ${busy:-?} busy; --apply upgrades only when none is})"
        else
            row drift herdr "server runs $srv, binary $bin: restart pending (${agents:-?} agent(s), ${busy:-?} of ${panes:-?} pane(s) busy now)"
        fi
        return
    fi
    # Fails closed: a count that cannot be read is not zero.
    if [[ -n "$srv" && ( "$agents" != 0 || "$busy" != 0 ) ]]; then
        row oper herdr "$bin → $target waits: ${agents:-?} agent(s), ${busy:-?} of ${panes:-?} pane(s) busy on this host's herdr; when they are idle, run host-sync --apply again"
        return
    fi
    if [[ "$bin" != "$target" ]]; then
        arch="$(uname -m)"
        if [[ -z "$ARG_HERDR_SHA" || "$ARG_HERDR_ARCH" != "$arch" ]]; then
            row oper herdr "$bin, laptop $target, but the laptop's binary hash cannot vouch for a $arch asset; update by hand"
            return
        fi
        if [[ -L "$HERDR" ]]; then
            row oper herdr "$bin, laptop $target, but ~/.local/bin/herdr is a symlink; host-sync does not replace a link"
            return
        fi
        # Global, so the EXIT trap can still name it after this function returns.
        HERDR_TMP="$HOME/.local/bin/.herdr.host-sync.$$"
        trap 'rm -f "$HERDR_TMP"' EXIT
        trap 'exit 2' INT TERM HUP
        if ! curl -fsSL --max-time 300 -o "$HERDR_TMP" "$HERDR_RELEASES/v$target/herdr-linux-$arch" 2>/dev/null; then
            rm -f "$HERDR_TMP"; row drift herdr "download of herdr v$target ($arch) failed"; return
        fi
        got="$(sha256sum "$HERDR_TMP" | cut -c1-64)"
        if [[ "$got" != "$ARG_HERDR_SHA" ]]; then
            rm -f "$HERDR_TMP"; row drift herdr "the v$target asset does not match the laptop's binary (sha256); not installed"; return
        fi
        chmod 0755 "$HERDR_TMP"
        if [[ "$("$HERDR_TMP" --version 2>/dev/null | awk 'NR==1{print $2}')" != "$target" ]]; then
            rm -f "$HERDR_TMP"; row drift herdr "the downloaded binary does not report $target; not installed"; return
        fi
        if ! cp -p "$HERDR" "$STATE/herdr-$bin" 2>/dev/null; then
            rm -f "$HERDR_TMP"; row drift herdr "could not keep a copy of the $bin binary; not installed"; return
        fi
        mv -f "$HERDR_TMP" "$HERDR"
        # The agent skill this binary prints is regenerated by here_skills, later in this run.
        row ok herdr "binary $bin → $target (previous kept in ~/.local/state/host-sync/herdr-$bin)"
        old="$bin"; bin="$target"
    fi
    if [[ -z "$srv" ]]; then
        row oper herdr "binary $bin; the server did not answer \`status server\`"
        return
    fi
    systemctl --user restart herdr-server.service >/dev/null 2>&1
    for (( i = 0; i < 30; i++ )); do
        srv="$(server_version)"; [[ "$srv" == "$bin" ]] && break; sleep 1
    done
    if [[ "$srv" == "$bin" ]]; then
        row ok herdr "server restarted on $bin (${panes:-0} idle pane(s) closed)"
    else
        row drift herdr "server did not come back on $bin (now: ${srv:-not answering}); journalctl --user -u herdr-server.service${old:+; to roll back: mv ~/.local/state/host-sync/herdr-$old ~/.local/bin/herdr && systemctl --user restart herdr-server.service}"
    fi
}

# Sets D_KIND D_COMMIT D_REF and D_ROOT (the plugin's checkout, `plugin_root`) from the running
# herdr server; 1 if it cannot answer.
draft_state() {
    local j
    j="$("$HERDR" plugin list --plugin "$DRAFT_ID" --json 2>/dev/null </dev/null)" || return 1
    D_KIND="$(jq -r '.result.plugins[0].source.kind // "absent"' <<<"$j" 2>/dev/null)" || return 1
    D_COMMIT="$(jq -r '.result.plugins[0].source.resolved_commit // empty' <<<"$j")"
    D_REF="$(jq -r '.result.plugins[0].source.requested_ref // empty' <<<"$j")"
    D_ROOT="$(jq -r '.result.plugins[0].plugin_root // empty' <<<"$j")"
}

here_draft() {
    local target src go
    if [[ ! -x "$HERDR" ]]; then
        row oper herdr-draft "no herdr at ~/.local/bin/herdr"
        return
    fi
    if ! draft_state; then
        row oper herdr-draft "the herdr server did not answer \`plugin list\`; is herdr-server.service running?"
        return
    fi
    # main, from the laptop and the timer alike. A laptop-supplied commit (a feature branch, or
    # an older main) would be undone by the next timer run and redone by the next laptop run,
    # each time a `go build` on the shared box.
    target="$(git_net ls-remote "$GITHUB_BASE/$DRAFT_REPO.git" refs/heads/main 2>/dev/null | cut -f1)"
    src="main"
    if [[ ! "$target" =~ $SHA_RE ]]; then
        # Never --ref an abbreviation: herdr 0.9.0 rejects it only after cloning.
        row drift herdr-draft "could not resolve a full commit for $DRAFT_REPO ($src)"
        return
    fi
    if [[ "$D_KIND" == local ]]; then
        row oper herdr-draft "linked from a local checkout; host-sync does not replace a link"
        return
    fi
    if [[ "$D_KIND" == github && "$D_COMMIT" == "$target" ]]; then
        row ok herdr-draft "at $(short "$target") ($src)"
        return
    fi
    local have="not installed"
    [[ "$D_KIND" == github ]] && have="at $(short "$D_COMMIT")${D_REF:+ (ref $D_REF)}"
    if [[ "$MODE" != apply ]]; then
        row drift herdr-draft "$have, $src at $(short "$target")"
        return
    fi
    # The build is `go build`, run by the CLI in THIS environment, and dev's Go comes from
    # mise, which is not on a non-interactive PATH. herdr 0.9.0 replaces a GitHub-sourced
    # plugin in place and restores the old checkout if registration fails; a failed build
    # changes nothing.
    go="$("$HOME/.local/bin/mise" which go 2>/dev/null)" || go="$(command -v go)"
    if [[ ! -x "$go" ]]; then
        row drift herdr-draft "$have; no Go toolchain (mise which go) for the plugin build"
        return
    fi
    PATH="$(dirname "$go"):$PATH" timeout 900 "$HERDR" plugin install "$DRAFT_REPO" --ref "$target" --yes \
        >"$STATE/herdr-draft-install.log" 2>&1 </dev/null
    if draft_state && [[ "$D_KIND" == github && "$D_COMMIT" == "$target" ]]; then
        row ok herdr-draft "${have#at } → $(short "$target")"
    else
        row drift herdr-draft "install of $(short "$target") failed; still $have (log: ~/.local/state/host-sync/herdr-draft-install.log)"
    fi
}

# The generated skills (D6), each kept equal to what this host's binary prints: a stale herdr skill
# teaches a lead Claude the wrong CLI flags (HERDR_GUIDE.md, "Updating"), and a spawn skill copied
# from another host names a binary that is not here. Run after here_herdr and here_draft, so the
# binaries are the ones this run left in place. A file is replaced by a rename and never by an
# empty output; a SKILL.md that is a directory is a person's step.
here_skills() {
    [[ -x "$HERDR" ]] || return 0   # here_draft reports a missing herdr
    herdr_skill_row
    spawn_skill_row
}
skill_is_directory_row() {   # $1 = the skill file; 0, with the ⚠ row, when it is a directory
    [[ -d "$1" ]] || return 1
    row oper skill "$(tilde_path "$1") is a directory; move it aside, and the next run regenerates it"
}
herdr_skill_row() {
    local file="$HERDR_SKILL_FILE" shown version want
    shown="$(tilde_path "$file")"
    version="$(herdr_binary_version)"
    skill_is_directory_row "$file" && return
    want="$(timeout "$SKILL_GENERATOR_TIMEOUT_SECONDS" "$HERDR" --skill 2>/dev/null </dev/null)"
    if [[ -z "$want" ]]; then
        # A broken herdr install exits 0 and prints nothing.
        row oper skill "\`herdr --skill\` printed nothing (herdr $version); $shown left as it is"
        return
    fi
    # $( ) strips the trailing newlines, and one is put back. The file is written in the same form
    # it is compared in, so a regenerated host reads level on the next run whatever herdr ends with
    # (exactly one newline, as `herdr --skill` printed it on 2026-11-09).
    if cmp -s <(printf '%s\n' "$want") "$file"; then
        row ok skill "herdr skill current (herdr $version)"
    elif [[ "$MODE" != apply ]]; then
        if [[ -e "$file" ]]; then
            row drift skill "herdr skill differs from \`herdr --skill\` (herdr $version)"
        else
            row drift skill "no herdr skill at $shown (herdr $version)"
        fi
    elif write_generated_file "$file" printf '%s\n' "$want"; then
        row ok skill "herdr skill regenerated (herdr $version)"
    else
        row drift skill "could not write $shown (herdr $version)"
    fi
}
# The spawn skill, judged by herdr-draft itself: `skill --check` exits 0 current, 1 stale (a
# missing file included), 2 when it cannot answer; any other status is a could-not-run.
spawn_skill_row() {
    local file="$SPAWN_SKILL_FILE" rc
    find_draft_binary || return
    skill_is_directory_row "$file" && return
    run_spawn_skill_check "$DRAFT_BINARY" "$file"; rc=$?
    case "$rc" in
        0) row ok skill "spawn skill current (from $(tilde_path "$DRAFT_BINARY"))"; return ;;
        1) ;;
        *) spawn_check_failed_row "$rc"; return ;;
    esac
    if [[ "$MODE" != apply ]]; then
        if [[ -e "$file" ]]; then
            row drift skill "spawn skill differs from \`herdr-draft skill\`"
        else
            row drift skill "no spawn skill at $(tilde_path "$file")"
        fi
        return
    fi
    regenerate_spawn_skill "$file"
}
# herdr-draft's binary, from the plugin root this host's herdr reports, into DRAFT_BINARY; 1, with
# the · row that says why, when there is none to generate the spawn skill with.
find_draft_binary() {
    if ! draft_state; then
        row info skill "spawn skill not judged: herdr did not answer \`plugin list\`"
        return 1
    fi
    if [[ "$D_KIND" == absent ]]; then
        row info skill "no herdr-draft plugin on this host's herdr; no spawn skill to generate"
        return 1
    fi
    if [[ "$D_ROOT" != /* ]]; then
        row info skill "herdr reports no absolute plugin_root for herdr-draft; spawn skill not judged"
        return 1
    fi
    DRAFT_BINARY="$D_ROOT/$DRAFT_BINARY_RELATIVE"
    [[ -x "$DRAFT_BINARY" ]] && return 0
    row info skill "no executable herdr-draft at $(tilde_path "$DRAFT_BINARY"); no spawn skill to generate"
    return 1
}
# $1 = herdr-draft, $2 = the skill file. Returns `skill --check`'s status (124 a timeout), and sets
# SPAWN_CHECK_ERROR_LINE to the first line of its stderr, redacted: the unredacted text never
# reaches a variable.
run_spawn_skill_check() {
    SPAWN_CHECK_ERROR_LINE="$(timeout "$SKILL_GENERATOR_TIMEOUT_SECONDS" "$1" skill --check "$2" \
        2>&1 >/dev/null </dev/null | redact_stream | sed -n 1p; exit "${PIPESTATUS[0]}")"
}
spawn_check_failed_row() {   # $1 = `skill --check`'s status
    if [[ "$1" == 2 && -n "$SPAWN_CHECK_ERROR_LINE" ]]; then
        row oper skill "herdr-draft skill --check could not answer: $SPAWN_CHECK_ERROR_LINE"
    else
        row oper skill "herdr-draft skill --check could not run (exit $1)"
    fi
}
# --apply's half: what `herdr-draft skill` prints, renamed into place, then re-checked by it.
regenerate_spawn_skill() {   # $1 = the skill file
    local file="$1" rc
    if ! write_generated_file "$file" timeout "$SKILL_GENERATOR_TIMEOUT_SECONDS" "$DRAFT_BINARY" skill; then
        row drift skill "could not write $(tilde_path "$file") from \`herdr-draft skill\`"
        return
    fi
    run_spawn_skill_check "$DRAFT_BINARY" "$file"; rc=$?
    case "$rc" in
        0) row ok skill "spawn skill regenerated with herdr-draft skill" ;;
        1) row drift skill "spawn skill still differs from \`herdr-draft skill\` after regenerating it" ;;
        *) spawn_check_failed_row "$rc" ;;
    esac
}
# Run "${@:2}" with its stdout into a temp file beside $1, then rename that over $1, so a reader
# never sees half a file. A command that fails or prints nothing leaves $1 as it was. 1 on any failure.
write_generated_file() {   # $1 = the file, $2… = the command that prints its content
    local file="$1" tmp
    shift
    mkdir -p "$(dirname "$file")" 2>/dev/null || return 1
    tmp="$(mktemp "$file.XXXXXX" 2>/dev/null)" || return 1
    if "$@" >"$tmp" 2>/dev/null </dev/null && [[ -s "$tmp" ]] && mv -f "$tmp" "$file" 2>/dev/null; then
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# settings.json is the settings renderer's output (shared-configuration design, D2), on a host with
# a profile marker only (H1). The renderer decides: --check exits 0 level, 1 drift, 2 could not run;
# any other status (127 on a host whose checkout predates it, 124 a timeout) is a could-not-run too,
# never ✓ or ✗. Its stdout, a diff of the declared keys, is never printed.
here_settings() {
    local rc
    if [[ -z "$PROFILE" ]]; then
        row info settings "no host profile; settings.json is not rendered here"
        return 0
    fi
    run_renderer --check; rc=$?
    case "$rc" in
        0) row ok settings "settings.json renders to itself (profile $PROFILE)"; return 0 ;;
        1) ;;
        *) renderer_could_not_run_row "$rc"; return 0 ;;
    esac
    if [[ "$MODE" != apply ]]; then
        row drift settings "settings.json differs from its render"
        return 0
    fi
    run_renderer --apply; rc=$?
    (( rc == 0 )) || { renderer_could_not_run_row "$rc"; return 0; }
    run_renderer --check; rc=$?
    case "$rc" in
        0) row ok settings "rendered (profile $PROFILE)" ;;
        1) row drift settings "settings.json still differs from its render after claude-settings-render --apply" ;;
        *) renderer_could_not_run_row "$rc" ;;
    esac
}
# $1 = --check | --apply. Returns the renderer's status, and sets RENDER_ERROR_LINE to the first
# line of its stderr, redacted: the unredacted text never reaches a variable.
run_renderer() {
    RENDER_ERROR_LINE="$(timeout "$SIBLING_TIMEOUT_SECONDS" "$DOTFILES/scripts/claude-settings-render.sh" "$1" \
        2>&1 >/dev/null </dev/null | redact_stream | sed -n 1p; exit "${PIPESTATUS[0]}")"
}
renderer_could_not_run_row() {   # $1 = the renderer's status
    if [[ "$1" == 2 && -n "$RENDER_ERROR_LINE" ]]; then
        row oper settings "claude-settings-render could not run: $RENDER_ERROR_LINE"
    else
        row oper settings "claude-settings-render could not run (exit $1)"
    fi
}

# Every link each checkout's install.conf.yaml declares is in place (H8): ~/.dotfiles always, and
# ~/.dotfiles-local under the overlay's own gate (overlay_is_managed): with no marker, host-sync
# neither checks nor installs it. One checker for both, the public checkout's own: a host whose
# checkout predates it gets ⚠ (exit 127). A link that is missing, points elsewhere or is a regular
# file is drift that repo's ./install fixes, run once per repo per run; dotbot backs a regular file
# up beside it before relinking (`backup: true`), and the row names that backup when its content
# was not the repo's. A source the manifest names that is not in the checkout is a person's step.
here_links() {
    links_of_checkout dotfiles "$DOTFILES"
    overlay_is_managed && links_of_checkout dotfiles-local "$DOTFILES_LOCAL"
    return 0
}
links_of_checkout() {   # $1 = the repo's name in the rows, $2 = its checkout
    local label="$1" dir="$2" rc source
    run_link_checker "$dir"; rc=$?
    if (( rc != 0 && rc != 1 )); then
        links_could_not_run_row "$label" "$rc"
        return
    fi
    classify_link_states
    if unknown_link_fault "$rc"; then
        unknown_link_fault_row "$label"
        return
    fi
    for source in ${LINK_SOURCES_FOR_A_PERSON[@]+"${LINK_SOURCES_FOR_A_PERSON[@]}"}; do
        row oper links "$label: $source is declared but not in the checkout"
    done
    if (( ${#LINK_TARGETS_TO_FIX[@]} + ${#LINK_TARGETS_DIFFERING[@]} == 0 )); then
        (( ${#LINK_SOURCES_FOR_A_PERSON[@]} )) || row ok links "$label: $LINKS_DECLARED declared links in place"
        return
    fi
    explain_links_left_this_run "$label" && return
    if [[ "$MODE" == apply ]]; then
        relink_checkout "$label" "$dir"
    else
        report_links_to_fix "$label"
    fi
}
# $1 = a checkout. Returns check-links' status (127 when it is absent, 124 a timeout) and sets
# LINK_CHECK_OUTPUT to what it printed: its --tsv lines, or on a could-not-run its reason.
run_link_checker() {
    local dir="$1"
    LINK_CHECK_OUTPUT="$(timeout "$SIBLING_TIMEOUT_SECONDS" "$DOTFILES/scripts/check-links.sh" --tsv \
        --root "$dir" --config "$dir/install.conf.yaml" </dev/null 2>&1)"
}
# The row for a checker that could not run, and its reason, redacted, on the line below it.
links_could_not_run_row() {   # $1 = the repo's name, $2 = check-links' status
    local reason
    row oper links "$1: check-links could not run (exit $2)"
    reason="$(printf '%s\n' "$LINK_CHECK_OUTPUT" | sed -n 1p | redact_stream)"
    # check-links marks that line ✗; under a ⚠ row the glyph would read as a second, drifted row.
    reason="${reason#✗ }"
    [[ -n "$reason" ]] && printf '        %s\n' "$reason"
    return 0
}
# Sort LINK_CHECK_OUTPUT's lines by who acts on them, into LINKS_DECLARED (every entry, the
# conditional-absent included), LINK_TARGETS_TO_FIX and LINK_TARGETS_DIFFERING (targets, as ~/…) and
# LINK_SOURCES_FOR_A_PERSON (sources, as the manifest names them).
classify_link_states() {
    local state target source shown
    LINKS_DECLARED=0; LINK_TARGETS_TO_FIX=(); LINK_TARGETS_DIFFERING=(); LINK_SOURCES_FOR_A_PERSON=()
    while IFS=$'\t' read -r state target source; do
        shown="$(tilde_path "$(expand_home_path "$target")")"
        if list_has "$state" "${LINK_STATES_TO_FIX[@]}"; then
            if [[ "$state" == "$LINK_STATE_REGULAR_DIFFERS" ]]; then
                LINK_TARGETS_DIFFERING+=("$shown")
            else
                LINK_TARGETS_TO_FIX+=("$shown")
            fi
        elif list_has "$state" "${LINK_STATES_FOR_A_PERSON[@]}"; then
            LINK_SOURCES_FOR_A_PERSON+=("$source")
        elif ! list_has "$state" "${LINK_STATES_IN_PLACE[@]}"; then
            continue
        fi
        LINKS_DECLARED=$((LINKS_DECLARED + 1))
    done <<<"$LINK_CHECK_OUTPUT"
}
# check-links exited 1, yet no line names a fault this script knows (a state added to the checker
# after it): never read as level. $1 = check-links' status.
unknown_link_fault() {
    local faults_known=$(( ${#LINK_TARGETS_TO_FIX[@]} + ${#LINK_TARGETS_DIFFERING[@]} + ${#LINK_SOURCES_FOR_A_PERSON[@]} ))
    (( $1 == 1 && faults_known == 0 ))
}
unknown_link_fault_row() {   # $1 = the repo's name
    row oper links "$1: check-links reports a fault in a state host-sync does not know (exit 1)"
}
report_links_to_fix() {   # $1 = the repo's name; --check's ✗ rows
    local target
    if (( ${#LINK_TARGETS_TO_FIX[@]} )); then
        row drift links "$1: ${#LINK_TARGETS_TO_FIX[@]} link(s) to fix: $(join_comma "${LINK_TARGETS_TO_FIX[@]}")"
    fi
    for target in ${LINK_TARGETS_DIFFERING[@]+"${LINK_TARGETS_DIFFERING[@]}"}; do
        row drift links "$1: $target is a regular file whose content differs from the repo; ./install backs it up beside it and relinks"
    done
}
# --apply: the repo's ./install, once, then the checker again. $1 = the repo's name, $2 = its checkout.
relink_checkout() {
    local label="$1" dir="$2" log="$STATE/install-links-$1.log" rc install_rc fixed
    local differing=(${LINK_TARGETS_DIFFERING[@]+"${LINK_TARGETS_DIFFERING[@]}"})
    fixed=$(( ${#LINK_TARGETS_TO_FIX[@]} + ${#LINK_TARGETS_DIFFERING[@]} ))
    (cd "$dir" && bash ./install </dev/null) >"$log" 2>&1; install_rc=$?
    run_link_checker "$dir"; rc=$?
    if (( rc != 0 && rc != 1 )); then
        links_could_not_run_row "$label" "$rc"
        return
    fi
    classify_link_states
    if unknown_link_fault "$rc"; then
        unknown_link_fault_row "$label"
        return
    fi
    if (( ${#LINK_TARGETS_TO_FIX[@]} + ${#LINK_TARGETS_DIFFERING[@]} )); then
        still_to_fix_row "$label" "$log"
        return
    fi
    row ok links "$label: $fixed link(s) relinked$(backups_kept ${differing[@]+"${differing[@]}"})"
    # The link step can succeed and a later step of the same ./install fail. Its stamp is the
    # checkout's, already level, so no later run would ever name this log.
    (( install_rc == 0 )) || row oper links "$label: ./install exited $install_rc after relinking; log: $(tilde_path "$log")"
}
# ✗ for the links an ./install left out of place. $1 = the repo's name, $2 = that ./install's log.
still_to_fix_row() {
    local left still
    left=$(( ${#LINK_TARGETS_TO_FIX[@]} + ${#LINK_TARGETS_DIFFERING[@]} ))
    still="$(join_comma ${LINK_TARGETS_TO_FIX[@]+"${LINK_TARGETS_TO_FIX[@]}"} ${LINK_TARGETS_DIFFERING[@]+"${LINK_TARGETS_DIFFERING[@]}"})"
    row drift links "$1: still $left to fix after ./install ($still); log: $(tilde_path "$2")"
}
# ./install runs at most once per repo per run, and never on a checkout sync_checkout left alone.
# When this run's sync_checkout already decided, print the row that says what that means for the
# links and return 0; return 1 when the links row may run ./install itself. $1 = the repo's name.
explain_links_left_this_run() {
    local label="$1" faults log
    faults=$(( ${#LINK_TARGETS_TO_FIX[@]} + ${#LINK_TARGETS_DIFFERING[@]} ))
    log="$(tilde_path "${CHECKOUT_INSTALL_LOG[$label]:-}")"
    case "${CHECKOUT_THIS_RUN[$label]:-}" in
        left-alone)
            row oper links "$label: $faults link(s) to fix, but the checkout was left alone this run; fix the checkout first" ;;
        install-failed)
            row oper links "$label: $faults link(s) to fix, but ./install already failed this run (log: $log)" ;;
        installed) still_to_fix_row "$label" "${CHECKOUT_INSTALL_LOG[$label]}" ;;
        *) return 1 ;;
    esac
}
# "; the old ~/.x is kept as ~/.x.dotbot-backup.<stamp>" for each target ($@, as ~/…) whose
# backup dotbot left beside it: the newest by name, since the names sort by their stamp.
backups_kept() {
    local target candidate newest
    for target in "$@"; do
        newest=""
        for candidate in "$(expand_home_path "$target")$DOTBOT_BACKUP_INFIX"*; do
            [[ -e "$candidate" ]] && newest="$candidate"
        done
        [[ -n "$newest" ]] && printf '; the old %s is kept as %s' "$target" "$(tilde_path "$newest")"
    done
    return 0
}

# Not `.enabledPlugins[$p] // "absent"`: jq's // treats false as missing, so a plugin just set to
# false read back as "absent" and every disable reported failure (dev, 2026-10-14).
plugin_enabled() {
    jq -r --arg p "$1" '(.enabledPlugins // {}) | if has($p) then .[$p] | tostring else "absent" end' "$SETTINGS" 2>/dev/null
}
# The USER-scope entry: a plugin also has project-scope entries, one per project it was
# installed in, and those neither load everywhere nor share the user entry's version.
plugin_installed() { jq -e --arg p "$1" 'any((.plugins[$p] // [])[]; .scope == "user")' "$INSTALLED" >/dev/null 2>&1; }
plugin_version() { jq -r --arg p "$1" 'first((.plugins[$p] // [])[] | select(.scope == "user")) | .version // empty' "$INSTALLED" 2>/dev/null; }
# Every `claude plugin` call runs with CLAUDE_CODE_PLUGIN_PREFER_HTTPS=1 (H4): an owner/repo
# source tries SSH first, and a host's GitHub auth may be gh over HTTPS alone (dev, sol-build).
claude_plugin() {
    (cd "$HOME" && CLAUDE_CODE_PLUGIN_PREFER_HTTPS=1 "$CLAUDE" plugin "$@" >>"$STATE/plugins.log" 2>&1 </dev/null)
}

# The declaration's shape, read before it is indexed: settings.json is an object, and its
# enabledPlugins and extraKnownMarketplaces are objects wherever they are present.
settings_shape_ok() {
    jq -e 'type == "object"
        and ((.enabledPlugins // {}) | type == "object")
        and ((.extraKnownMarketplaces // {}) | type == "object")' "$SETTINGS" >/dev/null 2>&1
}
# The declared plugins, one name@marketplace per line: the enabledPlugins entries that are
# exactly true, so a false entry is never read as declared (nor, through jq's //, as missing).
declared_plugins() {
    jq -r '.enabledPlugins // {} | to_entries[] | select(.value == true) | .key' "$SETTINGS" 2>/dev/null
}
# The declared marketplaces, one name=source per line, as `marketplace add` takes the source:
# the official one, then each extraKnownMarketplaces entry's directory path, or its repo or url.
# An entry that names none of them is printed with an empty source, for its row to report.
declared_marketplaces() {
    local entry
    printf '%s\n' "$OFFICIAL_MARKETPLACE"
    jq -r '.extraKnownMarketplaces // {} | to_entries[]
        | "\(.key)=\((try (.value.source | if .source == "directory" then .path else (.repo // .url) end)) // "")"' \
        "$SETTINGS" 2>/dev/null |
        while IFS= read -r entry; do
            # The renderer substitutes $HOME in these paths already; this guards a hand-edited
            # settings.json, whose literal $HOME, ${HOME} or ~ would read as a cloned source (and
            # go stale) and reach `marketplace add` as text.
            printf '%s=%s\n' "${entry%%=*}" "$(expand_home_path "${entry#*=}")"
        done
}
marketplace_declared() {   # $1 = a marketplace name
    local entry
    while IFS= read -r entry; do
        [[ "${entry%%=*}" == "$1" ]] && return 0
    done < <(declared_marketplaces)
    return 1
}

# Why marketplace $1 (source $2) needs a refresh, or nothing if it does not. Asked again after
# the add or update, so a failed one is a ✗ rather than a ✓ on every run.
market_why() {
    local name="$1" src="$2" loc updated age p
    if [[ "$(jq -r --arg m "$name" 'has($m)' "$KNOWN" 2>/dev/null)" != true ]]; then
        echo "not added"; return
    fi
    loc="$(jq -r --arg m "$name" '.[$m].installLocation // empty' "$KNOWN")"
    # Every plugin the settings declare from this marketplace must be one it lists.
    while IFS= read -r p; do
        [[ "${p##*@}" == "$name" ]] || continue
        jq -e --arg n "${p%@*}" 'any(.plugins[]; .name == $n)' "$loc/.claude-plugin/marketplace.json" \
            >/dev/null 2>&1 || { echo "does not list ${p%@*}"; return; }
    done < <(declared_plugins)
    # A directory marketplace is the checkout itself; only a cloned one goes stale. An update
    # moves lastUpdated even when upstream has not changed (measured 2026-10-14).
    [[ "$src" == /* ]] && return
    updated="$(jq -r --arg m "$name" '.[$m].lastUpdated // empty' "$KNOWN")"
    age=$(( ( $(date +%s) - $(date -d "${updated:-1970-01-01}" +%s 2>/dev/null || echo 0) ) / 86400 ))
    (( age > MARKET_MAX_AGE_D )) && echo "last updated ${age}d ago"
}

here_marketplaces() {
    local entry name src why after
    while IFS= read -r entry; do
        name="${entry%%=*}"; src="${entry#*=}"
        if [[ -z "$src" ]]; then
            row oper marketplace "$name: its extraKnownMarketplaces entry names no repo, url or path; not added"
            continue
        fi
        why="$(market_why "$name" "$src")"
        if [[ -z "$why" ]]; then
            row ok marketplace "$name"
            continue
        fi
        if [[ "$MODE" != apply ]]; then
            row drift marketplace "$name: $why"
            continue
        fi
        if [[ "$why" == "not added" ]]; then
            claude_plugin marketplace add "$src" --scope user
        else
            claude_plugin marketplace update "$name"
        fi
        after="$(market_why "$name" "$src")"
        if [[ -z "$after" ]]; then
            row ok marketplace "$name (was: $why)"
        else
            row drift marketplace "$name: still $after after --apply (log: ~/.local/state/host-sync/plugins.log)"
        fi
    done < <(declared_marketplaces)
}

# A directory-marketplace install is a COPY; an edit reaches it only through a version bump plus
# `plugin update` (docs/CLAUDE_SETUP.md, "Changing the plugin"). True when linear-key's installed
# copy has the checkout's version, or --apply has brought it there; otherwise its ✗ row is printed.
linear_key_current() {
    local have want
    have="$(plugin_version "$LINEAR_KEY")"
    want="$(json_get "$DOTFILES/claude/plugins/${LINEAR_KEY%@*}/.claude-plugin/plugin.json" '.version // empty')"
    [[ -z "$want" || "$have" == "$want" ]] && return 0
    if [[ "$MODE" != apply ]]; then
        row drift plugin "$LINEAR_KEY $have installed, checkout has $want"
        return 1
    fi
    claude_plugin marketplace update "${LINEAR_KEY##*@}"
    claude_plugin update "$LINEAR_KEY" --scope user
    have="$(plugin_version "$LINEAR_KEY")"
    [[ "$have" == "$want" ]] && return 0
    row drift plugin "$LINEAR_KEY update to $want failed"
    return 1
}

# One declared plugin's row: a person's step when no settings fragment declares its marketplace;
# ✓ when it is installed at user scope (and, for linear-key, current); else drift --apply installs.
here_plugin() {   # $1 = name@marketplace
    local plugin="$1" marketplace="${1##*@}" undeclared
    if ! marketplace_declared "$marketplace"; then
        undeclared="$plugin: marketplace $marketplace is declared by no settings fragment"
        if plugin_installed "$plugin"; then
            row oper plugin "$undeclared; installed, but its marketplace is not refreshed"
        else
            row oper plugin "$undeclared; not installed"
        fi
        return
    fi
    if plugin_installed "$plugin"; then
        if [[ "$plugin" != "$LINEAR_KEY" ]] || linear_key_current; then row ok plugin "$plugin"; fi
        return
    fi
    if [[ "$MODE" != apply ]]; then
        row drift plugin "$plugin not installed"
        return
    fi
    claude_plugin install "$plugin" --scope user
    if plugin_installed "$plugin"; then
        row ok plugin "$plugin (installed)"
    else
        row drift plugin "$plugin: install failed (log: ~/.local/state/host-sync/plugins.log)"
    fi
}

# Marketplaces first, so a plugin's install finds its marketplace added and current.
here_plugins() {
    local plugin
    if [[ ! -r "$SETTINGS" ]]; then
        row oper plugins "no ~/.claude/settings.json; log in to Claude Code on this machine first"
        return
    fi
    if ! settings_shape_ok; then
        row oper plugins "the live ~/.claude/settings.json is not an object with object enabledPlugins and extraKnownMarketplaces; plugins are not judged"
        return
    fi
    here_marketplaces
    while IFS= read -r plugin; do
        here_plugin "$plugin"
    done < <(declared_plugins)
}

here_mcp() {
    local out srv line
    (( NO_MCP )) && return 0
    # Status words only; the raw listing (URLs, header templates) is never printed.
    out="$(cd "$HOME" && timeout 120 "$CLAUDE" mcp list 2>/dev/null </dev/null)" || true
    for srv in slack notion; do
        if [[ "$(plugin_enabled "$srv@claude-plugins-official")" != true ]]; then
            row info mcp "$srv: sign-in state is readable once the plugin is enabled; expect a one-time /mcp sign-in on this host"
            continue
        fi
        line="$(grep -i "^plugin:$srv:" <<<"$out" | head -n 1)"
        case "$line" in
            *Connected*) row ok mcp "$srv connected" ;;
            *"Needs authentication"*)
                row oper mcp "$srv needs a sign-in on this host: open a Claude session on this host, run /mcp, choose plugin:$srv, Authenticate" ;;
            "") row oper mcp "$srv did not appear in \`claude mcp list\`" ;;
            *) row oper mcp "$srv failed to connect: ${line##* - }" ;;
        esac
    done
    # Checked whether or not linear-key is enabled yet: it is a step for a person, and
    # they should see it before --apply rather than after.
    # linear-key sends LINEAR_API_KEY from the session environment. On dev that comes from
    # ~/.zshrc.local, which herdr-server-launch.sh hands to the server at its start, exactly
    # as this probe reads it. The value never leaves the subshell, and the caller's own copy
    # is unset first, or a key exported in the invoking shell would read as "in the file".
    # shellcheck disable=SC2016  # expanded by the inner shell, deliberately
    if [[ -r "$HOME/.zshrc.local" ]] &&
        env -u LINEAR_API_KEY zsh -c 'source "$1" >/dev/null 2>&1; [[ -n "${LINEAR_API_KEY:-}" ]]' zsh "$HOME/.zshrc.local" \
            </dev/null 2>/dev/null; then
        row ok mcp "LINEAR_API_KEY is set in ~/.zshrc.local (checked by name)"
    else
        row oper mcp "LINEAR_API_KEY is not in this host's ~/.zshrc.local, so linear-key gets 401: add it by hand (never through a session); the herdr server reads it at its next start"
    fi
}

gib() { awk -v b="$1" 'BEGIN { printf "%.1fG", b / 1073741824 }'; }

# dev keeps a logged-out session's processes (KillUserProcesses is off, deliberately: it
# would kill whatever was left running on purpose). On 2026-10-13, 24 abandoned
# session-*.scope units held about 38 GB, mostly orphaned VS Code LSP runners. Stopping one
# is a system unit and needs sudo, so this only ever REPORTS, with the command to run.
here_sessions() {
    local u sub mem big=() names=() total=0 min=$(( SCOPE_MIN_MB * 1048576 )) mine
    command -v systemctl >/dev/null 2>&1 || return 0
    mine="user-$(id -u).slice"
    while read -r u _ _ sub _; do
        [[ "$sub" == abandoned ]] || continue
        # This user's sessions only: the box is shared, and another user's leftovers are theirs.
        [[ "$(systemctl show "$u" -p Slice --value 2>/dev/null)" == "$mine" ]] || continue
        mem="$(systemctl show "$u" -p MemoryCurrent --value 2>/dev/null)"
        [[ "$mem" =~ ^[0-9]+$ ]] || continue
        (( mem >= min )) || continue
        big+=("$u $(gib "$mem")"); names+=("$u")
        total=$(( total + mem ))
    done < <(systemctl list-units --all --no-legend --plain 'session-*.scope' 2>/dev/null)
    if (( ${#big[@]} == 0 )); then
        row ok sessions "no abandoned session scope over ${SCOPE_MIN_MB} MB"
        return
    fi
    row oper sessions "${#big[@]} abandoned session scope(s) hold $(gib "$total"); stop them from a terminal on this host:"
    printf '        %s\n' "${big[@]:0:10}"
    (( ${#big[@]} > 10 )) && printf '        … and %d more\n' $(( ${#big[@]} - 10 ))
    # The units by name, not a pipeline that re-lists them: that would stop every abandoned
    # session on the box, any size, any user. --plain above keeps a failed unit's leading ●
    # from shifting the columns read.
    printf '        sudo systemctl stop %s\n' "${names[*]}"
}

# The cap every agent and this script's own runs live under. It is set on dev with
# `systemctl --user set-property`, which writes drop-ins under ~/.config/systemd/user.control/,
# so the base unit file can say less than what is in force. Read the EFFECTIVE values, and
# FragmentPath, since a slice with no unit file reports MemoryMax=infinity (HERDR_GUIDE.md).
# host-sync never writes either file.
here_slice() {
    local frag high max drops
    command -v systemctl >/dev/null 2>&1 || return 0
    frag="$(systemctl --user show agents.slice -p FragmentPath --value 2>/dev/null)"
    if [[ -z "$frag" ]]; then
        row oper slice "agents.slice has no unit file, so nothing caps agents on this machine"
        return
    fi
    high="$(systemctl --user show agents.slice -p MemoryHigh --value 2>/dev/null)"
    max="$(systemctl --user show agents.slice -p MemoryMax --value 2>/dev/null)"
    drops="$(systemctl --user show agents.slice -p DropInPaths --value 2>/dev/null | wc -w)"
    [[ "$high" =~ ^[0-9]+$ ]] && high="$(gib "$high")"
    [[ "$max" =~ ^[0-9]+$ ]] && max="$(gib "$max")"
    row info slice "agents.slice MemoryHigh=$high MemoryMax=$max ($drops drop-in(s)); not managed here"
}

fetch_age_h() {   # hours since $1 was last fetched; 99999 if never
    local f="$1/.git/FETCH_HEAD"
    [[ -e "$f" ]] || { echo 99999; return; }
    echo $(( ( $(date +%s) - $(stat -c %Y "$f") ) / 3600 ))
}

here_clones() {
    local root="$HOME/$WORK_ORG" pair dir repo p have age n=0 stale=() failed=() oldest="" oldest_age=-1
    # A profile known to leave out the work tenant has no ~/quantivly to keep; unknown tenants do not skip.
    tenants_exclude "$WORK_TENANT" && return 0
    # --check writes nothing, not even the directory.
    [[ -d "$root" || "$MODE" != apply ]] || mkdir -p "$root"

    for pair in ${ARG_CLONES[@]+"${ARG_CLONES[@]}"}; do
        dir="${pair%%=*}"; repo="${pair#*=}"; p="$root/$dir"
        if [[ -e "$p" && ! -d "$p/.git" ]]; then
            row oper clone "$dir exists but is not a clone; not touched"
        elif [[ -d "$p/.git" ]]; then
            have="$(repo_of_url "$(git -C "$p" remote get-url origin 2>/dev/null)")"
            [[ "$have" == "$(tr '[:upper:]' '[:lower:]' <<<"$repo")" ]] ||
                row oper clone "$dir is ${have:-no origin} here and $repo on the laptop; not touched"
        elif [[ "$MODE" != apply ]]; then
            row drift clone "$dir missing (laptop: $repo)"
        elif git_net clone --quiet "$GITHUB_BASE/$repo.git" "$p" >/dev/null 2>&1; then
            # A clone writes no FETCH_HEAD, so the stale pass below reads it as "never
            # fetched" and fetches it in this same run; the next run then finds it fresh.
            row ok clone "$dir cloned from $repo"
        else
            row drift clone "$dir: git clone $repo failed"
        fi
    done

    for p in "$root"/*/; do
        p="${p%/}"
        [[ -d "$p/.git" ]] || continue                     # worktrees (.git file) and non-repos
        git -C "$p" remote get-url origin >/dev/null 2>&1 || continue
        n=$((n + 1))
        age="$(fetch_age_h "$p")"
        if [[ "$MODE" == apply ]]; then
            (( age >= FETCH_REFRESH_H )) || continue
            git_net -C "$p" fetch --quiet origin >/dev/null 2>&1 || failed+=("${p##*/}")
        else
            (( age >= FETCH_MAX_AGE_H )) || continue
            stale+=("${p##*/}")
            (( age > oldest_age )) && { oldest_age="$age"; oldest="${p##*/}"; }
        fi
    done
    if (( ${#failed[@]} )); then
        row drift clones "git fetch failed in ${failed[*]}"
    elif (( ${#stale[@]} )); then
        local when="${oldest_age}h ago"
        if (( oldest_age >= 99999 )); then when="never fetched"
        elif (( oldest_age >= 48 )); then when="$((oldest_age / 24))d ago"; fi
        row drift clones "${#stale[@]} of $n not fetched in ${FETCH_MAX_AGE_H}h (oldest: $oldest, $when); no checkout is changed"
    else
        row ok clones "$n clones under ~/$WORK_ORG fetched within ${FETCH_MAX_AGE_H}h"
    fi
}

# The state dir moved with the rename. --check reads whichever exists, the new one first, so a
# legacy host's install stamp is found where it is, and moves nothing.
pick_state_dir() {
    if [[ -d "$STATE_DIR" ]]; then STATE="$STATE_DIR"
    elif [[ -d "$LEGACY_STATE_DIR" ]]; then STATE="$LEGACY_STATE_DIR"
    else STATE="$STATE_DIR"; fi
}

# --apply, under the lock: its fd stays valid across the rename, and a run that opens the new
# path's lock afterwards finds the same inode held. When both dirs exist the new one wins and the
# legacy one is left as it is (an earlier partial run; one ./install at worst re-derives the stamp).
move_legacy_state_dir() {
    [[ -d "$LEGACY_STATE_DIR" && ! -e "$STATE_DIR" ]] || return 0
    mv "$LEGACY_STATE_DIR" "$STATE_DIR" && STATE="$STATE_DIR"
}

here_main() {
    DOTFILES="$HOME/.dotfiles"
    pick_state_dir
    CLAUDE="$HOME/.local/bin/claude"
    HERDR="$HOME/.local/bin/herdr"
    SETTINGS="$HOME/.claude/settings.json"
    INSTALLED="$HOME/.claude/plugins/installed_plugins.json"
    KNOWN="$HOME/.claude/plugins/known_marketplaces.json"
    TOKEN_DIR="$HOME/.config/claude-oauth"
    TOKEN_FILE="$TOKEN_DIR/token.env"
    # The file decides, not whatever the caller exported.
    unset CLAUDE_CODE_OAUTH_TOKEN
    TOKEN_LOADED=0
    token_layout
    load_token && TOKEN_LOADED=1
    # A non-interactive ssh and a user unit both lack ~/.local/bin (docs/HERDR_GUIDE.md).
    export PATH="$HOME/.local/bin:$PATH"
    # Children get dev's own agent when this run has none. A shell that finds no SSH_AUTH_SOCK
    # may start `ssh-agent -s`: the workstation template for ~/.zshrc.local does, and here_mcp
    # sources that file. The agent outlives the shell, and on 2026-11-03 dev had one orphan under
    # pid 1 per run. The stable link if it is not forwarded (its keys would be the laptop's), else
    # systemd's socket path, the shell's own Try 2: never forwarded, and non-empty even when the
    # socket is absent, so the block still starts nothing and ssh falls back to the key files.
    if [[ -z "${SSH_AUTH_SOCK:-}" ]]; then
        if [[ -L "$HOME/.ssh/ssh_auth_sock" ]] && ! agent_link_forwarded; then
            export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"
        else
            export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.socket"
        fi
    fi

    local tool
    for tool in git jq curl timeout flock; do
        command -v "$tool" >/dev/null 2>&1 || { echo "host-sync: $tool is required on $(hostname)" >&2; return 2; }
    done
    if [[ "$MODE" == apply ]]; then
        if [[ "$ARM" != 1 ]] && ! is_armed; then
            echo "host-sync: refusing --apply: this machine is not armed (no ~/.config/host-sync/armed)." >&2
            echo "          Arm it from the laptop: ~/.dotfiles/scripts/host-sync --host <alias> --apply" >&2
            return 2
        fi
        # --check writes nothing, so only --apply takes the lock (the timer and a laptop
        # run can otherwise overlap). The lock comes first, in the dir pick_state_dir chose, and
        # the legacy dir moves only under it. Only the new dir is ever created: a legacy dir that
        # a concurrent run renamed away must fail the open below, not come back empty and unlocked.
        if [[ "$STATE" == "$STATE_DIR" ]]; then mkdir -p "$STATE" || return 2; fi
        exec 9>"$STATE/lock" || { echo "host-sync: cannot open $STATE/lock" >&2; return 2; }
        flock -n 9 || { echo "host-sync: another run holds $STATE/lock" >&2; return 2; }
        move_legacy_state_dir
    fi

    # Every row runs with fd 9 closed, so no exec'd child can inherit the lock. A child that
    # daemonizes keeps every descriptor it inherited, and a flock lives as long as any of
    # them: from 10-17 to 11-03 an ssh-agent started under one --apply held it, and every
    # later run was refused. bash parks its own copy of fd 9 on a close-on-exec descriptor
    # for the call, so this run still holds the lock while no exec'd child can.
    here_rows 9>&-
}

# The rows and the summary, run by here_main with the lock's fd closed for every child.
here_rows() {
    printf 'host-sync %s on %s, %s\n' "$MODE" "$(hostname)" "$(date '+%F %T %Z')"
    [[ -n "$ARG_CLAUDE$ARG_DOTFILES_SHA" ]] ||
        printf '  (no laptop facts: targets are origin/main, Claude Code latest, herdr-draft main)\n'

    # Order matters. The overlay is cloned first: dotfiles' ./install renders settings from it, and
    # the renderer refuses (exit 2) a host with a profile marker and no overlay; the profile is
    # read again after that clone. dotfiles' ./install links the timer's units and the dotfiles
    # marketplace's plugin, so the checkouts go before both. settings and links come after both
    # checkouts have fast-forwarded and installed, so the render reads the overlay's current
    # fragments and the links its current manifest; plugins come after settings, since what the
    # plugin rows install is what the render declares (H4). The generated skills come after herdr
    # and herdr-draft, so each is what the binary this run left in place prints.
    read_profile
    clone_overlay
    here_dotfiles
    here_dotfiles_local
    here_profile
    here_timer
    here_claude
    here_auth
    here_agent
    here_herdr
    here_draft
    here_skills
    here_settings
    here_links
    here_plugins
    here_mcp
    here_clones
    here_slice
    here_sessions

    printf '\n'
    if (( N_DRIFT )); then
        if [[ "$MODE" == apply ]]; then
            printf '%d item(s) still drifted after --apply; see the ✗ rows.\n' "$N_DRIFT"
        else
            printf '%d item(s) drifted; host-sync --apply (from the laptop: --host <alias>) fixes the ✗ rows.\n' "$N_DRIFT"
        fi
    else
        printf 'Level.\n'
    fi
    (( N_OPER )) && printf '%d step(s) need a person; see the ⚠ rows.\n' "$N_OPER"
    (( N_DRIFT )) && return 1
    return 0
}

# ==============================================================================================
# The laptop half
# ==============================================================================================

laptop_facts() {   # fills FACTS; notes go to stderr
    local v root d url repo
    FACTS=()

    v="$("$HOME/.local/bin/claude" --version 2>/dev/null </dev/null | awk 'NR==1{print $1}')"
    if [[ "$v" =~ $VER_RE ]]; then FACTS+=(--claude-version "$v")
    else echo "host-sync: no Claude Code version on this machine; the host will target latest" >&2; fi

    v="$("$HOME/.local/bin/herdr" --version 2>/dev/null | awk 'NR==1{print $2}')"
    if [[ "$v" =~ $VER_RE ]]; then
        FACTS+=(--herdr-version "$v" --herdr-arch "$(uname -m)")
        v="$(sha256sum "$(readlink -f "$HOME/.local/bin/herdr")" 2>/dev/null | cut -c1-64)"
        [[ "$v" =~ ^[0-9a-f]{64}$ ]] && FACTS+=(--herdr-sha256 "$v")
    fi

    local remote="${HOST_SYNC_DOTFILES_REMOTE:-origin}"
    v="$(git_net -C "$SELF_REPO" ls-remote "$remote" refs/heads/main 2>/dev/null | cut -f1)"
    [[ "$v" =~ $SHA_RE ]] && FACTS+=(--dotfiles-sha "$v")
    # The overlay's main, when this machine has the checkout (.git is a file in a worktree).
    if [[ -e "$DOTFILES_LOCAL/.git" ]]; then
        local overlay_remote="${HOST_SYNC_DOTFILES_LOCAL_REMOTE:-origin}"
        v="$(git_net -C "$DOTFILES_LOCAL" ls-remote "$overlay_remote" refs/heads/main 2>/dev/null | cut -f1)"
        [[ "$v" =~ $SHA_RE ]] && FACTS+=(--dotfiles-local-sha "$v")
    fi

    root="$HOME/$WORK_ORG"
    for d in "$root"/*/; do
        d="${d%/}"
        [[ -d "$d/.git" ]] || continue                     # main clones only, not worktrees
        url="$(git -C "$d" remote get-url origin 2>/dev/null)" || continue
        [[ "$url" == *github* ]] || continue
        repo="$(repo_of_url "$url")"
        [[ "$repo" == "$WORK_ORG"/* && "$repo" != "$WORK_ORG/dotfiles" ]] || continue
        [[ "${d##*/}" =~ $SAFE_DIR_RE && "$repo" =~ $SAFE_REPO_RE ]] || continue
        FACTS+=(--clone "${d##*/}=$repo")
    done
}

# Append --dotfiles-behind and --dotfiles-local-behind to FACTS: how far the host's heads ($1 for
# ~/.dotfiles, $2 for ~/.dotfiles-local) are behind the mains the facts carry. Counted here, from
# this machine's own checkouts, because the host may not have fetched those commits and check mode
# will not fetch. A count needs both commits here; without them the fact is left out and the
# host's row says "?".
add_behind_facts() {
    local dotfiles_head="$1" overlay_head="$2" i dotfiles_behind="" overlay_behind=""
    for (( i = 0; i < ${#FACTS[@]}; i++ )); do
        case "${FACTS[i]}" in
            --dotfiles-sha)
                [[ "$dotfiles_head" =~ $SHA_RE ]] &&
                    dotfiles_behind="$(git -C "$SELF_REPO" rev-list --count "$dotfiles_head..${FACTS[i+1]}" 2>/dev/null)" ;;
            --dotfiles-local-sha)
                [[ "$overlay_head" =~ $SHA_RE ]] &&
                    overlay_behind="$(git -C "$DOTFILES_LOCAL" rev-list --count "$overlay_head..${FACTS[i+1]}" 2>/dev/null)" ;;
        esac
    done
    [[ "$dotfiles_behind" =~ $COUNT_RE ]] && FACTS+=(--dotfiles-behind "$dotfiles_behind")
    [[ "$overlay_behind" =~ $COUNT_RE ]] && FACTS+=(--dotfiles-local-behind "$overlay_behind")
}

laptop_main() {
    local host="" mode="check" print_only=0 arg
    while (( $# )); do
        case "$1" in
            --check) mode=check ;;
            --apply) mode=apply ;;
            --print-facts) print_only=1 ;;
            --host) host="${2:-}"; shift ;;
            --host=*) host="${1#--host=}" ;;
            -h|--help) usage; return 0 ;;
            *) echo "host-sync: unknown option $1" >&2; usage >&2; return 64 ;;
        esac
        shift
    done
    [[ -n "$host" ]] || {
        echo "host-sync: --host <ssh alias> is required (or --here on the host itself)" >&2
        usage >&2
        return 64
    }
    [[ "$host" =~ $HOST_ALIAS_RE ]] || { echo "host-sync: refusing unsafe --host '$host'" >&2; return 64; }
    for arg in git jq; do command -v "$arg" >/dev/null 2>&1 || { echo "host-sync: $arg is required" >&2; return 2; }; done

    laptop_facts
    if (( print_only )); then
        printf '%s\n' "${FACTS[@]}" | paste -d' ' - -
        return 0
    fi

    # ForwardAgent=no whatever ssh_config says: a forwarded agent's socket on dev is usable by any
    # process there while the run is open, and every child would inherit it.
    local ssh_cmd="${HOST_SYNC_SSH:-ssh -o BatchMode=yes -o ConnectTimeout=30 -o ForwardAgent=no}"
    local host_heads dotfiles_head="" overlay_head="" remote_args
    # Both of the host's heads in one round trip, one line each. Every line is a sha or "none", so
    # a host with no ~/.dotfiles never shifts ~/.dotfiles-local's head into the first line.
    local heads_probe='git -C ~/.dotfiles rev-parse --verify --quiet HEAD 2>/dev/null || echo none;'
    heads_probe+=' git -C ~/.dotfiles-local rev-parse --verify --quiet HEAD 2>/dev/null || echo none'
    host_heads="$($ssh_cmd "$host" "$heads_probe" 2>/dev/null </dev/null)"
    { IFS= read -r dotfiles_head; IFS= read -r overlay_head; } <<<"$host_heads"
    if [[ ! "$dotfiles_head" =~ $SHA_RE ]]; then
        if ! $ssh_cmd "$host" true </dev/null; then
            echo "host-sync: cannot reach '$host' over ssh (SSM ProxyCommand failed: run dev-link-doctor)" >&2
            return 2
        fi
    fi
    add_behind_facts "$dotfiles_head" "$overlay_head"
    [[ "$mode" == apply ]] && FACTS+=(--arm)

    # Every fact is already filtered where laptop_facts gathers it, so this cannot fire today
    # (a mutation sweep confirms it is unreachable). It stays because this is the line that
    # would inject into dev's login shell (zsh) if a later fact were added without a filter.
    for arg in "${FACTS[@]}"; do
        [[ "$arg" =~ ^[A-Za-z0-9._=/-]+$ ]] || { echo "host-sync: refusing unsafe fact: $arg" >&2; return 2; }
    done
    remote_args="--here --$mode ${FACTS[*]}"
    local scope='systemd-run --user --scope --quiet --slice=agents.slice -p MemoryMax=3G -p CPUQuota=200% --nice=10 --'
    [[ -n "${HOST_SYNC_NO_SCOPE:-}" ]] && scope=""

    local redact="$SELF_REPO/scripts/redact-secrets.sh" rc
    [[ -x "$redact" ]] || redact="cat"
    $ssh_cmd "$host" "export PATH=\"\$HOME/.local/bin:\$PATH\"; $scope bash -s -- $remote_args" <"$SELF" | "$redact"
    rc="${PIPESTATUS[0]}"
    (( rc == 255 )) && { echo "host-sync: ssh to '$host' failed" >&2; return 2; }
    # Anything else is the remote bash killed or never started (137 is an OOM kill), not drift.
    case "$rc" in
        0|1|2|64) return "$rc" ;;
        *) echo "host-sync: the run on '$host' ended with status $rc (killed?)" >&2; return 2 ;;
    esac
}

main() {
    MODE="check"; ARM=0; NO_MCP=0
    ARG_CLAUDE=""; ARG_HERDR=""; ARG_HERDR_SHA=""; ARG_HERDR_ARCH=""; ARG_DOTFILES_SHA=""; ARG_DOTFILES_BEHIND=""
    ARG_DOTFILES_LOCAL_SHA=""; ARG_DOTFILES_LOCAL_BEHIND=""
    ARG_CLONES=()
    if [[ "${1:-}" != --here ]]; then
        SELF="$(readlink -f "${BASH_SOURCE[0]}")"
        SELF_REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
        laptop_main "$@"
        return
    fi
    shift
    while (( $# )); do
        case "$1" in
            --check) MODE=check ;;
            --apply) MODE=apply ;;
            --arm) ARM=1 ;;
            --no-mcp) NO_MCP=1 ;;
            --claude-version) ARG_CLAUDE="${2:-}"; shift ;;
            --herdr-version) ARG_HERDR="${2:-}"; shift ;;
            --herdr-sha256) ARG_HERDR_SHA="${2:-}"; shift ;;
            --herdr-arch) ARG_HERDR_ARCH="${2:-}"; shift ;;
            --dotfiles-sha) ARG_DOTFILES_SHA="${2:-}"; shift ;;
            --dotfiles-behind) ARG_DOTFILES_BEHIND="${2:-}"; shift ;;
            --dotfiles-local-sha) ARG_DOTFILES_LOCAL_SHA="${2:-}"; shift ;;
            --dotfiles-local-behind) ARG_DOTFILES_LOCAL_BEHIND="${2:-}"; shift ;;
            --clone) ARG_CLONES+=("${2:-}"); shift ;;
            *) echo "host-sync: unknown option $1" >&2; return 64 ;;
        esac
        shift
    done
    # Validate everything that arrives over the wire before any of it reaches a command.
    [[ "$DOTFILES_LOCAL_REPO" =~ $SAFE_REPO_RE ]] || { echo "host-sync: bad HOST_SYNC_DOTFILES_LOCAL_REPO (want owner/repo)" >&2; return 64; }
    [[ -z "$ARG_CLAUDE" || "$ARG_CLAUDE" =~ $VER_RE ]] || { echo "host-sync: bad --claude-version" >&2; return 64; }
    [[ -z "$ARG_DOTFILES_SHA" || "$ARG_DOTFILES_SHA" =~ $SHA_RE ]] || { echo "host-sync: bad --dotfiles-sha" >&2; return 64; }
    [[ -z "$ARG_DOTFILES_BEHIND" || "$ARG_DOTFILES_BEHIND" =~ $COUNT_RE ]] || { echo "host-sync: bad --dotfiles-behind" >&2; return 64; }
    [[ -z "$ARG_DOTFILES_LOCAL_SHA" || "$ARG_DOTFILES_LOCAL_SHA" =~ $SHA_RE ]] ||
        { echo "host-sync: bad --dotfiles-local-sha" >&2; return 64; }
    [[ -z "$ARG_DOTFILES_LOCAL_BEHIND" || "$ARG_DOTFILES_LOCAL_BEHIND" =~ $COUNT_RE ]] ||
        { echo "host-sync: bad --dotfiles-local-behind" >&2; return 64; }
    [[ -z "$ARG_HERDR" || "$ARG_HERDR" =~ $VER_RE ]] || { echo "host-sync: bad --herdr-version" >&2; return 64; }
    [[ -z "$ARG_HERDR_SHA" || "$ARG_HERDR_SHA" =~ ^[0-9a-f]{64}$ ]] || { echo "host-sync: bad --herdr-sha256" >&2; return 64; }
    [[ -z "$ARG_HERDR_ARCH" || "$ARG_HERDR_ARCH" =~ ^[a-z0-9_]+$ ]] || { echo "host-sync: bad --herdr-arch" >&2; return 64; }
    local c
    for c in ${ARG_CLONES[@]+"${ARG_CLONES[@]}"}; do
        [[ "${c%%=*}" =~ $SAFE_DIR_RE && "${c#*=}" =~ $SAFE_REPO_RE && "$c" == *=* ]] ||
            { echo "host-sync: bad --clone $c (want dir=owner/repo)" >&2; return 64; }
    done
    here_main
}

# Everything above is definitions. bash reads a script incrementally, and --apply
# fast-forwards the checkout this file lives in, so the whole program must be parsed
# before anything runs. Keep the call and the exit on this one line.
main "$@"; exit $?
