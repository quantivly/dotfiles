#!/usr/bin/env zsh
#
# claude-pick — which Claude account should this directory's next session bill?
# =============================================================================
#
# The picker in zsh/zshrc.herdr, as a command, for callers that are not a zsh
# function: herdr-draft's create dialog, a script, a human asking why. It makes
# no decision of its own — every answer comes from `_claude_pick_for_dir`, so the
# CLI and an interactive `claude` cannot disagree about which account a directory
# should use. That is the whole point of it being a wrapper and not a
# reimplementation.
#
#   claude-pick                          # the profile name, one line
#   claude-pick --explain                # ...and the per-candidate table on stderr
#   claude-pick --dir ~/work/api --json  # machine-readable, for herdr-draft
#   claude-pick --strict --json          # headless: refuse rather than proceed
#
# EXIT CODES are the contract, and each one is a different action for the caller:
#
#   0   picked; stdout is the profile (or the JSON object)
#   2   refused — every pool member's 5h window is spent, or nothing in the pool
#       is usable at all. stderr names each member and its reset time. Or, with
#       --gate, the picked seat's PROJECTED end-utilisation exceeds the cap
#       (state gate-projected), its 5h window is unmeasured or stale (state
#       gate-unmeasured), or a tuning value does not parse (state
#       gate-misconfigured) — see THE SEAT GATE below.
#   3   refused — a machine ceiling (CLAUDE_PICK_LOAD_MAX / _SWAP_MAX) was
#       exceeded. Only reachable with --strict and without --force, and only when
#       such a ceiling is explicitly set: warn-only is the default, because this
#       box is deliberately oversubscribed and must keep working.
#   4   the tenant table, or the tenant given, is unusable — a fix in
#       ~/.config/claude-tenants.zsh, not something to retry.
#   5   no clauth profile has a credential (clauth absent, or nothing
#       registered). `clauth login <name>`.
#   64  usage error. Conventional (EX_USAGE), and deliberately far away from the
#       refusals so a caller cannot confuse "you called me wrong" with "the
#       accounts are spent".
#
# THE SEAT GATE (--gate --model M --effort E [--est-minutes N], WS4' Task 0).
# The one implementation of "may a headless lane start on this seat" that
# `rabota budget`, `hspawn`, herdr-draft and Sol all call, so two thresholds
# cannot disagree. After a successful pick it computes
#
#   projected = u5 + rate(model, effort) × est_minutes / 60      (integer points)
#
# and refuses (exit 2) when projected > CLAUDE_PICK_GATE_MAX (95), or when u5 is
# unmeasured — "unknown" must never read as room. The rate is points of the 5h
# window per lane-hour, read from the zsh associative array CLAUDE_PICK_RATES in
# ~/.config/claude-tenants.zsh, keyed "<model>:<effort>":
#
#   typeset -gA CLAUDE_PICK_RATES
#   CLAUDE_PICK_RATES[claude-fable-5-1:high]=115
#
# An unlisted pair uses CLAUDE_PICK_RATE_DEFAULT (115: the WORST rate measured on
# 2026-09-16, the WS1 fix lane, 19 points in 10 minutes). Sonnet has no measured
# rate and deliberately uses Fable's until census has recorded five Sonnet lanes.
# The default est_minutes is 30, so a Fable-high lane starts only at u5 <= 37%.
# Environment strings are NOT a rate source: only the array, and only that file.
#
# A STALE READING IS AN UNMEASURED ONE. u5 comes from the profile's
# usage_cache.json, and the gate refuses (state gate-unmeasured) when that file
# is older than CLAUDE_PICK_CACHE_MAX_AGE seconds — default 600 HERE, against
# 3600 in the ranker (zshrc.herdr), which deliberately tolerates an older
# reading because it only ORDERS candidates and there is no refresher that keeps
# caches fresher than that. The gate decides whether a headless lane may burn a
# seat unwatched: a seat at 30% three hours ago can be at 100% now (F13 — two
# profiles went 7% → 100% in forty minutes), so the number is not evidence past
# ten minutes. Setting the variable sets BOTH thresholds; that is the trade the
# fix brief asked for, stated rather than hidden. What the gate CANNOT see is
# clauth's own freshness verdict: `clauth status` reports `stale` and
# `fetch_status` per profile, but neither reaches usage_cache.json (measured
# 2026-09-17: its keys are five_hour, seven_day, weekly_scoped, plan, spend,
# extra_usage — no freshness field), and this script reads only that file. So a
# profile clauth has marked stale is refused here only by its file's mtime.
# `rabota census` reads clauth's verdict directly and names it in unavailable[].
#
# A ROLLED WINDOW IS AN UNMEASURED ONE TOO, AND THE MTIME CANNOT SEE IT. The
# mtime test alone let a `touch`ed three-hour-old cache pass, and ignored a
# five_hour.resets_at already in the past — the window the number describes
# has ended, so the number is about nothing, however new the file is. A real
# clauth write rewrites content and mtime together, which makes this low-risk,
# not absent, and this is a safety gate. So after the mtime test the gate reads
# the parsed reset: an instant in the past refuses (state gate-unmeasured, the
# same sentence the mtime refusal says), and an ABSENT or UNPARSEABLE reset
# refuses as well — unmeasured, never optimistic. Note what that second rule
# costs: clauth omits resets_at for a window that has not started (measured
# 2026-09-10, absent exactly where utilization is 0.0), so a seat on a fresh,
# unstarted window is refused here until its first request stamps a reset. The
# ranker (zshrc.herdr) still scores such a seat; only the headless gate declines
# to start a lane on a window it cannot date. The instant is reported in the
# gate object as resets_at (RFC 3339 UTC, or null) beside cache_age_s.
#
# EVERY TUNING VALUE IS VALIDATED BEFORE IT IS USED, AND A BAD ONE REFUSES.
# CLAUDE_PICK_GATE_MAX, CLAUDE_PICK_RATE_DEFAULT and the CLAUDE_PICK_RATES entry
# in use must be positive integers; CLAUDE_PICK_CACHE_MAX_AGE a non-negative
# one; --est-minutes a positive one (a zero-length lane is not a request, and is
# the usage error 64 like any other bad argument). Anything else is state
# gate-misconfigured, exit 2, with a reason naming the variable and the value it
# got. NEVER a silent 0 and NEVER a fallback to the default: measured before the
# fix, RATE_DEFAULT=abc allowed a 90% seat with the rate read as 0, RATE_DEFAULT=
# -100 SUBTRACTED and allowed it at 40, and GATE_MAX=1x made the comparison an
# arithmetic error whose failure read as "not over the cap". Falling back to the
# default would hide the operator's typo behind the right answer, which is how
# the typo becomes permanent.
#
# A pinned seat (--profile) still goes through the gate — it is the one thing a
# pin does not override, because the gate is about the window, not the choice.
# The JSON object carries "gate": {model, effort, est_minutes, rate, projected,
# max, cache_age_s, cache_max_age_s, resets_at, verdict: allow|refuse}, or null
# when --gate was not given. cache_age_s is the age the decision was made on
# (null only when there is no usage cache at all), cache_max_age_s the
# threshold applied, and resets_at the parsed 5h reset the decision was made on
# (null when absent or unparseable) — so a consumer can tell "refused as stale"
# from "refused as absent" from "refused as rolled" without parsing the reason.
#
# --strict IS THE ONLY THING THAT SWITCHES SEMANTICS, and there is no TTY
# sniffing. §5.4 defines interactive by "a TTY on stderr" for `claude`, where the
# shell already knows; for a CLI, a command whose refusal behaviour changes
# depending on whether its output happens to be a pipe is a command whose rows
# and whose callers both become conditional. herdr-draft passes --strict itself
# (§5.6), which is the spec's own arrangement.
#
# NEVER A CREDENTIAL. It reads usage_cache.json, profiles.toml (a bounded sed
# range, for the quarantine list only), config.toml (`grep -q`, a boolean that is
# never echoed) and clauth's live_sessions/*.json (profile and pid fields only).
# The only cache-derived string it ever prints is the plan tier. A state-table
# row plants a token-shaped canary in every one of those files and asserts it
# reaches neither stdout nor stderr on ANY exit path — see
# scripts/test-claude-pick.sh, "canary".
#
# IT DOES NOT SOURCE system.sh. --explain prints plain lines of its own rather
# than borrowing the _doctor_* emitters: system.sh is the full install's, a
# modular herdr adopter does not have it, and a CLI that dies on a missing module
# is a CLI that fails at the one moment its answer is wanted.

emulate -L zsh
setopt no_aliases

PROG=claude-pick

usage() {
  print -r -- "Usage: $PROG [--dir D] [--tenant T] [--profile P] [--strict] [--force]"
  print -r -- "              [--json] [--explain] [--dry-run]"
  print -r -- "              [--gate --model M --effort E [--est-minutes N]]"
  print -r -- ""
  print -r -- "  --dir D       the directory to route for (default: \$PWD)"
  print -r -- "  --tenant T    pin the tenant; skips the resolver, not the ranking"
  print -r -- "  --profile P   pin the account outright; no ranking at all"
  print -r -- "  --strict      headless: refuse an exhausted pool instead of"
  print -r -- "                proceeding on its least-bad member"
  print -r -- "  --force       proceed past a machine ceiling that would refuse"
  print -r -- "  --json        one object on stdout instead of the bare name"
  print -r -- "  --explain     the per-candidate table, on stderr"
  print -r -- "  --dry-run     do not write the ledger and do not build the"
  print -r -- "                account dir (config_dir is then null)"
  print -r -- "  --gate --model M --effort E [--est-minutes N]"
  print -r -- "                refuse (exit 2) when the picked seat's projected 5h"
  print -r -- "                use exceeds 95% (CLAUDE_PICK_GATE_MAX), or is unmeasured,"
  print -r -- "                or its usage reading is older than 600 s"
  print -r -- "                (CLAUDE_PICK_CACHE_MAX_AGE), or its 5h reset is"
  print -r -- "                already past, absent or unreadable, or a tuning"
  print -r -- "                value does not parse (never a silent default)"
  print -r -- ""
  print -r -- "Exit: 0 picked · 2 refused (exhausted, or the gate) · 3 refused (machine)"
  print -r -- "      4 unusable tenant table · 5 no profiles · 64 usage"
}

die_usage() {
  print -u2 -- "$PROG: $1"
  usage >&2
  exit 64
}

dir="$PWD" tenant="" pin="" strict=0 force=0 as_json=0 explain=0 dry=0
gate=0 gate_model="" gate_effort="" gate_minutes=30 gate_rate="" gate_projected="" gate_verdict=""
gate_max="" gate_max_age="" gate_rate_src="" gate_fault=""

# --est-minutes: a positive integer. 0 is not a lane; "abc" is not a number.
est_minutes_ok() { [[ "${1:-}" == <-> ]] && (( $1 > 0 )) }

while (( $# )); do
  case "$1" in
    --dir)      [[ -n "${2:-}" ]] || die_usage "--dir needs a directory"; dir="$2"; shift 2 ;;
    --dir=*)    dir="${1#--dir=}";  [[ -n "$dir" ]]    || die_usage "--dir needs a directory"; shift ;;
    --tenant)   [[ -n "${2:-}" ]] || die_usage "--tenant needs a non-empty value"; tenant="$2"; shift 2 ;;
    --tenant=*) tenant="${1#--tenant=}"; [[ -n "$tenant" ]] || die_usage "--tenant needs a non-empty value"; shift ;;
    --profile)  [[ -n "${2:-}" ]] || die_usage "--profile needs a non-empty value"; pin="$2"; shift 2 ;;
    --profile=*) pin="${1#--profile=}"; [[ -n "$pin" ]] || die_usage "--profile needs a non-empty value"; shift ;;
    --strict)   strict=1; shift ;;
    --force)    force=1; shift ;;
    --json)     as_json=1; shift ;;
    --explain)  explain=1; shift ;;
    --dry-run)  dry=1; shift ;;
    --gate)         gate=1; shift ;;
    --model)        [[ -n "${2:-}" ]] || die_usage "--model needs a value";  gate_model="$2";  shift 2 ;;
    --model=*)      gate_model="${1#--model=}";   [[ -n "$gate_model" ]]  || die_usage "--model needs a value";  shift ;;
    --effort)       [[ -n "${2:-}" ]] || die_usage "--effort needs a value"; gate_effort="$2"; shift 2 ;;
    --effort=*)     gate_effort="${1#--effort=}"; [[ -n "$gate_effort" ]] || die_usage "--effort needs a value"; shift ;;
    --est-minutes)  est_minutes_ok "${2:-}" || die_usage "--est-minutes needs a positive integer (got '${2:-}')"; gate_minutes="$2"; shift 2 ;;
    --est-minutes=*) gate_minutes="${1#--est-minutes=}"; est_minutes_ok "$gate_minutes" || die_usage "--est-minutes needs a positive integer (got '$gate_minutes')"; shift ;;
    -h|--help)  usage; exit 0 ;;
    --)         shift; (( $# )) && die_usage "unexpected argument: $1"; break ;;
    *)          die_usage "unknown option: $1" ;;
  esac
done

if (( gate )); then
  [[ -n "$gate_model" && -n "$gate_effort" ]] || die_usage "--gate needs --model and --effort"
fi

command -v jq >/dev/null 2>&1 || {
  print -u2 -- "$PROG: jq is required (every usage figure is read out of JSON)"
  exit 5
}

# WHICH CHECKOUT. Resolved from this script's own path, so a worktree's copy uses
# its own functions rather than whatever ~/.dotfiles happens to be pointing at —
# in this repo a checkout IS the deployment, and a CLI that reached across to the
# primary would report about code the caller is not running.
_self="${${(%):-%x}:A}"
DOTROOT="${_self:h:h}"
[[ -r "$DOTROOT/zsh/zshrc.herdr" ]] || {
  print -u2 -- "$PROG: cannot read $DOTROOT/zsh/zshrc.herdr"
  exit 5
}

# The marker the herdr layer honours: source the picker, and nothing that has a
# side effect. github.sh first and deliberately — _claude_tenant_for REUSES its
# _gh_repo_remotes / _gh_url_owner rather than carrying a second URL parser, so
# without it the owner half of the tenant table cannot be evaluated at all and
# the resolver reports `unsupported`. Both files are declarations and function
# definitions only.
export CLAUDE_PICK_SOURCING=1
[[ -r "$DOTROOT/zsh/functions/github.sh" ]] && source "$DOTROOT/zsh/functions/github.sh"
source "$DOTROOT/zsh/zshrc.herdr" >/dev/null 2>&1

(( $+functions[_claude_pick_for_dir] )) || {
  print -u2 -- "$PROG: the picker is not defined after sourcing the herdr layer"
  exit 5
}

# Every name the picker reports through, declared here so a stray global cannot
# leak in from the environment and be reported as a measurement.
typeset _claude_pick_state="" _claude_pick_class="" _claude_pick_reason=""
typeset _claude_pick_score="" _claude_pick_tenant="" _claude_pick_tenant_state=""
typeset _claude_pick_u5=unknown _claude_pick_uw=unknown _claude_pick_r5=unknown
typeset _claude_pick_rw=unknown _claude_pick_age=unknown _claude_pick_tier=unknown
typeset _claude_pick_r5_at=unknown _claude_pick_rw_at=unknown
typeset _claude_pick_holders=0 _claude_pick_load="" _claude_pick_overflow=0
typeset _claude_pick_leastbad="" _claude_pick_leastbad_r5=unknown
typeset _CML_LOAD1=unknown _CML_NCPU=unknown _CML_SWAPPCT=unknown
typeset -a _claude_pick_skipped=() _claude_pick_warnings=()
typeset -a _claude_pick_explain=() _claude_pick_exhausted=()
typeset -a _claude_pick_cands=() _claude_pick_unknowns=()
typeset -a _claude_pick_pool_members=() _claude_pick_overflow_members=()
typeset _claude_pick_dry_run="$dry"
typeset _claude_pick_prog="$PROG"
typeset REPLY=""
# Loop and result scratch. `typeset`, not `local`: zsh tolerates `local` at a
# script's top level, but this repo has already paid for `local` outside a
# function once — in a backgrounded block, where it IS an error and the message
# went to a subshell's stderr nobody reads. Declaring them here also keeps `local
# NAME` out of a loop body, which in zsh is a DISPLAY command on a name already
# local in that scope.
typeset e config_dir builder rc pin_class
typeset -a f skip_rows

#-----------------------------------------------------------------------------
# helpers

# A JSON array of strings from the arguments, with NO fork per element and no
# empty-array trap: `printf '%s\n' "${arr[@]}"` on an empty array still prints
# one newline, which becomes [""] — an empty list reported as a list of one
# blank. NUL-delimited, so a value containing a newline cannot forge an element.
json_strings() {
  (( $# )) || { print -r -- '[]'; return 0 }
  printf '%s\0' "$@" | jq -Rs 'split("\u0000")[:-1]'
}

# A JSON number, or null for the literal `unknown` and for anything that is not
# an integer. An UNKNOWN MUST NOT BECOME 0: the whole metrics layer exists to
# keep "absent" and "measured zero" apart, and collapsing them here would undo it
# at the last step, in the output a machine consumes.
json_num() {
  [[ "${1:-}" == (-|)<-> ]] && { print -r -- "$1"; return 0 }
  print -r -- null
}

# RFC 3339 in UTC from an ABSOLUTE epoch, or null. JSON carries UTC and
# the human lines carry local time (§5.4) — one instant, two renderings, and the
# machine-readable one is the unambiguous one.
#
# AN ABSOLUTE EPOCH, NOT A DELTA, and that is DO-612. This took `EPOCHSECONDS + d`
# from the remaining-seconds figure the metrics layer publishes — so the instant
# was rebuilt from two separate reads of the clock, the one that produced `d` and
# this one, and any second boundary falling between them rendered it one second
# late. Measured on this suite before the fix: the row asserting this field
# failed 1 run in 6, always by exactly +1s, never early. A consumer quotes the
# field back to a human as "your window resets at X", so it drifted later every
# time it was re-rendered. The metrics layer publishes the parsed instant now and
# nothing here reads the clock at all.
json_instant() {
  local at="${1:-}" TZ=UTC out
  [[ "$at" == (-|)<-> ]] || { print -r -- null; return 0 }
  zmodload zsh/datetime 2>/dev/null || { print -r -- null; return 0 }
  strftime -s out '%Y-%m-%dT%H:%M:%SZ' "$at" 2>/dev/null \
    || { print -r -- null; return 0 }
  printf '%s' "$out" | jq -Rs .
}

# The same instant for a REASON string: the bare RFC 3339 UTC text, or the
# literal `unknown`. Not json_instant, whose output is JSON-quoted and would put
# a pair of double quotes into a sentence; not a local-time rendering, because a
# reason lands in a log read from other machines and the JSON beside it is UTC.
text_instant() {
  local at="${1:-}" TZ=UTC out
  [[ "$at" == (-|)<-> ]] || { print -r -- unknown; return 0 }
  zmodload zsh/datetime 2>/dev/null || { print -r -- unknown; return 0 }
  strftime -s out '%Y-%m-%dT%H:%M:%SZ' "$at" 2>/dev/null \
    || { print -r -- unknown; return 0 }
  print -r -- "$out"
}

# load1 as a decimal, from the x100 integer the measurement publishes. Built as
# text rather than divided, because this file is integer-only for the same reason
# the picker is: no zsh/mathfunc, which the state table's from-scratch PATH
# cannot vouch for.
json_load1() {
  [[ "$_CML_LOAD1" == <-> ]] || { print -r -- null; return 0 }
  print -r -- "$(( _CML_LOAD1 / 100 )).${(l:2::0:)$(( _CML_LOAD1 % 100 ))}"
}

# The same number for a human. Two renderings of one unmeasured value,
# deliberately: JSON must say `null` so a consumer can tell "not measured" from a
# number, and the report must say `unknown`, which is the word every other
# unmeasured field in this repo uses. Neither is ever 0.
text_load1() {
  [[ "$_CML_LOAD1" == <-> ]] || { print -r -- unknown; return 0 }
  print -r -- "$(( _CML_LOAD1 / 100 )).${(l:2::0:)$(( _CML_LOAD1 % 100 ))}"
}

# `unknown`, never `unknown%`: a percent sign on a word that is not a number
# reads as a measurement of nothing. Same rule the exhaustion report applies to
# an unread weekly figure.
text_pct() {
  [[ "${1:-}" == <-> ]] || { print -r -- unknown; return 0 }
  print -r -- "$1%"
}

#-----------------------------------------------------------------------------
# the decision

rc=0
if [[ -n "$pin" ]]; then
  # A PINNED PROFILE SKIPS THE RANKING ENTIRELY, and it is still checked for a
  # credential: reporting a name nobody can authenticate as would hand the caller
  # a config dir that Claude Code answers by writing a fresh independent login —
  # manufacturing the very independent holder the account-dir design forbids.
  if [[ ! -e "$HOME/.clauth/profiles/$pin/credentials.json" \
     && ! -L "$HOME/.clauth/profiles/$pin/credentials.json" ]]; then
    print -u2 -- "$PROG: no clauth profile '$pin' with a credential — 'clauth login $pin'"
    exit 5
  fi
  REPLY="$pin"
  _claude_pick_state=picked
  _claude_pick_class=pinned
  _claude_pick_reason="pinned with --profile"
  # The numbers are still reported, because a caller that pinned an account still
  # wants to know it is about to start on a spent window.
  typeset _CPM_U5 _CPM_R5 _CPM_UW _CPM_RW _CPM_AGE _CPM_TIER _CPM_R5_AT _CPM_RW_AT
  _claude_profile_metrics "$pin" >/dev/null 2>&1
  _claude_pick_u5="$_CPM_U5"; _claude_pick_uw="$_CPM_UW"; _claude_pick_r5="$_CPM_R5"
  _claude_pick_rw="$_CPM_RW"; _claude_pick_age="$_CPM_AGE"; _claude_pick_tier="$_CPM_TIER"
  # The pin builds its own explain row below and never goes through
  # _claude_pick_publish, so it must set these itself. Missed, --json --profile
  # reports a null reset for an account whose reset is perfectly well known.
  _claude_pick_r5_at="$_CPM_R5_AT"; _claude_pick_rw_at="$_CPM_RW_AT"
  _claude_pick_holders="$(_claude_holder_count "$pin")"
  _claude_pick_explain=( "$pin"$'\t'pinned$'\t'""$'\t'"$_CPM_U5"$'\t'"$_CPM_UW"$'\t'"$_CPM_AGE"$'\t'"$_claude_pick_holders"$'\t'""$'\t'"$_CPM_R5"$'\t'"$_CPM_R5_AT" )
  # A PIN NEVER REFUSES ON THE ACCOUNT, but it does say when the account it was
  # handed is spent or quarantined: the caller asked for this seat, and "it
  # started and died twenty minutes in" is the outcome this line prevents. One
  # stderr line and never an exit code — overriding the ranking is exactly what
  # --profile is for.
  pin_class="$(_claude_pick_class "$pin")"
  if [[ "${pin_class%%:*}" == exhausted || "${pin_class%%:*}" == excluded ]]; then
    print -u2 -- "$PROG: '$pin' is ${pin_class%%:*} (${pin_class#*:}) — pinned anyway, as asked"
    _claude_pick_warnings+=("'$pin' is ${pin_class%%:*}: ${pin_class#*:}")
  fi
  # The machine is still measured and still reported — a pin says which account,
  # not that the box has room.
  _claude_pick_backpressure || {
    if (( strict && ! force )); then
      # REPLY is cleared, so `profile` is null on EVERY refusal rather than only
      # on the ones _claude_pick_for_dir handles. A JSON object that names an
      # account beside a non-zero exit is one a caller can act on by mistake, and
      # this path sets REPLY before the machine has been measured at all.
      REPLY=""
      _claude_pick_state=backpressure
      _claude_pick_reason="${_claude_pick_warnings[-1]:-a machine ceiling was exceeded}"
      rc=3
    fi
  }
else
  _claude_pick_for_dir "$dir" "$tenant" "$strict" "$force"
  rc=$?
fi

#-----------------------------------------------------------------------------
# --gate: projected end-utilisation of the picked seat (design §4.2)
#
# projected = u5 + rate(model, effort) × est_minutes / 60, integer points of the
# 5-hour window. rate comes from CLAUDE_PICK_RATES["<model>:<effort>"] in
# ~/.config/claude-tenants.zsh when defined, else CLAUDE_PICK_RATE_DEFAULT (115:
# the worst rate measured on 2026-09-16, the WS1 fix lane, 19 points in 10 min).
# Refuses at projected > CLAUDE_PICK_GATE_MAX (95). An UNMEASURED window refuses
# too: "unknown" must never read as room — and a reading older than
# CLAUDE_PICK_CACHE_MAX_AGE (600 s) IS unmeasured, because the number in the
# file describes a window that has had time to fill since (F13). Every refusal
# is exit 2 with a state a caller can switch on; a pinned seat still refuses
# here, because the gate is the one thing --profile does not override.
#
# It runs BEFORE the account dir is built: the builder reconciles the profile's
# credential store as a side effect, and a seat the gate is about to refuse
# should leave nothing behind but the answer.

if (( gate && rc == 0 )) && [[ -n "$REPLY" ]]; then
  typeset -gA CLAUDE_PICK_RATES
  gate_max="${CLAUDE_PICK_GATE_MAX:-95}"
  gate_max_age="${CLAUDE_PICK_CACHE_MAX_AGE:-600}"
  gate_rate_src="CLAUDE_PICK_RATE_DEFAULT"; gate_rate="${CLAUDE_PICK_RATE_DEFAULT:-115}"
  if (( ${+CLAUDE_PICK_RATES[${gate_model}:${gate_effort}]} )); then
    gate_rate_src="CLAUDE_PICK_RATES[${gate_model}:${gate_effort}]"
    gate_rate="${CLAUDE_PICK_RATES[${gate_model}:${gate_effort}]}"
  fi
  # VALIDATE BEFORE ANY ARITHMETIC, and never fall back. zsh reads a non-numeric
  # word in (( )) as 0 or as an error, and both read as "allow" downstream: a
  # rate of 0 projects no growth, a negative one subtracts, and a failed
  # comparison is a false condition. The value that failed is named in the
  # reason and blanked in the JSON, so nothing reports a number that was never
  # one. The invalid value is not quoted back inside the JSON as a number, but
  # it IS in the reason — it is an operator's own setting, not a credential.
  gate_fault=""
  if [[ "$gate_max" != <-> ]] || (( gate_max == 0 )); then
    gate_fault="CLAUDE_PICK_GATE_MAX must be a positive integer (points of the 5h window), got '$gate_max'"; gate_max=""
  elif [[ "$gate_max_age" != <-> ]]; then
    gate_fault="CLAUDE_PICK_CACHE_MAX_AGE must be a non-negative integer (seconds), got '$gate_max_age'"; gate_max_age=""
  elif [[ "$gate_rate" != <-> ]] || (( gate_rate == 0 )); then
    gate_fault="$gate_rate_src must be a positive integer (points of the 5h window per lane-hour), got '$gate_rate'"; gate_rate=""
  fi
  if [[ -n "$gate_fault" ]]; then
    gate_verdict=refuse; _claude_pick_state=gate-misconfigured
    _claude_pick_reason="$gate_fault; refusing rather than guessing a threshold"
    REPLY=""; rc=2
  elif [[ "$_claude_pick_u5" != <-> ]]; then
    gate_verdict=refuse; _claude_pick_state=gate-unmeasured
    _claude_pick_reason="$REPLY has no measured 5h window; refusing rather than guessing"
    REPLY=""; rc=2
  elif [[ "$_claude_pick_age" != <-> ]]; then
    # A number with no readable age is a number of unknown age. The ranker calls
    # this `unknown` too; the gate must not be the one place it reads as fresh.
    gate_verdict=refuse; _claude_pick_state=gate-unmeasured
    _claude_pick_reason="$REPLY has a 5h reading whose age cannot be read; refusing rather than assuming it is current"
    REPLY=""; rc=2
  elif (( _claude_pick_age > gate_max_age )); then
    gate_verdict=refuse; _claude_pick_state=gate-unmeasured
    _claude_pick_reason="$REPLY's 5h reading (${_claude_pick_u5}%) is ${_claude_pick_age}s old, past CLAUDE_PICK_CACHE_MAX_AGE=${gate_max_age}s; a stale reading is an unmeasured one"
    REPLY=""; rc=2
  elif [[ "$_claude_pick_r5" != (-|)<-> ]]; then
    # No reset instant — absent (an unstarted window, the way clauth writes
    # one) or unparseable. The mtime cannot date the WINDOW, only the file, so a
    # reading with no reset is a reading of unknown currency: unmeasured, never
    # optimistic. See A ROLLED WINDOW IS AN UNMEASURED ONE TOO, above.
    gate_verdict=refuse; _claude_pick_state=gate-unmeasured
    _claude_pick_reason="$REPLY has a 5h reading (${_claude_pick_u5}%) with no readable reset instant (five_hour.resets_at absent or unparseable); refusing rather than assuming the window is current"
    REPLY=""; rc=2
  elif (( _claude_pick_r5 < 0 )); then
    # The window the number describes has ended. The file may be brand new — a
    # `touch`, or a writer that kept a rolled reading — and the mtime test above
    # passed it; the reset is the value and "now" is the threshold.
    gate_verdict=refuse; _claude_pick_state=gate-unmeasured
    _claude_pick_reason="$REPLY's 5h reading (${_claude_pick_u5}%) is for a window that reset at $(text_instant "$_claude_pick_r5_at") ($(( - _claude_pick_r5 ))s ago; the threshold is now); a rolled window is an unmeasured one"
    REPLY=""; rc=2
  else
    gate_projected=$(( _claude_pick_u5 + (gate_rate * gate_minutes) / 60 ))
    if (( gate_projected > gate_max )); then
      gate_verdict=refuse; _claude_pick_state=gate-projected
      _claude_pick_reason="$REPLY projects to ${gate_projected}% of its 5h window (${_claude_pick_u5}% now + ${gate_rate} pts/h × ${gate_minutes} min) > ${gate_max}%"
      REPLY=""; rc=2
    else
      gate_verdict=allow
    fi
  fi
  # The plain (non-JSON) caller gets the reason on stderr, the way every other
  # exit-2 refusal names what it refused.
  (( rc == 2 )) && print -u2 -- "$PROG: refused ($_claude_pick_state) — $_claude_pick_reason"
fi

#-----------------------------------------------------------------------------
# the account dir

config_dir=""
if (( rc == 0 )) && [[ -n "$REPLY" ]] && (( ! dry )); then
  builder="$(_claude_account_builder)"
  if [[ -x "$builder" ]]; then
    config_dir="$(command "$builder" "$REPLY" 2>/dev/null)" || config_dir=""
  fi
  if [[ -z "$config_dir" ]]; then
    # NOT a refusal: the account was chosen correctly and only the dir could not
    # be built, so the caller can still act on the name (and `claude` itself
    # reports the same state and shares the global credential). Saying nothing
    # would be the failure — a null config_dir on a successful exit reads as
    # --dry-run.
    _claude_pick_warnings+=("could not build an account dir for '$REPLY' — config_dir is null on a successful pick")
  fi
fi

#-----------------------------------------------------------------------------
# --explain

if (( explain )); then
  {
    print -r -- "$PROG: dir ${dir/#$HOME/~}"
    print -r -- "  tenant: ${_claude_pick_tenant:-<none>}${_claude_pick_tenant_state:+ ($_claude_pick_tenant_state)}"
    print -r -- "  pool:   ${_claude_pick_pool_members:-<every registered profile>}"
    (( ${#_claude_pick_overflow_members} )) && \
      print -r -- "  overflow: ${_claude_pick_overflow_members}"
    printf '  %-14s %-12s %5s %5s %7s %5s %9s  %s\n' \
           PROFILE CLASS 5H 7D AGE HOLD SCORE WHY
    for e in "${_claude_pick_explain[@]}"; do
      f=( "${(@ps:\t:)e}" )
      printf '  %-14s %-12s %5s %5s %7s %5s %9s  %s\n' \
             "${f[1]}" "${f[2]}" "${f[4]}" "${f[5]}" "${f[6]}" "${f[7]}" "${f[8]:--}" "${f[3]}"
    done
    for e in "${_claude_pick_skipped[@]}"; do print -r -- "  skipped: $e"; done
    print -r -- "  machine: load $(text_load1) on ${_CML_NCPU} threads, swap $(text_pct "$_CML_SWAPPCT")"
    for e in "${_claude_pick_warnings[@]}"; do print -r -- "  warning: $e"; done
    if (( rc == 0 )); then
      print -r -- "  picked:  $REPLY ($_claude_pick_class${_claude_pick_score:+, score $_claude_pick_score})"
    else
      print -r -- "  refused: $_claude_pick_state — $_claude_pick_reason"
    fi
  } >&2
fi

#-----------------------------------------------------------------------------
# stdout

if (( as_json )); then
  # Everything the picker recorded, from the one set of globals it recorded it
  # in. `skipped` carries every candidate that was NOT chosen, structured — the
  # spec's {profile, why} plus the columns a caller would otherwise have to parse
  # back out of --explain. Built by jq from typed pieces, never by string
  # concatenation: a profile name or a reason is data, and a JSON document
  # assembled with printf is one apostrophe away from being invalid.
  skip_rows=()
  for e in "${_claude_pick_explain[@]}"; do
    [[ "${e%%$'\t'*}" == "$REPLY" ]] && continue
    skip_rows+=( "$e" )
  done
  jq -n \
    --arg    tenant       "$_claude_pick_tenant" \
    --arg    tenant_state "$_claude_pick_tenant_state" \
    --arg    profile      "$REPLY" \
    --arg    tier         "$_claude_pick_tier" \
    --arg    config_dir   "$config_dir" \
    --arg    class        "$_claude_pick_class" \
    --arg    state        "$_claude_pick_state" \
    --arg    reason       "$_claude_pick_reason" \
    --argjson score       "$(json_num "$_claude_pick_score")" \
    --argjson overflow    "$(( _claude_pick_overflow ? 1 : 0 ))" \
    --argjson five_hour   "$(json_num "$_claude_pick_u5")" \
    --argjson weekly      "$(json_num "$_claude_pick_uw")" \
    --argjson cache_age   "$(json_num "$_claude_pick_age")" \
    --argjson r5          "$(json_instant "$_claude_pick_r5_at")" \
    --argjson rw          "$(json_instant "$_claude_pick_rw_at")" \
    --argjson load1       "$(json_load1)" \
    --argjson ncpu        "$(json_num "$_CML_NCPU")" \
    --argjson swap        "$(json_num "$_CML_SWAPPCT")" \
    --argjson warnings    "$(json_strings "${_claude_pick_warnings[@]}")" \
    --argjson notes       "$(json_strings "${_claude_pick_skipped[@]}")" \
    --argjson skipped     "$(json_strings "${skip_rows[@]}")" \
    --argjson exit_code   "$rc" \
    --arg    gate_model   "$gate_model" \
    --arg    gate_effort  "$gate_effort" \
    --argjson gate_on     "$gate" \
    --argjson gate_min    "$(json_num "$gate_minutes")" \
    --argjson gate_rate   "$(json_num "$gate_rate")" \
    --argjson gate_proj   "$(json_num "$gate_projected")" \
    --argjson gate_max    "$(json_num "$gate_max")" \
    --argjson gate_max_age "$(json_num "$gate_max_age")" \
    --arg    gate_verdict "$gate_verdict" \
    '{
       tenant:       (if $tenant       == "" then null else $tenant       end),
       tenant_state: (if $tenant_state == "" then null else $tenant_state end),
       profile:      (if $profile      == "" then null else $profile      end),
       tier:         (if $tier == "" or $tier == "unknown" then null else $tier end),
       config_dir:   (if $config_dir   == "" then null else $config_dir   end),
       score:        $score,
       class:        (if $class == "" then null else $class end),
       state:        $state,
       reason:       (if $reason == "" then null else $reason end),
       exit_code:    $exit_code,
       overflow:     ($overflow == 1),
       usage:        { five_hour: $five_hour, weekly: $weekly, cache_age_s: $cache_age },
       resets_at:    { five_hour: $r5, weekly: $rw },
       machine:      { load1: $load1, ncpu: $ncpu, swap_used_pct: $swap },
       gate:         (if $gate_on == 1 then {model: $gate_model, effort: $gate_effort, est_minutes: $gate_min, rate: $gate_rate,
                                             projected: $gate_proj, max: $gate_max,
                                             cache_age_s: $cache_age, cache_max_age_s: $gate_max_age,
                                             resets_at: $r5,
                                             verdict: (if $gate_verdict == "" then null else $gate_verdict end)}
                      else null end),
       warnings:     $warnings,
       notes:        $notes,
       skipped:      ($skipped | map(split("\t") | {
                        profile:   .[0],
                        class:     .[1],
                        why:       (if .[2] == "" then null else .[2] end),
                        five_hour: (.[3] | if test("^-?[0-9]+$") then tonumber else null end),
                        weekly:    (.[4] | if test("^-?[0-9]+$") then tonumber else null end),
                        holders:   (.[6] | if test("^-?[0-9]+$") then tonumber else null end),
                        score:     (.[7] | if test("^-?[0-9]+$") then tonumber else null end)
                      }))
     }'
elif (( rc == 0 )); then
  print -r -- "$REPLY"
fi

exit $rc
