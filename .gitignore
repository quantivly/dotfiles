# Ignore sensitive files
**/hosts.yml
**/*token*
**/*secret*
# ...but not the tooling whose JOB is secrets. `**/*secret*` above matched all
# three of these by name, and `git add -A` skips ignored paths SILENTLY — the
# commit, the push and the PR all succeeded with the files absent, and only CI
# noticed. Negations must come after the rule they undo.
!scripts/redact-secrets.sh
!scripts/test-secret-guard.sh
!claude/hooks/secret-emission-guard.sh
!rabota/**/*secret*.py
!scripts/scrub-transcript-secrets.py
!scripts/test-scrub-transcript-secrets.sh
!systemd/scrub-transcript-secrets.service
!systemd/scrub-transcript-secrets.timer
# `**/*token*` did the same to the migration-safety check (DO-622), whose
# "tokens" are ticket ids and dates, not credentials. Caught by `git add
# --dry-run` before the first commit this time, not by CI.
!scripts/check-doc-tokens.sh
!scripts/test-doc-tokens.sh
**/*password*

# OS files
.DS_Store
Thumbs.db

# Local overrides (contains secrets!)
*.local
.zshrc.local
.env
.env.local

# Mise version manager
.mise.local.toml
.mise.*.local.toml

# Poetry auth tokens (contains PyPI credentials)
config/pypoetry/auth.toml

# Python bytecode. scripts/gha-yaml-shell.py is imported by the DO-608 workflow
# guard, so running the guard or its state table leaves a __pycache__ beside it;
# one such .pyc was committed and reached main in #134 before this rule existed.
__pycache__/
*.pyc
